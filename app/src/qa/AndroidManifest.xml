<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- QA build only: loads a Gemma build and records exact memory use, see MemProbeActivity. -->
        <activity android:name=".debug.MemProbeActivity" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- QA build only: loads EmbeddingGemma on one backend and embeds a few texts, see EmbedProbeActivity. -->
        <activity android:name=".debug.EmbedProbeActivity" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- QA build only: issue #48 output-proof lab, see ProofLabActivity. -->
        <activity android:name=".debug.ProofLabActivity" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- QA build only: loads the embedder or Canary on one chosen backend and compares it with the CPU, see BackendProbeActivity. -->
        <activity android:name=".debug.BackendProbeActivity" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- QA build only (AD-16): the control API for adb, see QaApiProvider and docs/QA_API.md. DUMP is held by the shell, not by apps; the provider also checks the caller's uid. -->
        <provider android:name=".qaapi.QaApiProvider" android:authorities="${applicationId}.qaapi" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
