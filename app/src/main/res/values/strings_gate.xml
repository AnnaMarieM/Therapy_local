    <string name="gate_page1_title">A quiet memory\nfor your sessions.</string>
    <string name="gate_page1_body">It listens while you work, remembers what matters, and hands it back when it is useful. Nothing else.</string>
    <string name="gate_page2_kicker">Private</string>
    <string name="gate_page2_title">Everything stays\non this phone.</string>
    <string name="gate_page2_body">Recordings, transcripts and what %1$s learns are encrypted with a password only you know. Nothing is sent anywhere.</string>
    <string name="gate_page3_kicker">After a session</string>
    <string name="gate_page3_title">It listens,\nthen remembers.</string>
    <string name="gate_page3_body">When a session ends, the phone writes it down and notes the important things, in the background. You are told when it is done.</string>
    <string name="gate_page4_kicker">During a session</string>
    <string name="gate_page4_title">Earlier sessions,\nwhen they matter.</string>
    <string name="gate_page4_body">While you talk, things the client said before come up quietly on the screen. Glance, or ignore them.</string>

    <string name="gate_perm_kicker">Two permissions</string>
    <string name="gate_perm_title">What it needs,\nand why.</string>
    <string name="gate_perm_mic">Microphone</string>
    <string name="gate_perm_mic_why">To record sessions and to search by voice. Audio never leaves the phone.</string>
    <string name="gate_perm_notif">Notifications</string>
    <string name="gate_perm_notif_why">To tell you when a session has been processed, and to show that a recording is running.</string>
    <string name="gate_allowed">Allowed</string>
    <string name="gate_allow">Allow</string>

    <string name="gate_pw_kicker">Your password</string>
    <string name="gate_pw_title">Only you\ncan open it.</string>
    <string name="gate_pw_body">It encrypts everything on this phone. It cannot be recovered if you forget it, so choose one you will remember.</string>
