{
 "engine": "turbo-novad",
 "base": "whisper-large-v3-turbo",
 "opts": {
  "vad": false
 },
 "client": "jana-n",
 "lang": "cs",
 "lane": 1,
 "audio_s": 384.5,
 "seconds": 128.6,
 "rtf": 0.334,
 "wer": 0.1293,
 "cer": 0.0561,
 "segments": [
  {
   "start": 0.86,
   "end": 2.28,
   "text": "Dobrý den, paní Nováková Petra."
  },
  {
   "start": 2.72,
   "end": 4.8,
   "text": "S čím byste dnes chtěla začít?"
  },
  {
   "start": 5.62,
   "end": 6.84,
   "text": "Dobrý den, já ani nevím."
  },
  {
   "start": 7.08,
   "end": 8.5,
   "text": "Mám pocit, že mi někdo vytáhl"
  },
  {
   "start": 8.5,
   "end": 10.16,
   "text": "koberec pod nohou."
  },
  {
   "start": 10.5,
   "end": 10.96,
   "text": "Co se stalo?"
  },
  {
   "start": 11.66,
   "end": 14.24,
   "text": "Po patnácti letech manželství jsme se s manželem"
  },
  {
   "start": 14.24,
   "end": 16.66,
   "text": "Radkem rozhodli pro rozvod."
  },
  {
   "start": 16.8,
   "end": 18.46,
   "text": "A já to pořád nemohu pochopit."
  },
  {
   "start": 19.0,
   "end": 19.72,
   "text": "Řekněte mi víc."
  },
  {
   "start": 20.3,
   "end": 22.44,
   "text": "Ještě v letě jsme byli na dovolené v Horvatsku."
  },
  {
   "start": 22.56,
   "end": 23.96,
   "text": "Všechno vypadalo normálně."
  },
  {
   "start": 24.16,
   "end": 26.58,
   "text": "A v září mi řekl, že už to takhle dál nejde."
  },
  {
   "start": 27.62,
   "end": 28.42,
   "text": "A jak jste to přijal?"
  },
  {
   "start": 28.86,
   "end": 31.0,
   "text": "Síděla jsem v kuchni a nemohla jsem nic říct."
  },
  {
   "start": 31.12,
   "end": 32.52,
   "text": "Pak jsem šla uklidit nádobí,"
  },
  {
   "start": 32.6,
   "end": 33.64,
   "text": "jako by se nic nedělo."
  },
  {
   "start": 34.14,
   "end": 35.62,
   "text": "A co se dalo uvět vás?"
  },
  {
   "start": 36.72,
   "end": 38.28,
   "text": "Prázdno, pak zlost,"
  },
  {
   "start": 38.4,
   "end": 39.48,
   "text": "pak zase prázdno."
  },
  {
   "start": 39.78,
   "end": 41.4,
   "text": "Střída se to několikrát denně."
  },
  {
   "start": 42.1,
   "end": 43.32,
   "text": "Vysvětlil vám Radek, proč?"
  },
  {
   "start": 44.18,
   "end": 45.7,
   "text": "Říká, že jsme se vzdáleli,"
  },
  {
   "start": 45.86,
   "end": 47.18,
   "text": "že žijeme vedle sebe."
  },
  {
   "start": 47.42,
   "end": 50.52,
   "text": "Já si toho nevšimla, nebo jsem si všimnout nechtěla."
  },
  {
   "start": 51.64,
   "end": 52.98,
   "text": "Co si o tom myslíte teď?"
  },
  {
   "start": 54.08,
   "end": 55.96,
   "text": "Že jsem to měla vidět,"
  },
  {
   "start": 55.96,
   "end": 56.9,
   "text": "že jsem slepá."
  },
  {
   "start": 56.9,
   "end": 59.08,
   "text": "pořád se v hlavě vracím a hledám,"
  },
  {
   "start": 59.18,
   "end": 60.28,
   "text": "kde jsem udělala chybu."
  },
  {
   "start": 60.78,
   "end": 61.4,
   "text": "A našla s tým?"
  },
  {
   "start": 61.74,
   "end": 64.54,
   "text": "Ne. Jednou si myslím, že jsem byla moc unavená,"
  },
  {
   "start": 64.64,
   "end": 65.94,
   "text": "nezajímala jsem se o něj."
  },
  {
   "start": 66.04,
   "end": 68.9,
   "text": "Jen když jsem se starala moc."
  },
  {
   "start": 70.02,
   "end": 72.5,
   "text": "Vypadá to, že se v tom hodině trápíte."
  },
  {
   "start": 72.92,
   "end": 74.82,
   "text": "Ano, hlavně kvůli dětem."
  },
  {
   "start": 75.24,
   "end": 76.02,
   "text": "Vy jdeme o nich."
  },
  {
   "start": 76.78,
   "end": 78.54,
   "text": "Mám dvě děti, Aničce 12"
  },
  {
   "start": 78.54,
   "end": 81.54,
   "text": "a Matějovi 8 let a nevím, jak jim to říct."
  },
  {
   "start": 81.68,
   "end": 82.54,
   "text": "Ještě jste jim to neřekl?"
  },
  {
   "start": 82.7,
   "end": 85.44,
   "text": "Ne. Radek chce, abychom to řekli společně,"
  },
  {
   "start": 85.44,
   "end": 86.94,
   "text": "ale pořád to odkládáme."
  },
  {
   "start": 87.6,
   "end": 89.0,
   "text": "Anička už něco tuší."
  },
  {
   "start": 89.22,
   "end": 89.88,
   "text": "Co vám to říká?"
  },
  {
   "start": 90.9,
   "end": 93.9,
   "text": "Minulý týden jsem mě zeptala, jestli se s tátou hádáme."
  },
  {
   "start": 94.04,
   "end": 95.04,
   "text": "Řekla jsem, že ne."
  },
  {
   "start": 95.76,
   "end": 97.28,
   "text": "Cítila jsem se hrozně."
  },
  {
   "start": 100.32,
   "end": 101.42,
   "text": "Proč hrozně?"
  },
  {
   "start": 102.62,
   "end": 104.06,
   "text": "Protože jsem lhala."
  },
  {
   "start": 104.14,
   "end": 105.18,
   "text": "A ona to poznala."
  },
  {
   "start": 105.32,
   "end": 106.78,
   "text": "Viděla jsem jí to na očích."
  },
  {
   "start": 106.78,
   "end": 108.12,
   "text": "Co se vám mojilo hlavou?"
  },
  {
   "start": 108.62,
   "end": 110.78,
   "text": "Že ji ničím život. Že ji vezmou domov."
  },
  {
   "start": 111.86,
   "end": 113.8,
   "text": "Jak by se vám dařilo, že ji cítí pravdu?"
  },
  {
   "start": 114.64,
   "end": 117.8,
   "text": "Nejraději bych to měla za sebou, ale bojím se jejich slz."
  },
  {
   "start": 118.0,
   "end": 120.52,
   "text": "A Matě je ještě malý, ten moc nic nechápe."
  },
  {
   "start": 120.96,
   "end": 122.02,
   "text": "Co byste mu chtěla předat?"
  },
  {
   "start": 122.68,
   "end": 125.44,
   "text": "Že ho máme oba rádi a že se to nezmíní."
  },
  {
   "start": 125.64,
   "end": 128.4,
   "text": "Jenže já vím, nevím jestli je to pravda."
  },
  {
   "start": 128.92,
   "end": 130.8,
   "text": "Když sama nevím, jak to bude vypadat."
  },
  {
   "start": 131.56,
   "end": 132.64,
   "text": "Jak to bude vypadat s bydlením?"
  },
  {
   "start": 133.22,
   "end": 137.66,
   "text": "Byd je na hypotéku. Radek se asi odstěhuje k bratrovi, alespoň zatím."
  },
  {
   "start": 138.14,
   "end": 139.34,
   "text": "Díky zůstanou se mnou."
  },
  {
   "start": 139.88,
   "end": 140.7,
   "text": "Jak se vám z toho děla?"
  },
  {
   "start": 140.7,
   "end": 142.9,
   "text": "Mám strach, že to sama nezvládnu."
  },
  {
   "start": 143.34,
   "end": 144.92,
   "text": "Radek by vždycky řešil peníze."
  },
  {
   "start": 145.4,
   "end": 146.48,
   "text": "Co dálce ve všichni dnech?"
  },
  {
   "start": 147.04,
   "end": 150.12,
   "text": "Pracuji jako učitelka češtiny na základní škole v Brně."
  },
  {
   "start": 150.3,
   "end": 152.22,
   "text": "Učím devítky a osmičky."
  },
  {
   "start": 152.98,
   "end": 154.16,
   "text": "Jak se vám teď učí?"
  },
  {
   "start": 155.06,
   "end": 157.26,
   "text": "Do třídy chodím s krhlíkem v krku."
  },
  {
   "start": 157.42,
   "end": 160.42,
   "text": "Mám pocit, že všichni vidí, že se mi rozpadá život."
  },
  {
   "start": 162.52,
   "end": 164.38,
   "text": "Ví o tom někdo ve škole?"
  },
  {
   "start": 165.18,
   "end": 169.9,
   "text": "Jen ředitelka. Řekla jsem jí to, protože jsem se jednou rozplakala na chodbě."
  },
  {
   "start": 170.0,
   "end": 170.72,
   "text": "Byla hodna."
  },
  {
   "start": 171.34,
   "end": 171.96,
   "text": "Co vám pomohlo?"
  },
  {
   "start": 172.9,
   "end": 179.4,
   "text": "Vše mě nechala odejít dřív, dala mi je hodinu volné, jenže pak jsem seděla doma a bylo to horší."
  },
  {
   "start": 179.9,
   "end": 181.36,
   "text": "Horší? Proč?"
  },
  {
   "start": 182.16,
   "end": 185.86,
   "text": "Protože jsem byla sama za hlavou, v práci jsem měla aspoň co dělat."
  },
  {
   "start": 187.06,
   "end": 187.92,
   "text": "Jak spíte?"
  },
  {
   "start": 188.84,
   "end": 193.38,
   "text": "Špatně. Každou noc se budím ve tři hodiny ráno a přemýšlím, co bude dál."
  },
  {
   "start": 194.0,
   "end": 195.62,
   "text": "Co se říkáte, když se probudíte?"
  },
  {
   "start": 195.62,
   "end": 199.84,
   "text": "Že nemám hypotéku, nemám manžela, nemám nic."
  },
  {
   "start": 200.02,
   "end": 203.64,
   "text": "Pak spočítám peníze, pak si představím, jak to řeknu dětem."
  },
  {
   "start": 204.34,
   "end": 205.4,
   "text": "Točí se to dokola."
  },
  {
   "start": 205.8,
   "end": 206.14,
   "text": "A pak?"
  },
  {
   "start": 207.24,
   "end": 210.02,
   "text": "Kolem páté usnu a v půl sedmé vztávám."
  },
  {
   "start": 210.36,
   "end": 212.02,
   "text": "Jsem unavená už ráno."
  },
  {
   "start": 212.76,
   "end": 213.9,
   "text": "Jíte? Hýbete se?"
  },
  {
   "start": 214.8,
   "end": 216.62,
   "text": "Jím málo. Zubla jsem čtyřikyla."
  },
  {
   "start": 217.46,
   "end": 219.6,
   "text": "Kamarádka mi říká, že vypadám hrozně."
  },
  {
   "start": 220.54,
   "end": 222.38,
   "text": "Máte kolem sebe někoho, s kým můžete mluvit?"
  },
  {
   "start": 222.96,
   "end": 224.72,
   "text": "Mám sestru Alanu v Olmouci."
  },
  {
   "start": 225.34,
   "end": 227.22,
   "text": "Zavolá mi skoro každý večer."
  },
  {
   "start": 227.34,
   "end": 229.0,
   "text": "A kamarádku Evu z práce."
  },
  {
   "start": 229.0,
   "end": 229.86,
   "text": "Co jim říkat?"
  },
  {
   "start": 230.72,
   "end": 231.96,
   "text": "Alence skoro všechno."
  },
  {
   "start": 232.12,
   "end": 234.1,
   "text": "Evěn to, že mám těžké období."
  },
  {
   "start": 234.6,
   "end": 236.24,
   "text": "Nechci, aby se o mě něco myslela."
  },
  {
   "start": 236.74,
   "end": 237.94,
   "text": "Co se obávat, že si myslí?"
  },
  {
   "start": 238.8,
   "end": 239.9,
   "text": "Že jsem se lhala."
  },
  {
   "start": 240.12,
   "end": 242.34,
   "text": "Že žena, která nedokážu udržet manželství,"
  },
  {
   "start": 242.38,
   "end": 243.92,
   "text": "není pro děti dobrý příklad."
  },
  {
   "start": 244.92,
   "end": 247.08,
   "text": "To je těžká myšlenka."
  },
  {
   "start": 247.92,
   "end": 248.5,
   "text": "Odkud se bere?"
  },
  {
   "start": 249.1,
   "end": 250.2,
   "text": "Asi od mojí mámy."
  },
  {
   "start": 250.2,
   "end": 253.94,
   "text": "tak vždycky říkala, že manželství se drží, ať je to jak chce."
  },
  {
   "start": 255.08,
   "end": 257.06,
   "text": "Co řekla, když jste jí to oznámila?"
  },
  {
   "start": 257.5,
   "end": 258.02,
   "text": "Mlčela."
  },
  {
   "start": 258.92,
   "end": 262.16,
   "text": "Pak řekla, že doufá, že jsem to dobře zvážela."
  },
  {
   "start": 262.78,
   "end": 264.5,
   "text": "Už se od té doby moc neozvala."
  },
  {
   "start": 265.94,
   "end": 266.54,
   "text": "Jak mám to je?"
  },
  {
   "start": 267.16,
   "end": 267.68,
   "text": "Smutno."
  },
  {
   "start": 268.5,
   "end": 270.54,
   "text": "Potřebovala bych, aby mě olběla."
  },
  {
   "start": 271.46,
   "end": 272.48,
   "text": "Co byste jí chtěla říct?"
  },
  {
   "start": 272.98,
   "end": 277.12,
   "text": "Že to bolí, že nechci být sama, jenže u nás se to nedělá."
  },
  {
   "start": 277.84,
   "end": 279.78,
   "text": "Co se dělá, když to říkáte na hlas?"
  },
  {
   "start": 280.2,
   "end": 282.82,
   "text": "Pláču, omlouvám se."
  },
  {
   "start": 284.16,
   "end": 285.32,
   "text": "Nyní za co."
  },
  {
   "start": 286.16,
   "end": 287.0,
   "text": "Vezměte si čas."
  },
  {
   "start": 288.68,
   "end": 289.3,
   "text": "Děkuji."
  },
  {
   "start": 289.56,
   "end": 291.48,
   "text": "Ještě jsem nikomu tohle neřekla."
  },
  {
   "start": 293.32,
   "end": 294.8,
   "text": "Co to s vámi dělá,"
  },
  {
   "start": 295.18,
   "end": 297.06,
   "text": "že jste to tady řekla?"
  },
  {
   "start": 299.5,
   "end": 300.68,
   "text": "Je zvláštní"
  },
  {
   "start": 300.68,
   "end": 302.82,
   "text": "sedět tady a říkat to všechno"
  },
  {
   "start": 302.82,
   "end": 304.68,
   "text": "na hlas, ale trochu to pomáhá."
  },
  {
   "start": 306.18,
   "end": 306.72,
   "text": "Co by vám teď"
  },
  {
   "start": 306.72,
   "end": 307.68,
   "text": "mohlo pomoct nejvíc?"
  },
  {
   "start": 309.12,
   "end": 309.72,
   "text": "Spát."
  },
  {
   "start": 309.72,
   "end": 311.66,
   "text": "a vy, děde, jak to říct s dětem."
  },
  {
   "start": 313.14,
   "end": 313.98,
   "text": "Vyjďme na to postupně."
  },
  {
   "start": 314.86,
   "end": 316.48,
   "text": "Co z pánek?"
  },
  {
   "start": 316.82,
   "end": 317.52,
   "text": "Zkoušela jste něco?"
  },
  {
   "start": 318.94,
   "end": 320.88,
   "text": "Hřvánkový čaj a to je všechno."
  },
  {
   "start": 321.0,
   "end": 322.54,
   "text": "Doktorka mi nebídla prášky,"
  },
  {
   "start": 322.76,
   "end": 323.8,
   "text": "ale nechci."
  },
  {
   "start": 324.02,
   "end": 324.48,
   "text": "Proč nechcete?"
  },
  {
   "start": 325.2,
   "end": 328.9,
   "text": "Bojím si, že bych se nemohla včas zbudit pro děti"
  },
  {
   "start": 328.9,
   "end": 330.38,
   "text": "a nechci být závislá."
  },
  {
   "start": 331.08,
   "end": 332.08,
   "text": "To rozumím."
  },
  {
   "start": 332.88,
   "end": 334.62,
   "text": "Zkusíte tohle noc něco malého"
  },
  {
   "start": 334.62,
   "end": 336.72,
   "text": "třeba se vedle postele nechat papíra"
  },
  {
   "start": 336.72,
   "end": 337.56,
   "text": "a napsat, co vás budí?"
  },
  {
   "start": 338.56,
   "end": 340.9,
   "text": "Mohla bych, alespoň to dostanu z hlavy."
  },
  {
   "start": 342.06,
   "end": 343.08,
   "text": "A kde tam?"
  },
  {
   "start": 344.14,
   "end": 345.02,
   "text": "Čeho se nejvíc bojíte?"
  },
  {
   "start": 345.72,
   "end": 350.22,
   "text": "Že s panikařím rozpláču se, že nezvládnu zůstat klidná."
  },
  {
   "start": 350.92,
   "end": 351.7,
   "text": "Tak kdo by to nevadilo?"
  },
  {
   "start": 352.24,
   "end": 353.76,
   "text": "Že bych plakala před dětmi?"
  },
  {
   "start": 354.62,
   "end": 356.76,
   "text": "Vždyť to by pro ně bylo děsivé."
  },
  {
   "start": 357.78,
   "end": 362.18,
   "text": "Nebo by mohly vidět, že jsme také dovolený?"
  },
  {
   "start": 362.84,
   "end": 364.8,
   "text": "To mě nenapadlo."
  },
  {
   "start": 364.8,
   "end": 366.98,
   "text": "a Ančka je ciplivá."
  },
  {
   "start": 367.08,
   "end": 368.22,
   "text": "Možná by jí to pomohlo."
  },
  {
   "start": 369.44,
   "end": 371.28,
   "text": "Můžeme se příště podívat,"
  },
  {
   "start": 371.46,
   "end": 372.66,
   "text": "jak to připravit."
  },
  {
   "start": 373.34,
   "end": 374.64,
   "text": "Co se odnesete z dneška?"
  },
  {
   "start": 375.56,
   "end": 376.52,
   "text": "Že nejsem sama"
  },
  {
   "start": 376.52,
   "end": 378.56,
   "text": "a že to nemusím zvládnout hned."
  },
  {
   "start": 378.92,
   "end": 379.44,
   "text": "Přesně to."
  },
  {
   "start": 380.46,
   "end": 381.56,
   "text": "Pro dnešek tady skončíme."
  },
  {
   "start": 382.12,
   "end": 384.12,
