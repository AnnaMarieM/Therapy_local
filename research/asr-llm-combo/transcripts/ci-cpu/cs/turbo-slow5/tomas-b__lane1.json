{
 "engine": "turbo-slow5",
 "base": "whisper-large-v3-turbo",
 "opts": {
  "ffmpeg_filter": "atempo=0.5"
 },
 "client": "tomas-b",
 "lang": "cs",
 "lane": 1,
 "audio_s": 823.0,
 "seconds": 289.6,
 "rtf": 0.352,
 "wer": 0.3773,
 "cer": 0.1924,
 "segments": [
  {
   "start": 3.7,
   "end": 10.7,
   "text": "Dobrý jen pane Bartle, pojďte dál. A jak se vám se zdaří?"
  },
  {
   "start": 10.7,
   "end": 19.7,
   "text": "Dobrý jen, docela jsem nervózný. Jestli mám být uprímný, nikdy jsem se chlka nebyl."
  },
  {
   "start": 19.7,
   "end": 27.7,
   "text": "To je naprosto v pořádku. Co vás tam přivádí?"
  },
  {
   "start": 27.7,
   "end": 36.7,
   "text": "Manželka říká, že už to takhle nejde. A vlastně taky ne."
  },
  {
   "start": 36.7,
   "end": 39.7,
   "text": "A co nejde?"
  },
  {
   "start": 39.7,
   "end": 47.7,
   "text": "Třickrát zasež her kontroluji, jestli jsem zamknu dveře a vypnu sporák."
  },
  {
   "start": 47.7,
   "end": 52.7,
   "text": "Trvá mi to hodinu, než odejdu z betu."
  },
  {
   "start": 52.7,
   "end": 56.7,
   "text": "Hodinu? Jak to vypadá?"
  },
  {
   "start": 56.7,
   "end": 64.7,
   "text": "Zamknu dveře, odejdu k vítalu, vrátím se a zatáhnu za kvíku."
  },
  {
   "start": 65.7,
   "end": 70.7,
   "text": "Pak kontroluje sporáh, každý kností vzláž."
  },
  {
   "start": 71.7,
   "end": 72.7,
   "text": "Pávdu se dveře."
  },
  {
   "start": 73.7,
   "end": 78.2,
   "text": "A když to uděláte, co se stane?"
  },
  {
   "start": 78.2,
   "end": 82.2,
   "text": "Chvíl se mi uboví."
  },
  {
   "start": 82.2,
   "end": 90.47,
   "text": "Zámi do hlavy přijde obraz, že jsem to neuděl pořádně."
  },
  {
   "start": 90.47,
   "end": 92.47,
   "text": "A..."
  },
  {
   "start": 92.47,
   "end": 96.87,
   "text": "Co je to za obraz?"
  },
  {
   "start": 96.87,
   "end": 102.87,
   "text": "Byť v plamenách. Vidím to jasně jako film."
  },
  {
   "start": 102.87,
   "end": 107.87,
   "text": "Jak času se vám to stává?"
  },
  {
   "start": 107.87,
   "end": 117.87,
   "text": "Každý den. Večer je to nejhorší, když jdeme ven nebo spát. Ráno taky."
  },
  {
   "start": 117.87,
   "end": 123.25,
   "text": "Nědlouho už to trvá."
  },
  {
   "start": 123.25,
   "end": 132.25,
   "text": "Začalo to před dvěmi lety, kdy hořovou sousedu se musel evakuovat."
  },
  {
   "start": 132.25,
   "end": 136.75,
   "text": "Předněte bylo to víc."
  },
  {
   "start": 136.75,
   "end": 138.75,
   "text": "V povatovnoci,"
  },
  {
   "start": 138.75,
   "end": 140.75,
   "text": "parbil mi alarm,"
  },
  {
   "start": 140.75,
   "end": 142.75,
   "text": "na chodbě byl kůř,"
  },
  {
   "start": 142.75,
   "end": 144.75,
   "text": "a byde jak řičil."
  },
  {
   "start": 144.75,
   "end": 150.03,
   "text": "Vyběležíme jen v pěženech."
  },
  {
   "start": 150.03,
   "end": 154.03,
   "text": "Jak vám tehdy bylo?"
  },
  {
   "start": 154.03,
   "end": 156.03,
   "text": "Že tohle je jako ne."
  },
  {
   "start": 156.03,
   "end": 159.6,
   "text": "Někdo nebyl zraně"
  },
  {
   "start": 159.6,
   "end": 161.6,
   "text": "na lesu,"
  },
  {
   "start": 161.6,
   "end": 163.6,
   "text": "sedmtově hřel celá."
  },
  {
   "start": 163.6,
   "end": 165.6,
   "text": "Stál jsem menku v země,"
  },
  {
   "start": 165.6,
   "end": 167.6,
   "text": "kůlka, jak hoří okna."
  },
  {
   "start": 167.6,
   "end": 186.96,
   "text": "V té dobu mám pocit, že to můžu způsobit a že jliš něco nezkontroluji, jak se to stane a buru jiné."
  },
  {
   "start": 187.96,
   "end": 189.96,
   "text": "To je velká zadba."
  },
  {
   "start": 193.23,
   "end": 201.23,
   "text": "Já vím, že to nedává smysl. Zdám to logiku. Prost se to nedá vypnout."
  },
  {
   "start": 204.57,
   "end": 207.57,
   "text": "Co děláte, když to nechcete dělat?"
  },
  {
   "start": 209.57,
   "end": 211.57,
   "text": "Zkusím to nechat."
  },
  {
   "start": 212.57,
   "end": 216.57,
   "text": "Pak mrochte úzkost, až mám pocit, že se zblázním."
  },
  {
   "start": 217.57,
   "end": 220.57,
   "text": "Vrrrr, raději to udělám."
  },
  {
   "start": 220.57,
   "end": 226.48,
   "text": "Úzkost pro evole?"
  },
  {
   "start": 226.48,
   "end": 232.48,
   "text": "Srdce po třesu země ruce a mám špatnil žaludku."
  },
  {
   "start": 232.48,
   "end": 236.21,
   "text": "Kdo o tom ví?"
  },
  {
   "start": 237.21,
   "end": 241.58,
   "text": "Barbara. Moje manželka."
  },
  {
   "start": 241.58,
   "end": 248.58,
   "text": "Na začátku to bralo jako zvyk, teď už vidí, že je to víc."
  },
  {
   "start": 248.58,
   "end": 251.58,
   "text": "Jak na to reaguje?"
  },
  {
   "start": 251.58,
   "end": 264.58,
   "text": "No, trpěl, ale vidím, že jí to dočerpával. Včera jsme přišli na kyná, ale o 40 minut později."
  },
  {
   "start": 264.58,
   "end": 267.58,
   "text": "Co se stalo?"
  },
  {
   "start": 267.58,
   "end": 272.78,
   "text": "Čekala venku, než se vrátím a zkontrojist poradu."
  },
  {
   "start": 272.78,
   "end": 274.08,
   "text": "To cítím."
  },
  {
   "start": 274.08,
   "end": 277.08,
   "text": "Řekla nic."
  },
  {
   "start": 277.08,
   "end": 280.08,
   "text": "Je, co na mě podívila."
  },
  {
   "start": 280.08,
   "end": 283.08,
   "text": "Jak vám bylo?"
  },
  {
   "start": 283.08,
   "end": 285.08,
   "text": "Ano."
  },
  {
   "start": 285.08,
   "end": 291.08,
   "text": "Cítil zemřek vidíte, který nezvládne vyjít z domu."
  },
  {
   "start": 291.08,
   "end": 295.33,
   "text": "Co dělat zepra?"
  },
  {
   "start": 295.33,
   "end": 298.33,
   "text": "Prací, jaká lidí řekáš vám moc."
  },
  {
   "start": 298.33,
   "end": 303.33,
   "text": "Mám rozvory v betech a občas v rodněných domách."
  },
  {
   "start": 303.33,
   "end": 308.33,
   "text": "Jak to se vysí zkontrolové?"
  },
  {
   "start": 308.33,
   "end": 312.6,
   "text": "Hodně."
  },
  {
   "start": 312.6,
   "end": 320.6,
   "text": "Bojím se, že kvůle své hlavé jdou nám v chybu, že v takém příkladném vodě čím, co zchoří."
  },
  {
   "start": 320.6,
   "end": 327.36,
   "text": "Stalo se vám něco takové?"
  },
  {
   "start": 327.36,
   "end": 328.36,
   "text": "Nikde."
  },
  {
   "start": 328.36,
   "end": 337.36,
   "text": "No pokud se taká se zavracím do kontrolu, jen když se tam vrátím druhý den a jen se podívat."
  },
  {
   "start": 337.36,
   "end": 340.86,
   "text": "A kolegové?"
  },
  {
   "start": 340.86,
   "end": 344.86,
   "text": "Myslí si, že jsem pět."
  },
  {
   "start": 344.86,
   "end": 353.86,
   "text": "Čef mi říká, že jsem nejpečtovější ve firmě, ale nevědí, kolik času to stojí."
  },
  {
   "start": 353.86,
   "end": 357.86,
   "text": "Kolik času to stojí?"
  },
  {
   "start": 357.86,
   "end": 362.86,
   "text": "V poslední přizismýdla práce o hodinu výzdeně."
  },
  {
   "start": 362.86,
   "end": 368.86,
   "text": "Už jsem pár zakázek přidal kolegové, protože jsem to nestihal."
  },
  {
   "start": 368.86,
   "end": 373.3,
   "text": "Co to s vámi dělá?"
  },
  {
   "start": 373.3,
   "end": 380.3,
   "text": "Mám strach, že přijde o práce. Hlavně teď."
  },
  {
   "start": 380.3,
   "end": 384.03,
   "text": "Proč rovna teď?"
  },
  {
   "start": 384.03,
   "end": 390.75,
   "text": "Proborat děl tam ve čtvrté měsíce."
  },
  {
   "start": 390.75,
   "end": 392.75,
   "text": "Gratuluj!"
  },
  {
   "start": 392.75,
   "end": 399.82,
   "text": "To už jsem vtasný, popravdu."
  },
  {
   "start": 399.82,
   "end": 406.82,
   "text": "Čekali jsme na to čeroké, ale potom přišla další myšlenka."
  },
  {
   "start": 406.82,
   "end": 408.82,
   "text": "Jaká?"
  },
  {
   "start": 408.82,
   "end": 414.82,
   "text": "Že jí a díce tě ublíží."
  },
  {
   "start": 414.82,
   "end": 417.82,
   "text": "Ublíží to jak?"
  },
  {
   "start": 417.82,
   "end": 425.82,
   "text": "Ne, že bych chtěl. To je hrozné, nikdy bych to neudlal."
  },
  {
   "start": 425.82,
   "end": 436.82,
   "text": "Ale ta myšlenka přijde, když krájím chleba, dostajím u schodu a pak se bojím, že to půjde samo."
  },
  {
   "start": 436.82,
   "end": 442.82,
   "text": "Takže je to myšlenka, která vás těchá?"
  },
  {
   "start": 442.82,
   "end": 456.75,
   "text": "Je to nejhorší, když jsem to nikomu neřekl, ani v pár boře."
  },
  {
   "start": 459.09,
   "end": 463.09,
   "text": "Děkuji, že jste mi to řekl, to je důležité."
  },
  {
   "start": 466.84,
   "end": 468.84,
   "text": "Myslím, že jsem nebezpečný?"
  },
  {
   "start": 471.35,
   "end": 482.35,
   "text": "Takové vtíravé myšlenky, jako u lidí s tímto typem potíží, jsou velmi časté."
  },
  {
   "start": 483.35,
   "end": 487.35,
   "text": "Hlavně, když se příží velká změna."
  },
  {
   "start": 488.35,
   "end": 491.35,
   "text": "Nejsou vůkazem, že byste jen co ujistili."
  },
  {
   "start": 493.69,
   "end": 498.69,
   "text": "Jejich síla je právě v tom, jak vás děsí."
  },
  {
   "start": 502.73,
   "end": 503.73,
   "text": "Váhá."
  },
  {
   "start": 504.73,
   "end": 509.73,
   "text": "Přesto chce čas, než tomu měří."
  },
  {
   "start": 510.73,
   "end": 511.73,
   "text": "Rozumím."
  },
  {
   "start": 514.81,
   "end": 518.81,
   "text": "Co děláte, když se ta myšlenka objeví?"
  },
  {
   "start": 521.06,
   "end": 524.56,
   "text": "A dejdu s mnóstvou."
  },
  {
   "start": 524.56,
   "end": 529.52,
   "text": "Nebo se vrátím a zkontrole něco, aby jde přesto."
  },
  {
   "start": 529.52,
   "end": 540.04,
   "text": "Takže kontrola vám pomáhá uplidnit i dole?"
  },
  {
   "start": 540.04,
   "end": 547.08,
   "text": "Vlastně ne, nebo nikdy mě nepadlo, že jen se spolu souvisí."
  },
  {
   "start": 547.08,
   "end": 551.53,
   "text": "Jak spí?"
  },
  {
   "start": 551.53,
   "end": 562.34,
   "text": "Spím, vstávám noci dvakrát a kontroluji smolát, i když tam je směst."
  },
  {
   "start": 562.34,
   "end": 572.54,
   "text": "Máme chyb na procházky s Barborou,"
  },
  {
   "start": 572.54,
   "end": 576.54,
   "text": "když je právě něco do mě zaměstná."
  },
  {
   "start": 578.04,
   "end": 581.04,
   "text": "Jak často to děláte?"
  },
  {
   "start": 581.84,
   "end": 589.04,
   "text": "Procházky dvakrát týdně, no právě, no když je to."
  },
  {
   "start": 589.04,
   "end": 597.58,
   "text": "To pro vás znamenalo, kdyby se to zlepšil."
  },
  {
   "start": 597.58,
   "end": 607.83,
   "text": "Udejíc bez za 5 minut a těšit se na dítě bez těch nečlenek."
  },
  {
   "start": 607.83,
   "end": 617.9,
   "text": "To jsou jasné, že existuje léčba, která tomu..."
  },
  {
   "start": 617.9,
   "end": 629.04,
   "text": "Zložil jsem terapii, když jsem šlo početně vystavuje tom, čemu se bojí."
  },
  {
   "start": 629.04,
   "end": 634.76,
   "text": "Měl jsem z toho strach."
  },
  {
   "start": 634.76,
   "end": 636.76,
   "text": "Strach je pochopitá."
  },
  {
   "start": 636.76,
   "end": 641.49,
   "text": "Šlo by se po malých krocích."
  },
  {
   "start": 641.49,
   "end": 645.47,
   "text": "Tempu rozhodoval."
  },
  {
   "start": 645.47,
   "end": 654.53,
   "text": "Je uklidňující."
  },
  {
   "start": 654.53,
   "end": 662.53,
   "text": "Myslel jsem, že mě někdo domů si nechal tuto vřené dveře odejít."
  },
  {
   "start": 662.53,
   "end": 673.46,
   "text": "Tak začali bychom třeba, že zkontrolujete dveře jenom jedno."
  },
  {
   "start": 673.46,
   "end": 682.06,
   "text": "To jsme je malé, ale to je pro mě velké."
  },
  {
   "start": 683.06,
   "end": 688.06,
   "text": "Velké kroky začínají malé."
  },
  {
   "start": 688.06,
   "end": 693.53,
   "text": "Řekl jste něco důležitého o Barbóři."
  },
  {
   "start": 693.53,
   "end": 701.84,
   "text": "Chtěl byste jí říct, co byste jí chtěl říct?"
  },
  {
   "start": 701.84,
   "end": 702.84,
   "text": "Že je můj."
  },
  {
   "start": 702.84,
   "end": 709.86,
   "text": "Že si pochci odvážit, abych ji nestratil."
  },
  {
   "start": 709.86,
   "end": 717.67,
   "text": "Zatím se bojím, že byste se mnou nechtěla být."
  },
  {
   "start": 722.17,
   "end": 724.61,
   "text": "Myslíte, že by řekl?"
  },
  {
   "start": 724.61,
   "end": 729.8,
   "text": "Sebe mě objela?"
  },
  {
   "start": 731.38,
   "end": 731.92,
   "text": "O ne."
  },
  {
   "start": 736.08,
   "end": 741.22,
   "text": "Možná jste jí za to jí říct alespoň čas."
  },
  {
   "start": 743.68,
   "end": 752.92,
   "text": "Co kdo byste jí řekl, že jste tu byl a co jste se dozvěděl?"
  },
  {
   "start": 752.92,
   "end": 754.92,
   "text": "Tak zvládním."
  },
  {
   "start": 754.92,
   "end": 758.71,
   "text": "V těch myšlenkách ještě."
  },
  {
   "start": 758.71,
   "end": 766.69,
   "text": "V pořádku."
  },
  {
   "start": 766.69,
   "end": 767.69,
   "text": "Děkuji."
  },
  {
   "start": 767.69,
   "end": 772.55,
   "text": "Vám dál na víc než jsem čekal."
  },
  {
   "start": 772.55,
   "end": 779.17,
   "text": "Do příště zkuste jednu věc."
  },
  {
   "start": 779.17,
   "end": 784.03,
   "text": "Že odcházíte z bytu."
  },
  {
   "start": 784.03,
   "end": 787.03,
   "text": "Zkontrolujte dveře jenom."
  },
  {
   "start": 787.03,
   "end": 793.3,
   "text": "Zapište si jak moc vám bylo."
  },
  {
   "start": 793.3,
   "end": 803.55,
   "text": "Zkuste aspoň jednou."
  },
  {
   "start": 803.55,
   "end": 808.83,
   "text": "a zapíšu číslo od jedna do deseti."
  },
  {
   "start": 808.83,
   "end": 814.83,
   "text": "Přesně tak. Pro dnešek te disko."
  },
  {
   "start": 814.83,
   "end": 820.88,
   "text": "Děkuji. Pojďme se příští týdaj."
  }
 ],
 "round": "r3a"
}