{
 "engine": "turbo-beam10",
 "base": "whisper-large-v3-turbo",
 "opts": {
  "beam_size": 10,
  "patience": 2.0
 },
 "client": "jana-n",
 "lang": "cs",
 "lane": 1,
 "audio_s": 384.5,
 "seconds": 113.5,
 "rtf": 0.295,
 "wer": 0.1282,
 "cer": 0.0528,
 "segments": [
  {
   "start": 0.78,
   "end": 2.38,
   "text": "Dobrý den, paní Nováková, pojďte dál."
  },
  {
   "start": 2.88,
   "end": 4.78,
   "text": "S čím byste dnes chtěla začít?"
  },
  {
   "start": 5.6,
   "end": 6.84,
   "text": "Dobrý den, já ani nevím."
  },
  {
   "start": 7.08,
   "end": 8.5,
   "text": "Mám pocit, že mi někdo vytáhl"
  },
  {
   "start": 8.5,
   "end": 10.16,
   "text": "koverec pod nohou."
  },
  {
   "start": 10.5,
   "end": 10.94,
   "text": "Co se stalo?"
  },
  {
   "start": 11.66,
   "end": 14.24,
   "text": "Po patnácti letech manželství jsme se s manželem"
  },
  {
   "start": 14.24,
   "end": 16.66,
   "text": "Radkem rozhodli pro rozvod."
  },
  {
   "start": 16.8,
   "end": 18.44,
   "text": "A já to pořád nemohu pochopit."
  },
  {
   "start": 18.96,
   "end": 19.72,
   "text": "Řekněte mi víc."
  },
  {
   "start": 20.28,
   "end": 22.42,
   "text": "Ještě v letě jsme byli na dovolené v Horvatsku"
  },
  {
   "start": 22.42,
   "end": 23.98,
   "text": "a všechno vypadalo normálně."
  },
  {
   "start": 23.98,
   "end": 26.62,
   "text": "A v září mi řekl, že už to takhle dál nejde."
  },
  {
   "start": 27.62,
   "end": 28.4,
   "text": "A jak jste to přijal?"
  },
  {
   "start": 28.86,
   "end": 30.98,
   "text": "Síděla jsem v kuchni a nemohla jsem nic říct."
  },
  {
   "start": 31.12,
   "end": 32.5,
   "text": "Pak jsem šla uklidit nádobí,"
  },
  {
   "start": 32.6,
   "end": 33.64,
   "text": "jako by se nic nedělo."
  },
  {
   "start": 34.14,
   "end": 35.62,
   "text": "A co se dalo u mě třeba vás?"
  },
  {
   "start": 36.74,
   "end": 39.48,
   "text": "Prázdno, pak zlost, pak zase prázdno."
  },
  {
   "start": 39.82,
   "end": 41.4,
   "text": "Střída se to několikrát dyně."
  },
  {
   "start": 42.1,
   "end": 43.32,
   "text": "Vysvětlil vám, Radek, proč?"
  },
  {
   "start": 44.18,
   "end": 45.66,
   "text": "Říká, že jsme se vzdárili,"
  },
  {
   "start": 45.88,
   "end": 47.18,
   "text": "že žijeme vedle sebe."
  },
  {
   "start": 47.4,
   "end": 48.48,
   "text": "Já si toho nevšimla,"
  },
  {
   "start": 48.58,
   "end": 50.52,
   "text": "nebo jsem si všimnout nechtěla?"
  },
  {
   "start": 51.64,
   "end": 52.98,
   "text": "Co si o tom myslíte teď?"
  },
  {
   "start": 54.08,
   "end": 55.96,
   "text": "Že jsem to měla vidět,"
  },
  {
   "start": 56.02,
   "end": 56.86,
   "text": "že jsem slepá."
  },
  {
   "start": 56.86,
   "end": 59.08,
   "text": "pořád se v hlavě vracím a hledám,"
  },
  {
   "start": 59.2,
   "end": 60.26,
   "text": "kde jsem udělala chybu."
  },
  {
   "start": 60.78,
   "end": 61.36,
   "text": "A našla jste jí?"
  },
  {
   "start": 61.74,
   "end": 64.54,
   "text": "Ne. Jednou si myslím, že jsem byla moc unavená,"
  },
  {
   "start": 64.64,
   "end": 66.7,
   "text": "nezajímala jsem se o něj, jindy zase,"
  },
  {
   "start": 67.34,
   "end": 68.9,
   "text": "že jsem se starala moc."
  },
  {
   "start": 70.04,
   "end": 72.5,
   "text": "Vypadá to, že se v tom hodině trápíte."
  },
  {
   "start": 72.92,
   "end": 74.82,
   "text": "Ano, hlavně kvůli dětem."
  },
  {
   "start": 75.24,
   "end": 76.02,
   "text": "Vy jdeme o nich."
  },
  {
   "start": 76.76,
   "end": 78.56,
   "text": "Mám dvě děti, Aničce 12"
  },
  {
   "start": 78.56,
   "end": 81.56,
   "text": "a Matějovi 8 let a nevím, jak jim to říct."
  },
  {
   "start": 81.68,
   "end": 82.56,
   "text": "Ještě jste jim to neřekla?"
  },
  {
   "start": 82.56,
   "end": 85.42,
   "text": "Ne. Radek chce, abychom to řekli společně,"
  },
  {
   "start": 85.42,
   "end": 86.94,
   "text": "ale pořád to odkládáme."
  },
  {
   "start": 87.6,
   "end": 89.0,
   "text": "Anička už něco tuší."
  },
  {
   "start": 89.22,
   "end": 89.88,
   "text": "Co vám to říká?"
  },
  {
   "start": 90.9,
   "end": 93.9,
   "text": "Minulý týden jsem mě zeptala, jestli se s tátou hádáme."
  },
  {
   "start": 94.04,
   "end": 95.02,
   "text": "Řekla jsem, že ne."
  },
  {
   "start": 95.78,
   "end": 97.26,
   "text": "Cítila jsem se hrozně."
  },
  {
   "start": 100.4,
   "end": 101.42,
   "text": "Proč hrozně?"
  },
  {
   "start": 102.62,
   "end": 104.06,
   "text": "Protože jsem lhala."
  },
  {
   "start": 104.16,
   "end": 105.18,
   "text": "A ona to poznala."
  },
  {
   "start": 105.32,
   "end": 106.78,
   "text": "Viděla jsem jí to na očích."
  },
  {
   "start": 107.12,
   "end": 108.08,
   "text": "Co se vám mojilo hlavou?"
  },
  {
   "start": 108.6,
   "end": 109.66,
   "text": "Že ji ničím život."
  },
  {
   "start": 109.76,
   "end": 110.76,
   "text": "Že ji vezmu domov."
  },
  {
   "start": 111.84,
   "end": 113.8,
   "text": "Jak by se vám dařilo, že ji cítí pravdu?"
  },
  {
   "start": 114.68,
   "end": 116.18,
   "text": "Nejraději bych to měla za sebou."
  },
  {
   "start": 116.18,
   "end": 120.56,
   "text": "ale bojím se jich slz a Matě je ještě malý, ten moc nic nechápe."
  },
  {
   "start": 120.98,
   "end": 122.02,
   "text": "Co byste mu chtěla přidat?"
  },
  {
   "start": 122.7,
   "end": 128.42,
   "text": "Že ho máme oba rádi a že se to nezmíní, jenže já vím, nevím jestli je to pravda,"
  },
  {
   "start": 128.98,
   "end": 130.82,
   "text": "když sama nevím, jak to bude vypadat."
  },
  {
   "start": 131.58,
   "end": 132.66,
   "text": "Jak to bude vypadat s bydlením?"
  },
  {
   "start": 133.26,
   "end": 137.66,
   "text": "Byd je na hypotéku, Radek se asi odstěhuje k bratrovi, alespoň zatím."
  },
  {
   "start": 138.16,
   "end": 139.34,
   "text": "Díky zůstanou se mnou."
  },
  {
   "start": 139.88,
   "end": 140.7,
   "text": "Jak se vám z toho děla?"
  },
  {
   "start": 140.94,
   "end": 144.9,
   "text": "Mám strach, že to sama nezvládnu. Radek vždycky řešil peníze."
  },
  {
   "start": 145.36,
   "end": 146.48,
   "text": "Co dálte ve všech dních dnech?"
  },
  {
   "start": 147.06,
   "end": 150.12,
   "text": "Pracuji jako učitelka češtiny na základní škole v Brně."
  },
  {
   "start": 150.3,
   "end": 152.22,
   "text": "Učím devítky a osmičky."
  },
  {
   "start": 152.98,
   "end": 154.16,
   "text": "Jak se vám teď učí?"
  },
  {
   "start": 155.04,
   "end": 157.26,
   "text": "Do třídy chodím s knelíkem v krku."
  },
  {
   "start": 157.42,
   "end": 160.42,
   "text": "Mám pocit, že všichni vidí, že se mi rozpadá život."
  },
  {
   "start": 162.54,
   "end": 164.38,
   "text": "Ví o tom někdo ve škole?"
  },
  {
   "start": 165.18,
   "end": 169.9,
   "text": "Jen ředitelka. Řekla jsem jí to, protože jsem se jednou rozplakala na chodbě."
  },
  {
   "start": 170.0,
   "end": 170.78,
   "text": "Byla hodná."
  },
  {
   "start": 171.36,
   "end": 171.98,
   "text": "Co vám pomohlo?"
  },
  {
   "start": 171.98,
   "end": 179.4,
   "text": "Že mě nechala odejít dřív, dala mi je hodinu volné, jenže pak jsem seděla doma a bylo to horší."
  },
  {
   "start": 179.9,
   "end": 181.36,
   "text": "Horší? Proč?"
  },
  {
   "start": 182.16,
   "end": 185.86,
   "text": "Protože jsem byla sama za hlavou, v práci jsem měla aspoň co dělat."
  },
  {
   "start": 187.06,
   "end": 187.92,
   "text": "Jak spíte?"
  },
  {
   "start": 188.84,
   "end": 193.38,
   "text": "Špatně. Každou noc se budím ve tři hodiny ráno a přemýšlím, co bude dál."
  },
  {
   "start": 194.0,
   "end": 195.62,
   "text": "Co se říkáte, když se probudíte?"
  },
  {
   "start": 196.3,
   "end": 201.32,
   "text": "Že nemám hypotéku, nemám manžela, nemám nic, pak spočítám peníze,"
  },
  {
   "start": 201.32,
   "end": 203.64,
   "text": "tak si představím, jak to řeknu dětem."
  },
  {
   "start": 204.34,
   "end": 205.4,
   "text": "Točí se to dokola."
  },
  {
   "start": 205.8,
   "end": 206.14,
   "text": "A pak?"
  },
  {
   "start": 207.24,
   "end": 209.32,
   "text": "Kolem páté usnu a v půl sedmé vztávám."
  },
  {
   "start": 210.36,
   "end": 212.04,
   "text": "Jsem unavená už ráno."
  },
  {
   "start": 212.78,
   "end": 213.9,
   "text": "Jíte? Hýbete se?"
  },
  {
   "start": 214.78,
   "end": 215.32,
   "text": "Jím málo."
  },
  {
   "start": 216.12,
   "end": 217.32,
   "text": "Zubla jsem čtyřikyla."
  },
  {
   "start": 217.46,
   "end": 219.62,
   "text": "Kamarádka mi říká, že vypadám hrozně."
  },
  {
   "start": 220.58,
   "end": 221.62,
   "text": "Máte kolem sebe někoho,"
  },
  {
   "start": 221.72,
   "end": 222.46,
   "text": "s kým můžete mluvit?"
  },
  {
   "start": 222.92,
   "end": 224.72,
   "text": "Mám sestru Alanu v Olomouci."
  },
  {
   "start": 225.28,
   "end": 227.22,
   "text": "Zavolá mi skoro každý večer"
  },
  {
   "start": 227.22,
   "end": 229.02,
   "text": "a kamarádku Evu z práce."
  },
  {
   "start": 229.02,
   "end": 229.92,
   "text": "Co jim říkáte?"
  },
  {
   "start": 230.72,
   "end": 234.1,
   "text": "Ale jste skoro všechno. Evien to, že mám těžké období."
  },
  {
   "start": 234.6,
   "end": 236.22,
   "text": "Nechci, aby se o mě něco myslela."
  },
  {
   "start": 236.74,
   "end": 237.92,
   "text": "Co se obávat, že si myslí?"
  },
  {
   "start": 238.8,
   "end": 243.9,
   "text": "Že jsem se lhala. Že žena, která nedokážu udržet manželství, není pro děti dobrý příklad."
  },
  {
   "start": 244.9,
   "end": 248.5,
   "text": "To je těžká myšlenka. Odkud se bere?"
  },
  {
   "start": 249.1,
   "end": 253.88,
   "text": "Asi od mojí mámy. Ta vždycky říkala, že manželství se drží a dě to jak chce."
  },
  {
   "start": 255.06,
   "end": 257.06,
   "text": "Co řekla, když jste jí to oznámila?"
  },
  {
   "start": 257.48,
   "end": 258.04,
   "text": "Mlčela."
  },
  {
   "start": 258.94,
   "end": 262.14,
   "text": "Pak řekla, že doufá, že jsem to dobře zvážela."
  },
  {
   "start": 262.76,
   "end": 264.5,
   "text": "Už se od té doby moc neozvala."
  },
  {
   "start": 265.94,
   "end": 266.54,
   "text": "Jak mám to je?"
  },
  {
   "start": 267.14,
   "end": 267.7,
   "text": "Smutno."
  },
  {
   "start": 268.5,
   "end": 270.54,
   "text": "Potřebovala bych, aby mě olběla."
  },
  {
   "start": 271.46,
   "end": 272.48,
   "text": "Co byste jich chtěla říct?"
  },
  {
   "start": 272.98,
   "end": 277.14,
   "text": "Že to bolí, že nechci být sama, jenže u nás se to nedělá."
  },
  {
   "start": 278.22,
   "end": 279.76,
   "text": "Co se dělá, když to říkáte na hlas?"
  },
  {
   "start": 280.74,
   "end": 282.78,
   "text": "Pláču a omlouvám se."
  },
  {
   "start": 284.18,
   "end": 285.32,
   "text": "Nyní za co."
  },
  {
   "start": 286.16,
   "end": 287.0,
   "text": "Vezměte se čas."
  },
  {
   "start": 287.06,
   "end": 291.58,
   "text": "Děkuji, ještě jsem nikomu tohle neřekla"
  },
  {
   "start": 291.58,
   "end": 297.1,
   "text": "Co s vámi dělá, že jste to tady řekla?"
  },
  {
   "start": 299.6,
   "end": 304.78,
   "text": "Je zvláštní sedět tady a říkat to všechno na hlas, ale trochu to pomáhá"
  },
  {
   "start": 304.78,
   "end": 307.7,
   "text": "Co by vám teď mohlo pomoct nejvíc?"
  },
  {
   "start": 309.06,
   "end": 311.68,
   "text": "Spát a vy, děděk, to říct s dětem"
  },
  {
   "start": 311.68,
   "end": 314.02,
   "text": "Přijďme na to postupně"
  },
  {
   "start": 314.02,
   "end": 317.54,
   "text": "Co spánek? Zkoušela jste něco?"
  },
  {
   "start": 317.54,
   "end": 323.8,
   "text": "Hrvánkový čaj a to je všechno. Doktorka mi nebídla prášky, ale nechci."
  },
  {
   "start": 324.02,
   "end": 324.5,
   "text": "Proč nechcete?"
  },
  {
   "start": 325.2,
   "end": 330.3,
   "text": "Bojím si, že bych se nemohla včas zbudit pro děti a nechci být závisla."
  },
  {
   "start": 331.08,
   "end": 337.56,
   "text": "To rozumím. Zkusíte tohle moc něco malého, třeba se vedle postele nechat papíra napsat, co vás budí?"
  },
  {
   "start": 338.52,
   "end": 340.92,
   "text": "Mohla bych, alespoň to dostanu z hlavy."
  },
  {
   "start": 342.08,
   "end": 343.08,
   "text": "A lidě tam."
  },
  {
   "start": 344.18,
   "end": 345.04,
   "text": "Čeho se nejvíc bojíte?"
  },
  {
   "start": 345.04,
   "end": 350.2,
   "text": "Že s panikařím rozpláču se. Že nezvládnou zůstat klidná."
  },
  {
   "start": 350.86,
   "end": 351.72,
   "text": "Tak kde by to nevadilo?"
  },
  {
   "start": 352.24,
   "end": 356.78,
   "text": "Že bych plakala před dětmi. Vždyť to by pro ně bylo děsivé."
  },
  {
   "start": 357.7,
   "end": 362.2,
   "text": "Nebo by mohly vidět, že jsme také dovolený."
  },
  {
   "start": 363.4,
   "end": 368.2,
   "text": "To mě nenapadlo. Anička je citlivá. Možná by jí to pomohlo."
  },
  {
   "start": 369.38,
   "end": 372.66,
   "text": "Můžeme se příště podívat, jak to připravit."
  },
  {
   "start": 372.66,
   "end": 374.66,
   "text": "Co se odnesete z dneška?"
  },
  {
   "start": 375.56,
   "end": 378.58,
   "text": "Že nejsem sama a že to nemusím zvládnout hned."
  },
  {
   "start": 378.94,
   "end": 381.56,
   "text": "Přesně to. Pro dnešek tady skončíme."
  },
  {
   "start": 382.14,
   "end": 384.1,
   "text": "Děkuji. Uvidíme se příští týden."
  }
 ],
 "round": "r3a"
}