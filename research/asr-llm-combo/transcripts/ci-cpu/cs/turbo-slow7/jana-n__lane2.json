{
 "engine": "turbo-slow7",
 "base": "whisper-large-v3-turbo",
 "opts": {
  "ffmpeg_filter": "atempo=0.7"
 },
 "client": "jana-n",
 "lang": "cs",
 "lane": 2,
 "audio_s": 549.3,
 "seconds": 223.8,
 "rtf": 0.407,
 "wer": 0.2274,
 "cer": 0.1337,
 "segments": [
  {
   "start": 0.46,
   "end": 3.4,
   "text": "Dobrý den, paní Láková, pojďte dala."
  },
  {
   "start": 4.16,
   "end": 6.84,
   "text": "S čím byste dnes chtěla začít?"
  },
  {
   "start": 8.02,
   "end": 9.78,
   "text": "Dobrý den, já ani nevím."
  },
  {
   "start": 10.12,
   "end": 14.52,
   "text": "Mám pocit, že mi někdo vytáhl koverec pod nohou."
  },
  {
   "start": 14.98,
   "end": 15.64,
   "text": "Co se stalo?"
  },
  {
   "start": 16.72,
   "end": 23.78,
   "text": "Po patnácti letech mančelství jsme se s mančelem Radkem rozhodli pro rozhod."
  },
  {
   "start": 23.78,
   "end": 26.36,
   "text": "A já to pořád nemohu pochopit."
  },
  {
   "start": 27.1,
   "end": 28.18,
   "text": "Řekněte mi víc."
  },
  {
   "start": 28.88,
   "end": 32.02,
   "text": "Ještě vletě jsem nebeli na dovolené v Chorvatsku."
  },
  {
   "start": 32.18,
   "end": 34.22,
   "text": "Všechno vypadalo normálně."
  },
  {
   "start": 34.52,
   "end": 37.98,
   "text": "A v září mi řekl, že už to takhle dál nejde."
  },
  {
   "start": 39.5,
   "end": 40.56,
   "text": "A jak jste to přijel?"
  },
  {
   "start": 41.14,
   "end": 44.26,
   "text": "Sieděla jsem v kuchni a nemohla jsem nic říct."
  },
  {
   "start": 44.46,
   "end": 48.0,
   "text": "Pak jsem šla uklidit nádobí, jako by se nic nedělo."
  },
  {
   "start": 48.74,
   "end": 50.86,
   "text": "A co se dalo u něč vás?"
  },
  {
   "start": 52.44,
   "end": 53.16,
   "text": "Prázdno."
  },
  {
   "start": 53.16,
   "end": 54.66,
   "text": "A pak zlost."
  },
  {
   "start": 54.82,
   "end": 56.7,
   "text": "Pak zase prázdnost."
  },
  {
   "start": 56.7,
   "end": 59.18,
   "text": "střídat se to několikrát denně."
  },
  {
   "start": 60.12,
   "end": 61.86,
   "text": "Besvětlil vám, Radek, proč?"
  },
  {
   "start": 63.12,
   "end": 65.14,
   "text": "Říká, že jsme se zdáli,"
  },
  {
   "start": 65.46,
   "end": 67.38,
   "text": "že žijeme vedle sebe."
  },
  {
   "start": 67.72,
   "end": 69.26,
   "text": "Já si toho nevšimla,"
  },
  {
   "start": 69.4,
   "end": 72.16,
   "text": "nebo jsem si všimnout nechtěla?"
  },
  {
   "start": 73.74,
   "end": 75.68,
   "text": "Co se o tom myslíte teď?"
  },
  {
   "start": 77.28,
   "end": 79.92,
   "text": "Že jsem to měla vidět,"
  },
  {
   "start": 79.92,
   "end": 81.26,
   "text": "že jsem slepá."
  },
  {
   "start": 81.74,
   "end": 83.68,
   "text": "Pořád se v hlavě vracím"
  },
  {
   "start": 83.68,
   "end": 86.06,
   "text": "a hledám, kde jsem udělala chybu."
  },
  {
   "start": 86.7,
   "end": 87.7,
   "text": "A našla s tým?"
  },
  {
   "start": 88.18,
   "end": 88.44,
   "text": "Ne."
  },
  {
   "start": 89.6,
   "end": 94.2,
   "text": "Jednou si myslím, že jsem byla moc unavená, nezajímalá jsem se o něj."
  },
  {
   "start": 94.32,
   "end": 98.38,
   "text": "Jen když zase, že jsem se starala moc."
  },
  {
   "start": 100.02,
   "end": 103.54,
   "text": "Vypadá to, že se v tom hodině trápíte."
  },
  {
   "start": 104.16,
   "end": 106.86,
   "text": "Ano, hlavně kvůli dětem."
  },
  {
   "start": 107.48,
   "end": 108.6,
   "text": "Vy jdeme o nich."
  },
  {
   "start": 109.36,
   "end": 116.48,
   "text": "Mám dvě děti, Aničce 12 a Matějovi 8 let a nevím, jak jim to říct."
  },
  {
   "start": 116.7,
   "end": 117.92,
   "text": "Ještě jste jen to neřekla?"
  },
  {
   "start": 118.16,
   "end": 118.42,
   "text": "Ne."
  },
  {
   "start": 118.84,
   "end": 122.02,
   "text": "Radek chce, abychom to řekli společně,"
  },
  {
   "start": 122.18,
   "end": 124.14,
   "text": "ale pořád to odkládáme."
  },
  {
   "start": 125.14,
   "end": 127.12,
   "text": "Anička už něco tuší."
  },
  {
   "start": 127.44,
   "end": 128.36,
   "text": "Co vám to říkal?"
  },
  {
   "start": 129.88,
   "end": 131.82,
   "text": "Minulý týden jsem mě zeptala,"
  },
  {
   "start": 131.92,
   "end": 134.12,
   "text": "jestli se s tátou hádáme."
  },
  {
   "start": 134.12,
   "end": 135.7,
   "text": "Řekla jsem, že ne."
  },
  {
   "start": 136.78,
   "end": 138.98,
   "text": "Cítila jsem se hrozně."
  },
  {
   "start": 143.38,
   "end": 144.86,
   "text": "Proč hrozně?"
  },
  {
   "start": 146.58,
   "end": 148.62,
   "text": "Protože jsem lhala."
  },
  {
   "start": 148.78,
   "end": 150.3,
   "text": "A ona to poznala."
  },
  {
   "start": 150.38,
   "end": 152.54,
   "text": "Viděla jsi mi to na očích."
  },
  {
   "start": 153.02,
   "end": 154.38,
   "text": "Co se vám mojilo hlavou?"
  },
  {
   "start": 155.16,
   "end": 158.2,
   "text": "Že ji ničím život, že ji vezmu domov."
  },
  {
   "start": 159.78,
   "end": 162.58,
   "text": "Jak by se vám dařilo říct jí pravdu?"
  },
  {
   "start": 163.82,
   "end": 168.24,
   "text": "Nejraději bych to měla za sebou, ale bojím se jejich slz."
  },
  {
   "start": 168.24,
   "end": 172.2,
   "text": "A Matě je ještě malý den moc nic nechápe."
  },
  {
   "start": 172.8,
   "end": 174.3,
   "text": "Co byste mu chtěla předat?"
  },
  {
   "start": 175.28,
   "end": 179.18,
   "text": "Že ho máme oba rádi a že se to nezmíní."
  },
  {
   "start": 179.42,
   "end": 183.4,
   "text": "Jenže já vím, nevím jestli je to pravda."
  },
  {
   "start": 184.2,
   "end": 186.84,
   "text": "Když sama nevím, jak to bude vypadat."
  },
  {
   "start": 187.96,
   "end": 189.5,
   "text": "Jak to bude vypadat s bydlením?"
  },
  {
   "start": 190.34,
   "end": 192.4,
   "text": "Byt je na hypotéku."
  },
  {
   "start": 192.74,
   "end": 196.66,
   "text": "Radexa se odstěhuje k bratrově, alespoň se tím."
  },
  {
   "start": 197.32,
   "end": 199.04,
   "text": "Že zůstanou se mnou."
  },
  {
   "start": 199.82,
   "end": 200.98,
   "text": "Jak se vám z toho děla?"
  },
  {
   "start": 201.32,
   "end": 204.1,
   "text": "Mám strach, že to sama nezvládnu."
  },
  {
   "start": 204.3,
   "end": 207.02,
   "text": "Radek důvodně řešil peníze."
  },
  {
   "start": 207.72,
   "end": 209.24,
   "text": "Co dát ve všich dní dnech?"
  },
  {
   "start": 210.08,
   "end": 214.46,
   "text": "Pracuji jako učitelka češtiny na základní škole v Brně."
  },
  {
   "start": 214.72,
   "end": 217.44,
   "text": "Učím devítky a osmičky."
  },
  {
   "start": 218.56,
   "end": 220.24,
   "text": "Jak se vám teď učí?"
  },
  {
   "start": 222.06,
   "end": 224.64,
   "text": "Do třídy chodím s kralíkem v krku."
  },
  {
   "start": 224.86,
   "end": 229.16,
   "text": "Mám pocit, že všichni ví, že se mi rozpadá život."
  },
  {
   "start": 232.2,
   "end": 234.9,
   "text": "Ví o tom někde ve školu?"
  },
  {
   "start": 234.9,
   "end": 243.9,
   "text": "Jen ředitelka. Řekla jsem jí to, protože jsem se jednou rozplakala na chodbě. Byla hodná."
  },
  {
   "start": 243.9,
   "end": 245.9,
   "text": "Co vám pomohlo?"
  },
  {
   "start": 245.9,
   "end": 256.47,
   "text": "Že mě nechala odejít dřív. Dala mi hodinu volné. Jenže pak jsem seděla doma, bylo to horší."
  },
  {
   "start": 256.47,
   "end": 259.47,
   "text": "Horší? Proč?"
  },
  {
   "start": 259.47,
   "end": 265.47,
   "text": "Protože jsem byla sama za hlavou. V práci jsem měla aspoň co dělat."
  },
  {
   "start": 265.47,
   "end": 268.47,
   "text": "Jak spíte?"
  },
  {
   "start": 269.67,
   "end": 276.25,
   "text": "Špatně. Každou noci budím ve tři hodin ráno a přemýšlím, co bude dál."
  },
  {
   "start": 277.13,
   "end": 279.45,
   "text": "Co se říkáte, když se probudíte?"
  },
  {
   "start": 280.97,
   "end": 285.45,
   "text": "Že nemám hypotéku, nemám manžela, nemám nic."
  },
  {
   "start": 285.73,
   "end": 290.89,
   "text": "Pak spočítám peníze, pak si představím, jak to řeknu dětem."
  },
  {
   "start": 291.93,
   "end": 293.39,
   "text": "Točí se to dokola."
  },
  {
   "start": 293.99,
   "end": 294.47,
   "text": "A pak?"
  },
  {
   "start": 294.47,
   "end": 302.91,
   "text": "Kolem páté usnu a v půl sedme vstávám. Jsem unavená už ráno."
  },
  {
   "start": 303.95,
   "end": 305.55,
   "text": "Jíte? Hýbete se?"
  },
  {
   "start": 306.83,
   "end": 313.73,
   "text": "Jím málo. Zubla jsem čtyřikila. Kamarádka mi říká, že vpadám hrozně."
  },
  {
   "start": 315.13,
   "end": 317.85,
   "text": "Máte kolem sebe někoho, s kým můžete mluvit?"
  },
  {
   "start": 317.85,
   "end": 328.41,
   "text": "Co jim říkáte?"
  },
  {
   "start": 337.53,
   "end": 339.89,
   "text": "Co se obáváte, co si myslí?"
  },
  {
   "start": 347.85,
   "end": 355.05,
   "text": "To je těžká myslenka. Odkud se bera?"
  },
  {
   "start": 355.91,
   "end": 362.71,
   "text": "Asi od mojí mámy. Ta vždycky říkala, že manželství se drží a děto jak chce."
  },
  {
   "start": 364.37,
   "end": 367.21,
   "text": "Co řekla, když jsi jí to oznámila?"
  },
  {
   "start": 367.81,
   "end": 373.85,
   "text": "Mlčela. Pak řekla, že doufá, že jí jsem to dobře zvážela."
  },
  {
   "start": 373.85,
   "end": 377.85,
   "text": "Už se od té doby moc neozvala."
  },
  {
   "start": 379.96,
   "end": 380.62,
   "text": "Jak mám to?"
  },
  {
   "start": 381.68,
   "end": 382.4,
   "text": "Smutno."
  },
  {
   "start": 383.58,
   "end": 386.46,
   "text": "Potřebovala bych, aby mě objela."
  },
  {
   "start": 387.8,
   "end": 389.24,
   "text": "Co byste jítla líct?"
  },
  {
   "start": 389.98,
   "end": 395.36,
   "text": "Že to bolí, že nechci být sama, jenže u nás se to nedělá."
  },
  {
   "start": 397.53,
   "end": 399.65,
   "text": "Co se děl, když to říkáte na hlas?"
  },
  {
   "start": 401.01,
   "end": 402.99,
   "text": "Pláču a omluva."
  },
  {
   "start": 405.98,
   "end": 408.74,
   "text": "Nyn, nyn..."
  },
  {
   "start": 408.74,
   "end": 409.98,
   "text": "Vezměte se čas."
  },
  {
   "start": 409.98,
   "end": 416.06,
   "text": "Děkuji, ještě jsem nikomu tohle neřekla."
  },
  {
   "start": 416.06,
   "end": 423.65,
   "text": "Spáv mi dělat, že jste to tady řekla."
  },
  {
   "start": 424.65,
   "end": 434.4,
   "text": "Je zvláštní sedět tady a říkat to všechno nahlas, ale trochu to pomáhá."
  },
  {
   "start": 437.23,
   "end": 439.23,
   "text": "Co by vám teď mohlo pomoct nejvíc?"
  },
  {
   "start": 441.23,
   "end": 444.23,
   "text": "Spát a vyjede kteříc s dětem."
  },
  {
   "start": 444.23,
   "end": 445.21,
   "text": "s dětem."
  },
  {
   "start": 447.36,
   "end": 448.52,
   "text": "Pěkme na to postupně."
  },
  {
   "start": 449.76,
   "end": 452.1,
   "text": "Co z pánek?"
  },
  {
   "start": 452.56,
   "end": 453.56,
   "text": "Zkoušila jste něco?"
  },
  {
   "start": 455.64,
   "end": 456.98,
   "text": "Hrvánkový čaj"
  },
  {
   "start": 456.98,
   "end": 458.42,
   "text": "a to je všechno."
  },
  {
   "start": 458.56,
   "end": 460.74,
   "text": "Doktorka mi nebídla prášky,"
  },
  {
   "start": 461.08,
   "end": 462.56,
   "text": "ale nechci."
  },
  {
   "start": 462.9,
   "end": 463.54,
   "text": "Proč nechcete?"
  },
  {
   "start": 464.58,
   "end": 465.96,
   "text": "Pojím si, že bych"
  },
  {
   "start": 465.96,
   "end": 468.96,
   "text": "se nemohla včas zbudit"
  },
  {
   "start": 468.96,
   "end": 471.0,
   "text": "pro děti a nechci být"
  },
  {
   "start": 471.0,
   "end": 471.84,
   "text": "závisla."
  },
  {
   "start": 472.96,
   "end": 474.46,
   "text": "To je rozuměl."
  },
  {
   "start": 475.54,
   "end": 476.88,
   "text": "Zkusíte tohle nocí"
  },
  {
   "start": 477.08,
   "end": 482.22,
   "text": "Něco malého třeba sedla postela nechat papír a napsat, co vás budí?"
  },
  {
   "start": 483.6,
   "end": 487.02,
   "text": "Mohla bych, ale zbyň to dostanu z hlavy."
  },
  {
   "start": 488.66,
   "end": 490.1,
   "text": "A dětem."
  },
  {
   "start": 491.66,
   "end": 492.9,
   "text": "Kdy ho se nejí být zbojíte?"
  },
  {
   "start": 493.9,
   "end": 500.3,
   "text": "Že s panikařím rozpláču se, že nezvládnu zůstat klidná."
  },
  {
   "start": 501.3,
   "end": 502.42,
   "text": "Tak kdo by to nevadilo?"
  },
  {
   "start": 502.42,
   "end": 509.7,
   "text": "Že bych polukala před dětmi? Vždyť to by pro ně bylo děsivé."
  },
  {
   "start": 511.14,
   "end": 517.42,
   "text": "Nebo by mohly vidět, že jsme také dovolený."
  },
  {
   "start": 519.12,
   "end": 520.42,
   "text": "To mně nenapadlo."
  },
  {
   "start": 523.54,
   "end": 526.0,
   "text": "Myslím, bychom možná by jí to pomohlo."
  },
  {
   "start": 527.68,
   "end": 531.78,
   "text": "Můžeme se příště podívat, jak to připravit."
  },
  {
   "start": 531.78,
   "end": 535.22,
   "text": "Co se odnesete z dneška?"
  },
  {
   "start": 536.52,
   "end": 540.78,
   "text": "Že nejsem sama a že to nemusím zvládnout hned."
  },
  {
   "start": 541.34,
   "end": 545.08,
   "text": "Přesně to. Pro dnešek teď skončíme."
  },
  {
   "start": 545.86,
   "end": 548.74,
   "text": "Děkuji. Uvidíme se příští týden."
  }
 ],
 "round": "r3a"
}