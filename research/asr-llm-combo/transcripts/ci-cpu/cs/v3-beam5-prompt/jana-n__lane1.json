{
 "engine": "v3-beam5-prompt",
 "base": "whisper-large-v3",
 "opts": {
  "beam_size": 5,
  "initial_prompt": {
   "cs": "Rozhovor v psychoterapii mezi terapeutem a klientem. Klient mluví o rodině, práci, spánku, úzkosti a pocitech.",
   "en": "A psychotherapy session between a therapist and a client. The client talks about family, work, sleep, anxiety and feelings."
  }
 },
 "client": "jana-n",
 "lang": "cs",
 "lane": 1,
 "audio_s": 384.5,
 "seconds": 525.0,
 "rtf": 1.365,
 "wer": 0.1193,
 "cer": 0.0585,
 "segments": [
  {
   "start": 0.78,
   "end": 2.38,
   "text": "Dobrý den, paní Nováková, pojďte dál."
  },
  {
   "start": 2.88,
   "end": 4.78,
   "text": "S čím byste dnes chtěla začít?"
  },
  {
   "start": 5.6,
   "end": 10.16,
   "text": "Dobrý den, já ani nevím. Mám pocit, že mi někdo vytáhl koverec pod nohou."
  },
  {
   "start": 10.5,
   "end": 10.96,
   "text": "Co se stalo?"
  },
  {
   "start": 11.68,
   "end": 18.46,
   "text": "Po patnácti letech manželství jsme se s manželem Radkem rozhodli pro rozvod a já to pořád nemohu pochopit."
  },
  {
   "start": 19.0,
   "end": 19.72,
   "text": "Řekněte mi víc."
  },
  {
   "start": 20.28,
   "end": 26.6,
   "text": "Ještě v letě jsme byly nedovolené v Chorvatsku a všechno vypadalo normálně a v září mi řekl, že už to takhle dál nejde."
  },
  {
   "start": 27.64,
   "end": 28.42,
   "text": "A jak jste to přijalo?"
  },
  {
   "start": 28.86,
   "end": 30.96,
   "text": "Seděla jsem v kuchyni a nemohla jsem nic říct."
  },
  {
   "start": 31.12,
   "end": 33.62,
   "text": "Pak jsem šla uklidit nádobí, jako by se nic nedělo."
  },
  {
   "start": 34.12,
   "end": 35.6,
   "text": "A co se dalo uvnitř vás?"
  },
  {
   "start": 36.7,
   "end": 39.7,
   "text": "Prázdno, pak zlost, pak zase prázdnost."
  },
  {
   "start": 39.86,
   "end": 41.42,
   "text": "Třídá se to několikrát denně."
  },
  {
   "start": 42.08,
   "end": 43.32,
   "text": "Vysvětlil vám Radek proč?"
  },
  {
   "start": 44.18,
   "end": 47.16,
   "text": "Říká, že jsme se vzdáleli, že žijeme vedle sebe."
  },
  {
   "start": 47.4,
   "end": 50.54,
   "text": "Já si toho nevšimla, nebo jsem si všimnout nechtěla."
  },
  {
   "start": 51.64,
   "end": 52.98,
   "text": "Co si o tom myslíte teď?"
  },
  {
   "start": 54.08,
   "end": 56.86,
   "text": "Že jsem to měla vidět, že jsem slepá."
  },
  {
   "start": 56.86,
   "end": 59.08,
   "text": "pořád se v hlavě vracím a hledám,"
  },
  {
   "start": 59.18,
   "end": 60.26,
   "text": "kde jsem udělala chybu."
  },
  {
   "start": 60.78,
   "end": 61.9,
   "text": "A našla jsi? Ne."
  },
  {
   "start": 62.74,
   "end": 64.54,
   "text": "Jednou si myslím, že jsem byla moc unavená,"
  },
  {
   "start": 64.62,
   "end": 66.68,
   "text": "nezajímala jsem se o něj. Jednou zase,"
  },
  {
   "start": 67.34,
   "end": 68.9,
   "text": "že jsem se starala moc."
  },
  {
   "start": 70.02,
   "end": 71.04,
   "text": "Vypadá to, že se"
  },
  {
   "start": 71.04,
   "end": 72.5,
   "text": "v tom hodině trápíte."
  },
  {
   "start": 72.92,
   "end": 74.82,
   "text": "Ano, hlavně kvůli dětem."
  },
  {
   "start": 75.24,
   "end": 76.02,
   "text": "Pověďte mi o nich."
  },
  {
   "start": 76.76,
   "end": 78.78,
   "text": "Mám dvě děti, Aničce, dvanáct"
  },
  {
   "start": 78.78,
   "end": 81.48,
   "text": "a Matějevi osm let a nevím, jak jim to říct."
  },
  {
   "start": 81.48,
   "end": 82.92,
   "text": "Ještě jste jim to neřekla? Ne."
  },
  {
   "start": 83.18,
   "end": 85.42,
   "text": "Radek chce, abychom to řekli společně,"
  },
  {
   "start": 85.42,
   "end": 86.94,
   "text": "alebo řád to odkládáme."
  },
  {
   "start": 87.64,
   "end": 89.0,
   "text": "Anička už něco tuší."
  },
  {
   "start": 89.24,
   "end": 89.88,
   "text": "Co vám to říká?"
  },
  {
   "start": 90.9,
   "end": 93.9,
   "text": "Minulý týden se mě zeptala, jestli se s tátou hádáme."
  },
  {
   "start": 94.06,
   "end": 95.04,
   "text": "Řekla jsem, že ne."
  },
  {
   "start": 95.8,
   "end": 97.28,
   "text": "Cítila jsem se hrozně."
  },
  {
   "start": 100.4,
   "end": 101.42,
   "text": "Proč hrozně?"
  },
  {
   "start": 102.64,
   "end": 104.06,
   "text": "Protože jsem lhala."
  },
  {
   "start": 104.14,
   "end": 105.16,
   "text": "A ona to poznala."
  },
  {
   "start": 105.32,
   "end": 106.78,
   "text": "Viděla jsem jí to na očích."
  },
  {
   "start": 107.12,
   "end": 108.08,
   "text": "Co se vám oňalo hlavou?"
  },
  {
   "start": 108.66,
   "end": 110.76,
   "text": "Že ji ničím život. Že ji vezmu domov."
  },
  {
   "start": 111.92,
   "end": 113.8,
   "text": "Kde se vám dařilo, že jí cítí pravdu?"
  },
  {
   "start": 114.68,
   "end": 116.18,
   "text": "Nejraději bych to měla za sebou,"
  },
  {
   "start": 116.18,
   "end": 117.86,
   "text": "ale bojím se jejich slz."
  },
  {
   "start": 118.02,
   "end": 120.52,
   "text": "A Matěj je ještě malý, ten moc nic nechápe."
  },
  {
   "start": 120.96,
   "end": 122.02,
   "text": "Co byste mu chtěla předat?"
  },
  {
   "start": 122.66,
   "end": 124.14,
   "text": "Že ho máme oba rádi"
  },
  {
   "start": 124.14,
   "end": 125.38,
   "text": "a že se to nezmění."
  },
  {
   "start": 125.62,
   "end": 128.4,
   "text": "Jenže já nevím, jestli je to pravda,"
  },
  {
   "start": 128.94,
   "end": 130.18,
   "text": "když sama nevím, jak to bude vypadat."
  },
  {
   "start": 131.56,
   "end": 132.64,
   "text": "Jak to bude vypadat s bydlením?"
  },
  {
   "start": 133.22,
   "end": 134.18,
   "text": "Byd je na hypotéku,"
  },
  {
   "start": 134.94,
   "end": 136.8,
   "text": "Radek se asi odstihuje k bratrově,"
  },
  {
   "start": 136.86,
   "end": 137.66,
   "text": "alespoň zatím."
  },
  {
   "start": 138.18,
   "end": 139.34,
   "text": "Dítě zůstanou se mnou."
  },
  {
   "start": 139.88,
   "end": 140.74,
   "text": "Jak se vám z toho dělá?"
  },
  {
   "start": 140.92,
   "end": 142.88,
   "text": "Mám strach, že to sama nezvládnu."
  },
  {
   "start": 143.1,
   "end": 144.94,
   "text": "Radek by vždycky řešil peníze."
  },
  {
   "start": 146.18,
   "end": 148.44,
   "text": "dnech. Pracuji jako učitelka češtiny"
  },
  {
   "start": 148.44,
   "end": 150.12,
   "text": "na základní škole v Brně."
  },
  {
   "start": 150.3,
   "end": 152.22,
   "text": "Učím devítky a osmičky."
  },
  {
   "start": 153.0,
   "end": 154.18,
   "text": "Jak se vám teď učí?"
  },
  {
   "start": 155.1,
   "end": 156.22,
   "text": "Do třídy chodím"
  },
  {
   "start": 156.22,
   "end": 158.04,
   "text": "s knelíkem v krku. Mám pocit, že"
  },
  {
   "start": 158.04,
   "end": 160.42,
   "text": "všichni vidí, že se mi rozpadá život."
  },
  {
   "start": 162.54,
   "end": 164.38,
   "text": "Ví o tom někde ve škole?"
  },
  {
   "start": 165.16,
   "end": 166.12,
   "text": "Jen ředitelka."
  },
  {
   "start": 166.28,
   "end": 168.1,
   "text": "Řekla jsem jí to, protože jsem"
  },
  {
   "start": 168.1,
   "end": 169.9,
   "text": "se jednou rozplakala na chodbě."
  },
  {
   "start": 170.02,
   "end": 171.96,
   "text": "Byla hodná. Co vám pomohlo?"
  },
  {
   "start": 173.34,
   "end": 174.42,
   "text": "Že mě nechala"
  },
  {
   "start": 174.42,
   "end": 175.88,
   "text": "odejít dřív. Dala mi"
  },
  {
   "start": 175.88,
   "end": 177.6,
   "text": "je hodinu volné. Jenže pak jsem"
  },
  {
   "start": 177.6,
   "end": 179.38,
   "text": "seděla doma a bylo to horší."
  },
  {
   "start": 179.88,
   "end": 181.34,
   "text": "Horší. Proč?"
  },
  {
   "start": 182.22,
   "end": 183.86,
   "text": "Protože jsem byla sama za hlavou."
  },
  {
   "start": 184.04,
   "end": 185.86,
   "text": "V práci jsem měla aspoň co dělat."
  },
  {
   "start": 187.04,
   "end": 187.92,
   "text": "Jak spíte?"
  },
  {
   "start": 188.78,
   "end": 189.34,
   "text": "Špatně."
  },
  {
   "start": 190.16,
   "end": 191.9,
   "text": "Každou noc se budím ve tři hodiny ráno"
  },
  {
   "start": 191.9,
   "end": 193.38,
   "text": "a přemýšlím, co bude dál."
  },
  {
   "start": 193.96,
   "end": 195.62,
   "text": "Co se říkáte, když se probudíte?"
  },
  {
   "start": 196.7,
   "end": 197.82,
   "text": "Že nemám hypotéku,"
  },
  {
   "start": 197.9,
   "end": 199.84,
   "text": "nemám manžela, nemám nic."
  },
  {
   "start": 200.02,
   "end": 201.68,
   "text": "Pak spočítám peníze, pak si"
  },
  {
   "start": 201.68,
   "end": 203.64,
   "text": "představím, jak to řeknu dětem."
  },
  {
   "start": 204.34,
   "end": 205.38,
   "text": "Točí se to dokola."
  },
  {
   "start": 205.76,
   "end": 206.14,
   "text": "A pak?"
  },
  {
   "start": 207.14,
   "end": 210.02,
   "text": "Kolem páté usnu a v půl sedmé vstávám."
  },
  {
   "start": 210.4,
   "end": 212.02,
   "text": "Jsem unavená už ráno."
  },
  {
   "start": 212.76,
   "end": 213.92,
   "text": "Jíte? Hýbete se?"
  },
  {
   "start": 214.8,
   "end": 215.94,
   "text": "Jím málo."
  },
  {
   "start": 216.12,
   "end": 217.3,
   "text": "Zubla jsem čtyři kyla."
  },
  {
   "start": 217.46,
   "end": 219.62,
   "text": "Kamarádka mi říká, že vypadám hrozně."
  },
  {
   "start": 220.58,
   "end": 222.36,
   "text": "Máte kolem sebe někoho, s kým můžete mluvit?"
  },
  {
   "start": 222.92,
   "end": 224.7,
   "text": "Mám sestru Alanu v Olomouci."
  },
  {
   "start": 225.28,
   "end": 227.22,
   "text": "Volá mi skoro každý večer."
  },
  {
   "start": 227.34,
   "end": 229.0,
   "text": "A kamarádku Evu z práce."
  },
  {
   "start": 229.0,
   "end": 229.9,
   "text": "Co jim říkáte?"
  },
  {
   "start": 230.7,
   "end": 231.96,
   "text": "Ale cizkoro všechno."
  },
  {
   "start": 232.12,
   "end": 234.1,
   "text": "Evě jen to, že mám těžké období."
  },
  {
   "start": 234.6,
   "end": 236.22,
   "text": "Nechce, aby se o mě něco myslela."
  },
  {
   "start": 236.74,
   "end": 237.94,
   "text": "Co se obháváte, že se myslí?"
  },
  {
   "start": 238.8,
   "end": 239.9,
   "text": "Že jsem se lhala."
  },
  {
   "start": 240.12,
   "end": 243.92,
   "text": "Že žena, která nedokáže udržet manželství, není pro děti dobrý příklad."
  },
  {
   "start": 244.92,
   "end": 247.06,
   "text": "To je těžká myšlenka."
  },
  {
   "start": 247.9,
   "end": 248.5,
   "text": "Odkud se bere?"
  },
  {
   "start": 249.08,
   "end": 250.18,
   "text": "Asi od mojí mámy."
  },
  {
   "start": 250.4,
   "end": 253.86,
   "text": "Ta vždycky říkala, že manželství se drží, ať je to, jak chce."
  },
  {
   "start": 255.04,
   "end": 257.06,
   "text": "Co řekla, když jste jí to oznámila?"
  },
  {
   "start": 257.54,
   "end": 258.02,
   "text": "Molčela."
  },
  {
   "start": 258.62,
   "end": 262.16,
   "text": "Pak řekla, že doufá, že jsem to dobře zvážela."
  },
  {
   "start": 262.76,
   "end": 264.5,
   "text": "Už se od té doby moc neozvala."
  },
  {
   "start": 265.92,
   "end": 266.56,
   "text": "Jak vám to je?"
  },
  {
   "start": 267.16,
   "end": 267.68,
   "text": "Smutno."
  },
  {
   "start": 268.5,
   "end": 270.56,
   "text": "Potřebovala bych, aby mě olběla."
  },
  {
   "start": 271.46,
   "end": 272.48,
   "text": "Co byste jistila říct?"
  },
  {
   "start": 272.98,
   "end": 275.06,
   "text": "Že to bolí, že nechci být sama."
  },
  {
   "start": 275.34,
   "end": 277.14,
   "text": "Jenže u nás se to nedělá."
  },
  {
   "start": 278.24,
   "end": 279.76,
   "text": "Co se děje, když to říkáte na hlas?"
  },
  {
   "start": 280.7,
   "end": 282.72,
   "text": "Pláču a omlouvám se."
  },
  {
   "start": 284.16,
   "end": 285.3,
   "text": "Není za co."
  },
  {
   "start": 286.16,
   "end": 287.0,
   "text": "Vezměte si čas."
  },
  {
   "start": 288.76,
   "end": 289.28,
   "text": "Děkuji."
  },
  {
   "start": 289.28,
   "end": 291.54,
   "text": "Ještě jsem nikomu tohle neřekla."
  },
  {
   "start": 293.7,
   "end": 297.06,
   "text": "Co s vámi dělá, že jste to tady řekla?"
  },
  {
   "start": 299.56,
   "end": 303.32,
   "text": "Je zvláštní sedět tady a říkat to všechno nahlas,"
  },
  {
   "start": 303.44,
   "end": 304.7,
   "text": "ale trochu to pomáhá."
  },
  {
   "start": 306.2,
   "end": 307.68,
   "text": "Co by vám teď mohlo pomoct nejvíc?"
  },
  {
   "start": 309.12,
   "end": 311.68,
   "text": "Spát a vědět, jak to říct dětem."
  },
  {
   "start": 313.14,
   "end": 314.0,
   "text": "Překvap na to postupně."
  },
  {
   "start": 314.88,
   "end": 317.52,
   "text": "Co spánek? Zkoušela jste něco?"
  },
  {
   "start": 318.92,
   "end": 320.9,
   "text": "Hrvánkový čaj a to je všechno."
  },
  {
   "start": 321.0,
   "end": 323.82,
   "text": "Doktorka mi nebídla prášky, ale nechci."
  },
  {
   "start": 324.04,
   "end": 324.5,
   "text": "Proč nechcete?"
  },
  {
   "start": 325.2,
   "end": 330.36,
   "text": "Bojím se, že bych se nemohla včas vzbudit pro děti a nechci být závislá."
  },
  {
   "start": 331.08,
   "end": 332.08,
   "text": "To je rozumné."
  },
  {
   "start": 332.88,
   "end": 337.58,
   "text": "Zkusíte tohle noc něco malého, třeba se vedle postele nechat papíra napsat, co vás vzbudí?"
  },
  {
   "start": 338.52,
   "end": 340.92,
   "text": "Mohla bych, ale spíš to dostanu z hlavy."
  },
  {
   "start": 342.08,
   "end": 343.08,
   "text": "A k dětem?"
  },
  {
   "start": 344.16,
   "end": 345.04,
   "text": "Čeho se nejvíc bojíte?"
  },
  {
   "start": 345.72,
   "end": 350.2,
   "text": "Že s panikařím rozpláču se, že nezvládnu zůstat klidná."
  },
  {
   "start": 350.92,
   "end": 351.7,
   "text": "Tak kdo by to nevadilo?"
  },
  {
   "start": 352.24,
   "end": 353.74,
   "text": "Že bych plakala před dětmi?"
  },
  {
   "start": 354.5,
   "end": 356.8,
   "text": "Vždyť to by pro ně bylo děsivé."
  },
  {
   "start": 357.74,
   "end": 362.2,
   "text": "Nebo by mohly vidět, že smutek je dovolený."
  },
  {
   "start": 363.4,
   "end": 364.8,
   "text": "To mě nenapadlo."
  },
  {
   "start": 365.44,
   "end": 368.2,
   "text": "Ani špecitlivé. Možná by jí to pomohlo."
  },
  {
   "start": 369.4,
   "end": 372.66,
   "text": "Můžeme se příště podívat, jak to připravit."
  },
  {
   "start": 373.34,
   "end": 374.64,
   "text": "Co dnes je test dneška?"
  },
  {
   "start": 375.56,
   "end": 378.4,
   "text": "Že nejsem sama a že to nemusím zvládnout hned."
  },
  {
   "start": 378.9,
   "end": 379.44,
   "text": "Přesně to."
  },
  {
   "start": 380.42,
   "end": 381.54,
   "text": "Pro dnešek tady skončíme."
  },
  {
   "start": 382.14,
   "end": 384.14,
   "text": "Děkuji. Uvidíme se příští týden."
  },
  {
   "start": 384.5,
   "end": 414.48,
   "text": "www.hradeckralove.org"
  }
 ],
 "round": "r2a"
}