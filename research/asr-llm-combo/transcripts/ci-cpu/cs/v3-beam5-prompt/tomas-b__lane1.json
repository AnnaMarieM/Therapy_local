{
 "engine": "v3-beam5-prompt",
 "base": "whisper-large-v3",
 "opts": {
  "beam_size": 5,
  "initial_prompt": {
   "cs": "Rozhovor v psychoterapii mezi terapeutem a klientem. Klient mluví o rodině, práci, spánku, úzkosti a pocitech.",
   "en": "A psychotherapy session between a therapist and a client. The client talks about family, work, sleep, anxiety and feelings."
  }
 },
 "client": "tomas-b",
 "lang": "cs",
 "lane": 1,
 "audio_s": 411.5,
 "seconds": 546.8,
 "rtf": 1.329,
 "wer": 0.1653,
 "cer": 0.0807,
 "segments": [
  {
   "start": 1.65,
   "end": 5.05,
   "text": "Dobrý den, pane Bárto, pojďte dál. Jak se vám dnes daří?"
  },
  {
   "start": 5.59,
   "end": 9.81,
   "text": "Dobrý den, docela jsem nervózní. Jestli mám odbít upřímný, nikde jsem psychologa nebyl."
  },
  {
   "start": 10.37,
   "end": 13.43,
   "text": "To je naprosto v pořádku. Co vás sem přivádí?"
  },
  {
   "start": 14.07,
   "end": 18.01,
   "text": "Manželka. Říká, že už to takhle nejde. A já vlastně taky ne."
  },
  {
   "start": 18.45,
   "end": 19.35,
   "text": "Co nejde?"
  },
  {
   "start": 20.05,
   "end": 25.75,
   "text": "30x zečer kontroluji, jestli sem zamknu dveře a vypnu sporák. Trvá mi to hodinu, než odejdu z bytu."
  },
  {
   "start": 26.71,
   "end": 28.35,
   "text": "Hodinu? Jak to vypadá?"
  },
  {
   "start": 28.79,
   "end": 32.53,
   "text": "Zamknu dveře, nadejdu k výtahu, vrátím se a zatáhnu zakvěku."
  },
  {
   "start": 33.17,
   "end": 35.33,
   "text": "Pak zkontroluji sporách, každý knov týždlář."
  },
  {
   "start": 35.93,
   "end": 36.73,
   "text": "Pak zase dveře."
  },
  {
   "start": 37.49,
   "end": 39.21,
   "text": "A když to uděláte, co se stane?"
  },
  {
   "start": 40.11,
   "end": 40.99,
   "text": "Chvíle se mi umaví."
  },
  {
   "start": 41.71,
   "end": 46.69,
   "text": "Pak se mi do hlavy přijde obraz, že jsem to neudala pořádně a musím vzniknout."
  },
  {
   "start": 47.57,
   "end": 48.73,
   "text": "Co je to za obraz?"
  },
  {
   "start": 49.35,
   "end": 51.33,
   "text": "Být v plamenách. Vidím to jasně jako film."
  },
  {
   "start": 52.17,
   "end": 53.95,
   "text": "Jak často se vám to stává?"
  },
  {
   "start": 54.31,
   "end": 57.83,
   "text": "Každý den. Večer je to nejhorší, když jdeme ven nebo spát."
  },
  {
   "start": 57.83,
   "end": 58.77,
   "text": "A ráno taky."
  },
  {
   "start": 59.73,
   "end": 61.45,
   "text": "Jak dlouho už to trvá?"
  },
  {
   "start": 61.91,
   "end": 65.83,
   "text": "Začalo to před dvěma lety, kdy hořelo u sousedů a my se museli evakuovat."
  },
  {
   "start": 66.39,
   "end": 67.65,
   "text": "Řekněte mi o tom víc."
  },
  {
   "start": 68.29,
   "end": 68.83,
   "text": "Bylo to v noci."
  },
  {
   "start": 69.35,
   "end": 72.45,
   "text": "Potom byl u mě avar, na chodbě byl kůž a lidé křičeli."
  },
  {
   "start": 73.29,
   "end": 74.45,
   "text": "Vyvělili jsme jenom v pyžamech."
  },
  {
   "start": 75.21,
   "end": 76.39,
   "text": "Jak vám tehdy bylo?"
  },
  {
   "start": 77.03,
   "end": 78.47,
   "text": "Že tohle je konec."
  },
  {
   "start": 79.15,
   "end": 81.43,
   "text": "Někdo nebyl zraněn, ale sousedům to vyhořelo celé."
  },
  {
   "start": 81.97,
   "end": 84.17,
   "text": "Stál jsem venku v země a koukal, jak hoří okno."
  },
  {
   "start": 85.47,
   "end": 86.45,
   "text": "A od té doby?"
  },
  {
   "start": 87.83,
   "end": 89.93,
   "text": "V té době mám pocit, že to můžu způsobit já."
  },
  {
   "start": 90.59,
   "end": 93.61,
   "text": "Že když něco neskontroluji, tak se to stane a budu věnány."
  },
  {
   "start": 94.23,
   "end": 95.67,
   "text": "To je velká zodpovědnost."
  },
  {
   "start": 96.41,
   "end": 98.91,
   "text": "Já vím, že to nedává smysl. Znám z logiků."
  },
  {
   "start": 99.55,
   "end": 101.01,
   "text": "Přesto se to nedá vypnout."
  },
  {
   "start": 101.89,
   "end": 104.13,
   "text": "Co děláte, když to nechcete dělat?"
  },
  {
   "start": 104.79,
   "end": 105.61,
   "text": "Zkusím to nechat."
  },
  {
   "start": 106.31,
   "end": 108.35,
   "text": "Pak mi roste úzkost, až mám pocit, že se zblázním."
  },
  {
   "start": 109.17,
   "end": 110.21,
   "text": "Radši to udělám."
  },
  {
   "start": 111.25,
   "end": 112.97,
   "text": "Čím se úzkost projevuje?"
  },
  {
   "start": 112.97,
   "end": 116.15,
   "text": "Srdce po třesou země ruce a mě špatnil žaludku."
  },
  {
   "start": 116.95,
   "end": 118.03,
   "text": "Kdo o tom ví?"
  },
  {
   "start": 118.55,
   "end": 120.97,
   "text": "Barbara. Moje manželka."
  },
  {
   "start": 121.65,
   "end": 123.99,
   "text": "Na začátku to bralo jako zvyk, teď už vidí, že je to víc."
  },
  {
   "start": 124.71,
   "end": 125.81,
   "text": "Jak na to reaguje?"
  },
  {
   "start": 126.75,
   "end": 129.25,
   "text": "Trpěl je, ale vidím, že jí to vyčerpává."
  },
  {
   "start": 129.97,
   "end": 132.35,
   "text": "Včera jsme přišli na kino čtyřicet minut později."
  },
  {
   "start": 132.79,
   "end": 133.75,
   "text": "Co se stalo?"
  },
  {
   "start": 134.01,
   "end": 136.97,
   "text": "Čekala venku, než se vrátím a zkončil je sporák po třetí."
  },
  {
   "start": 137.69,
   "end": 139.99,
   "text": "Neřekla nic, jen se na mě podívala."
  },
  {
   "start": 140.55,
   "end": 141.25,
   "text": "Jak vám bylo?"
  },
  {
   "start": 141.79,
   "end": 145.21,
   "text": "Ano. Cítil jsem se jako dítě, který nezvládne vyjít z domu."
  },
  {
   "start": 145.95,
   "end": 147.39,
   "text": "Co děláte za práci?"
  },
  {
   "start": 147.69,
   "end": 149.11,
   "text": "Pracuji jako elektrikář v Malomolce."
  },
  {
   "start": 149.55,
   "end": 151.63,
   "text": "Mám rozvody v bytech a občas v rodinných domech."
  },
  {
   "start": 152.53,
   "end": 154.73,
   "text": "Jak to souvisí s kontrolováním?"
  },
  {
   "start": 155.59,
   "end": 155.93,
   "text": "Hodně."
  },
  {
   "start": 156.55,
   "end": 158.69,
   "text": "Bojím se, že kvůli své hlavě jednou nám chybu,"
  },
  {
   "start": 158.79,
   "end": 160.39,
   "text": "že vpadním před plynem vodě či něco zkořím."
  },
  {
   "start": 160.89,
   "end": 162.59,
   "text": "Stalo se vám něco takového?"
  },
  {
   "start": 162.89,
   "end": 164.05,
   "text": "Ne, nikdy."
  },
  {
   "start": 164.61,
   "end": 166.31,
   "text": "Ale pokračující zakázce se vracím na kontrolu."
  },
  {
   "start": 166.31,
   "end": 168.57,
   "text": "Jen když se tam vrátím druhý den, jen se podívat."
  },
  {
   "start": 169.49,
   "end": 170.37,
   "text": "A kolegové?"
  },
  {
   "start": 170.93,
   "end": 172.57,
   "text": "Myslíš si, že jsem pedant?"
  },
  {
   "start": 173.31,
   "end": 175.61,
   "text": "Žev mi říká, že jsem nejpečtojší ve firmě,"
  },
  {
   "start": 175.65,
   "end": 177.05,
   "text": "ale nevědí, kolik času to stojí."
  },
  {
   "start": 177.53,
   "end": 178.87,
   "text": "Kolik času to stojí?"
  },
  {
   "start": 179.19,
   "end": 181.35,
   "text": "V posledních měsících jsi mědla práce o hodinový zdaně."
  },
  {
   "start": 182.03,
   "end": 183.31,
   "text": "Už jsem pár zakázek přijal kolik,"
  },
  {
   "start": 183.39,
   "end": 184.35,
   "text": "ale proč jsem to nestíhal?"
  },
  {
   "start": 184.91,
   "end": 186.53,
   "text": "Co to s vámi dělá?"
  },
  {
   "start": 187.27,
   "end": 188.95,
   "text": "Mám strach, že přijdu o práce."
  },
  {
   "start": 189.75,
   "end": 190.27,
   "text": "Hlavně teď."
  },
  {
   "start": 191.31,
   "end": 192.21,
   "text": "Proč hodina teď?"
  },
  {
   "start": 192.83,
   "end": 194.67,
   "text": "Probora těhotná, ve čtvrtém měsíci."
  },
  {
   "start": 195.63,
   "end": 197.67,
   "text": "Gratuluji. Jak jsi to přijal?"
  },
  {
   "start": 197.67,
   "end": 199.83,
   "text": "To jsem šťastný, opravdu."
  },
  {
   "start": 200.71,
   "end": 201.91,
   "text": "Čekali jsme na to tři roky,"
  },
  {
   "start": 201.91,
   "end": 203.67,
   "text": "a potom přišla další myšlenka."
  },
  {
   "start": 204.01,
   "end": 204.57,
   "text": "Jaká?"
  },
  {
   "start": 204.91,
   "end": 207.41,
   "text": "Že jí a dítě tě ublíží."
  },
  {
   "start": 208.13,
   "end": 209.13,
   "text": "Ublížíte jak?"
  },
  {
   "start": 209.61,
   "end": 210.67,
   "text": "Ne, že bych chtěl."
  },
  {
   "start": 211.09,
   "end": 212.79,
   "text": "To je hrozné, nikdy bych to neudal."
  },
  {
   "start": 213.03,
   "end": 214.17,
   "text": "Ale ta myšlenka přijde,"
  },
  {
   "start": 214.77,
   "end": 217.07,
   "text": "když krájím chleba na dostajím úschodu"
  },
  {
   "start": 217.07,
   "end": 218.51,
   "text": "a pak se bojím, že to půjde samou."
  },
  {
   "start": 219.21,
   "end": 222.09,
   "text": "Takže je to myšlenka, která vás děsí."
  },
  {
   "start": 223.19,
   "end": 223.83,
   "text": "Ano."
  },
  {
   "start": 224.27,
   "end": 224.95,
   "text": "Je to nejhorší,"
  },
  {
   "start": 225.27,
   "end": 227.45,
   "text": "když jsem to někomu neřekl."
  },
  {
   "start": 227.69,
   "end": 228.69,
   "text": "Ani Barboře."
  },
  {
   "start": 229.33,
   "end": 230.85,
   "text": "Děkuji, že jste mi to řekl."
  },
  {
   "start": 230.85,
   "end": 232.05,
   "text": "to je důležité."
  },
  {
   "start": 233.33,
   "end": 234.49,
   "text": "Myslíš, že jsem nebezpečný?"
  },
  {
   "start": 235.59,
   "end": 236.87,
   "text": "Takové vtíravé"
  },
  {
   "start": 236.87,
   "end": 238.65,
   "text": "myšlenky, jako u lidí"
  },
  {
   "start": 238.65,
   "end": 240.83,
   "text": "s tímto typem potíží, jsou velmi"
  },
  {
   "start": 240.83,
   "end": 242.73,
   "text": "časté. Hlavně, když se blíží"
  },
  {
   "start": 242.73,
   "end": 245.13,
   "text": "velká změna. Nejsou důkazem,"
  },
  {
   "start": 245.23,
   "end": 246.29,
   "text": "že byste něco udělal."
  },
  {
   "start": 246.73,
   "end": 248.59,
   "text": "Jejich síla je právě v tom, jak"
  },
  {
   "start": 248.59,
   "end": 249.51,
   "text": "vás děsí."
  },
  {
   "start": 250.71,
   "end": 252.63,
   "text": "To je pomalu. Přesto"
  },
  {
   "start": 252.63,
   "end": 254.93,
   "text": "chce čas, než tomu věřím."
  },
  {
   "start": 255.67,
   "end": 256.25,
   "text": "Rozumím."
  },
  {
   "start": 256.89,
   "end": 259.11,
   "text": "Co děláte, když se ta myšlenka"
  },
  {
   "start": 259.11,
   "end": 259.73,
   "text": "objeví?"
  },
  {
   "start": 259.73,
   "end": 264.73,
   "text": "Odejdu z místnosti. Nebo se vrátím a zkontroluji něco, aby to přestalo."
  },
  {
   "start": 264.73,
   "end": 269.73,
   "text": "Takže kontrola vám pomáhá uklidnit i tuhle?"
  },
  {
   "start": 269.73,
   "end": 273.73,
   "text": "Vlastně ano. Nikdy mě nenapadlo, že to spolu souvisí."
  },
  {
   "start": 273.73,
   "end": 275.73,
   "text": "Jak spíte?"
  },
  {
   "start": 275.73,
   "end": 281.73,
   "text": "Spím mezerně. Vstávám noce dvakrát a kontroluji zporád, i když tam něco nestojí."
  },
  {
   "start": 281.73,
   "end": 283.73,
   "text": "Pomáhá vám něco?"
  },
  {
   "start": 283.73,
   "end": 288.73,
   "text": "Pomáhá mi na procházky s Barborou, když opravdu je něco doma. U mě zaměstná."
  },
  {
   "start": 288.73,
   "end": 290.73,
   "text": "Jak často to děláte?"
  },
  {
   "start": 290.73,
   "end": 294.73,
   "text": "Procházky dvakrát, týdně, oprave, než všechno."
  },
  {
   "start": 294.73,
   "end": 299.73,
   "text": "Co by pro vás znamenalo, kdyby se to zlepšilo?"
  },
  {
   "start": 299.73,
   "end": 304.73,
   "text": "Odejít večer za pět minut a těšit se na dítě bez těch myšlenek."
  },
  {
   "start": 304.73,
   "end": 309.73,
   "text": "To jsou jasné cíle. Víte, že existuje léčba, která tomu pomáhá?"
  },
  {
   "start": 309.73,
   "end": 316.73,
   "text": "Zdržel jsem terapii, kdy se člověk postupně vystavuje tomu, čeho se bojí. Měl jsem z toho strach."
  },
  {
   "start": 316.73,
   "end": 323.73,
   "text": "Strach je pochopitelný. Šlo by si po malých krocích a vy byste o tempu rozhodoval."
  },
  {
   "start": 323.73,
   "end": 331.73,
   "text": "To je uklidňující. Myslel jsem, že mě někdo donutí nechat otevřené dveře odejít."
  },
  {
   "start": 331.73,
   "end": 337.73,
   "text": "Tak to ne. Začali bychom třeba jen tím, že zkontrolujete dveře jenom jednou, ne třikrát."
  },
  {
   "start": 337.73,
   "end": 341.73,
   "text": "To zní malé, ale to je pro mě velké."
  },
  {
   "start": 341.73,
   "end": 344.25,
   "text": "Velké kroky začínají malými."
  },
  {
   "start": 344.99,
   "end": 347.03,
   "text": "Řekl jste něco důležitého o Barboře."
  },
  {
   "start": 347.59,
   "end": 348.73,
   "text": "Chtěl byste jí..."
  },
  {
   "start": 348.73,
   "end": 350.87,
   "text": "Co byste jí chtěl říct?"
  },
  {
   "start": 351.19,
   "end": 352.41,
   "text": "Že jí miluji."
  },
  {
   "start": 352.47,
   "end": 353.67,
   "text": "A že se potřebuje dát,"
  },
  {
   "start": 353.83,
   "end": 354.95,
   "text": "abych jí nestratil."
  },
  {
   "start": 355.67,
   "end": 356.87,
   "text": "Zatím se bojím,"
  },
  {
   "start": 357.09,
   "end": 358.95,
   "text": "že by se mnou nechtěla být."
  },
  {
   "start": 360.05,
   "end": 361.55,
   "text": "Co si myslíte,"
  },
  {
   "start": 361.55,
   "end": 362.71,
   "text": "že by řekla?"
  },
  {
   "start": 363.67,
   "end": 364.93,
   "text": "Se by mě objala."
  },
  {
   "start": 365.71,
   "end": 366.79,
   "text": "Ona je taková."
  },
  {
   "start": 367.57,
   "end": 369.73,
   "text": "Pak možná stojí za to jí říct"
  },
  {
   "start": 369.73,
   "end": 370.83,
   "text": "alespoň část."
  },
  {
   "start": 371.73,
   "end": 376.49,
   "text": "Co kdyby jste jí řekl, že jste tu byl a co jste se dozvěděl?"
  },
  {
   "start": 376.93,
   "end": 379.79,
   "text": "To tak zvládne. O těch myšlenkách ještě ne."
  },
  {
   "start": 380.23,
   "end": 382.83,
   "text": "To je v pořádku. Tempo určujete vy."
  },
  {
   "start": 383.43,
   "end": 386.09,
   "text": "Děkuji. Tohle mi dalo víc, než jsem čekal."
  },
  {
   "start": 387.47,
   "end": 389.91,
   "text": "Do příště zkuste jednu věc."
  },
  {
   "start": 390.63,
   "end": 394.35,
   "text": "Když odcházíte z bytu, zkontrolujte dveře jenom jednou"
  },
  {
   "start": 394.35,
   "end": 397.53,
   "text": "a zavěšte si, jak moc vám bylo úzko."
  },
  {
   "start": 398.15,
   "end": 404.35,
   "text": "I jednou. Zkusím to. Aspoň jednou. A zapíšu číslo od jedna do desetě."
  },
  {
   "start": 405.09,
   "end": 407.97,
   "text": "Přesně tak. Pro dnešek tedy skončíme."
  },
  {
   "start": 408.63,
   "end": 410.23,
   "text": "Děkuji. Uvidíme se příští týden."
  }
 ],
 "round": "r2a"
}