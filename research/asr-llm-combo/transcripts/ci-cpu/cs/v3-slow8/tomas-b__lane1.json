{
 "engine": "v3-slow8",
 "base": "whisper-large-v3",
 "opts": {
  "ffmpeg_filter": "atempo=0.8"
 },
 "client": "tomas-b",
 "lang": "cs",
 "lane": 1,
 "audio_s": 514.4,
 "seconds": 322.5,
 "rtf": 0.627,
 "wer": 0.2131,
 "cer": 0.1025,
 "segments": [
  {
   "start": 2.16,
   "end": 6.3,
   "text": "Dobrý den, pane Bárto, pojďte dál. Jak se vám dnes daří?"
  },
  {
   "start": 6.98,
   "end": 12.26,
   "text": "Dobrý den, docela jsem nervózní, jestli mám odbít upřímně. Nikde jsem psychologa nebyl."
  },
  {
   "start": 12.98,
   "end": 16.76,
   "text": "To je naprosto v pořádku. Co vás sem přivádí?"
  },
  {
   "start": 17.64,
   "end": 22.5,
   "text": "Manželka. Říká, že už to takhle nejde. A já vlastně taky ne."
  },
  {
   "start": 23.08,
   "end": 24.16,
   "text": "Co nejde?"
  },
  {
   "start": 25.06,
   "end": 29.62,
   "text": "Představuji, že kontroluji, jestli jsem zamknul dveře a vypnul sporák."
  },
  {
   "start": 29.62,
   "end": 32.24,
   "text": "trvá mi to hodinu, než odejdu z betu."
  },
  {
   "start": 33.4,
   "end": 34.08,
   "text": "Hodinu?"
  },
  {
   "start": 34.26,
   "end": 35.44,
   "text": "Jak to vypadá?"
  },
  {
   "start": 35.94,
   "end": 38.34,
   "text": "Zamknu dveře, odejdu k výtahu,"
  },
  {
   "start": 38.78,
   "end": 40.64,
   "text": "vrátím se a zatáhnu zaklíku."
  },
  {
   "start": 41.46,
   "end": 42.84,
   "text": "Pak kontroluje sporák,"
  },
  {
   "start": 42.98,
   "end": 43.96,
   "text": "každý knop týždla."
  },
  {
   "start": 44.48,
   "end": 45.9,
   "text": "Pak zase dveře."
  },
  {
   "start": 46.84,
   "end": 48.18,
   "text": "A když to uděláte,"
  },
  {
   "start": 48.26,
   "end": 49.0,
   "text": "co se stane?"
  },
  {
   "start": 50.14,
   "end": 51.22,
   "text": "Chvíli se mi umaví."
  },
  {
   "start": 52.12,
   "end": 55.0,
   "text": "Pak se mi do hlavy přijde obraz,"
  },
  {
   "start": 55.06,
   "end": 56.74,
   "text": "že jsem to nevydala pořádně"
  },
  {
   "start": 56.74,
   "end": 58.2,
   "text": "a musím vzít."
  },
  {
   "start": 58.2,
   "end": 60.2,
   "text": "Co je to za obraz?"
  },
  {
   "start": 60.2,
   "end": 64.2,
   "text": "Bět v plamenech. Vidím to jasně jako film."
  },
  {
   "start": 64.2,
   "end": 67.2,
   "text": "Jak často se vám to stává?"
  },
  {
   "start": 67.2,
   "end": 73.2,
   "text": "Každý den. Večer je to nejhorší, když jdeme ven. Nebo spát. A ráno taky."
  },
  {
   "start": 73.2,
   "end": 76.2,
   "text": "Jak dlouho už to trvá?"
  },
  {
   "start": 76.2,
   "end": 82.2,
   "text": "Začalo to před dvěma lety, kdy jehořilou sousedu a mysle musela evakuovat."
  },
  {
   "start": 82.2,
   "end": 84.2,
   "text": "Řekněte mi o tom víc."
  },
  {
   "start": 84.2,
   "end": 93.2,
   "text": "Dva lety v noci. Parodil mě avar, na chodbě byl kůž a vyde jak křičela. Vyvělec mě na noc v pežámech."
  },
  {
   "start": 93.2,
   "end": 95.2,
   "text": "Jak vám tehdy bylo?"
  },
  {
   "start": 95.2,
   "end": 105.2,
   "text": "Že tohle je konec. Mír nebyl zraněn, ale sousedem to vyhořelo celé. Stál jsem venku v země, jak ulka, jak hoří okna."
  },
  {
   "start": 105.2,
   "end": 108.2,
   "text": "A od té doby?"
  },
  {
   "start": 108.2,
   "end": 112.2,
   "text": "V té době mám pocit, že to můžu způsobit já."
  },
  {
   "start": 112.2,
   "end": 117.2,
   "text": "Že když něco neskontroluji, tak se to stane a budu věnány."
  },
  {
   "start": 117.2,
   "end": 120.2,
   "text": "To je velká zodpovědnost."
  },
  {
   "start": 120.2,
   "end": 124.2,
   "text": "Já vím, že to nedává smysl. Znám s logikou."
  },
  {
   "start": 124.2,
   "end": 127.2,
   "text": "Přesto se to nedá vypnout."
  },
  {
   "start": 127.2,
   "end": 130.2,
   "text": "Co děláte, když to nechcete dělat?"
  },
  {
   "start": 130.2,
   "end": 132.2,
   "text": "No zkusím to nechat."
  },
  {
   "start": 132.2,
   "end": 135.2,
   "text": "Pak mi roste úzkost, až mám pocit, že se zblázním."
  },
  {
   "start": 135.2,
   "end": 137.2,
   "text": "Raději to udělám."
  },
  {
   "start": 138.2,
   "end": 140.2,
   "text": "Čím se úzkost projevuje?"
  },
  {
   "start": 141.2,
   "end": 144.2,
   "text": "Srdce po přesluzené ruce a než patnil želudku."
  },
  {
   "start": 145.2,
   "end": 147.2,
   "text": "Kdo o tom ví?"
  },
  {
   "start": 148.2,
   "end": 154.2,
   "text": "Barbara. Moje manželka. Na začátku to brala jako zvyk, teď už vidí, že je to víc."
  },
  {
   "start": 155.2,
   "end": 157.2,
   "text": "Jak na to reaguje?"
  },
  {
   "start": 158.2,
   "end": 164.2,
   "text": "Trpělivá, ale vidím, že jí to dočerpává. Včera jsme přišli na kino a o 40 minut později..."
  },
  {
   "start": 165.2,
   "end": 167.2,
   "text": "Co se stalo?"
  },
  {
   "start": 167.2,
   "end": 171.2,
   "text": "Čekala venku, než se vrátím a zkontroluji sporádku po třetí."
  },
  {
   "start": 171.2,
   "end": 175.2,
   "text": "Neřekla nic, jen se na mě podívala."
  },
  {
   "start": 175.2,
   "end": 177.2,
   "text": "Jak vám bylo?"
  },
  {
   "start": 177.2,
   "end": 181.2,
   "text": "Ano. Cítil jsem se jako dítě, který nezvládne vyjít z domu."
  },
  {
   "start": 181.2,
   "end": 184.2,
   "text": "Co děláte za práci?"
  },
  {
   "start": 184.2,
   "end": 186.2,
   "text": "Pracuji jako elektrikář v holmoce."
  },
  {
   "start": 186.2,
   "end": 189.2,
   "text": "Mám rozvody v bytech a občas v rodinných domech."
  },
  {
   "start": 189.2,
   "end": 193.2,
   "text": "Jak to souvisí s kontrolováním?"
  },
  {
   "start": 193.2,
   "end": 200.2,
   "text": "Hodně. Bojím se, že kole své hlavy jednou dám v chybu, že v pár těm příkladím vodě či něco schoří."
  },
  {
   "start": 200.2,
   "end": 203.2,
   "text": "Stalo se vám něco takového?"
  },
  {
   "start": 203.2,
   "end": 211.2,
   "text": "Ne, nikdy. Ale pokračuje tak, jak se zavracím do kontrolu. Jen když dostám vrátím druhý den, jen se podívat."
  },
  {
   "start": 211.2,
   "end": 213.2,
   "text": "A kolegové?"
  },
  {
   "start": 213.2,
   "end": 221.2,
   "text": "Myslíš si, že jsem pedant? Jeff mi říká, že jsem nejpečtojší ve firmě, ale nevědí, kolik času dostojí."
  },
  {
   "start": 221.86,
   "end": 223.58,
   "text": "Kolik času to stojí?"
  },
  {
   "start": 223.96,
   "end": 226.68,
   "text": "V poslední pětnici jsi mi dala práce o hodinu výzdaně."
  },
  {
   "start": 227.54,
   "end": 230.42,
   "text": "Už jsem pár zakázek přidal kolegovi, protože jsem to nestíhal."
  },
  {
   "start": 231.56,
   "end": 233.14,
   "text": "Co to s vámi dělá?"
  },
  {
   "start": 234.06,
   "end": 237.82,
   "text": "Mám strach, že přijdu o práce. Hlavně teď."
  },
  {
   "start": 239.1,
   "end": 240.24,
   "text": "Proč hodina teď?"
  },
  {
   "start": 241.0,
   "end": 243.34,
   "text": "Porbora děnotná ve čtvrtém měsíce."
  },
  {
   "start": 244.48,
   "end": 247.06,
   "text": "Gratuluji. Jak se to přijal?"
  },
  {
   "start": 247.06,
   "end": 249.76,
   "text": "No, jsem vtasný. Opravdu."
  },
  {
   "start": 249.76,
   "end": 254.76,
   "text": "Čekali jsme na to tři roky, hned potom přišla další myšlenka."
  },
  {
   "start": 254.76,
   "end": 255.76,
   "text": "Jaká?"
  },
  {
   "start": 255.76,
   "end": 259.76,
   "text": "Že ji a dítě tě ublížím."
  },
  {
   "start": 259.76,
   "end": 261.76,
   "text": "Ublížíte jak?"
  },
  {
   "start": 261.76,
   "end": 265.76,
   "text": "Ne, že bych chtěl. To je hrozné, nikdy bych to neudal."
  },
  {
   "start": 265.76,
   "end": 273.76,
   "text": "Ale ta myšlenka přijde, když krájím chleba na dostajím úschodu, a pak se bojím, že to bude samo."
  },
  {
   "start": 273.76,
   "end": 277.76,
   "text": "Takže je to myšlenka, která vás těsí."
  },
  {
   "start": 277.76,
   "end": 281.18,
   "text": "a mě to nejhorší,"
  },
  {
   "start": 281.58,
   "end": 282.36,
   "text": "když jsem"
  },
  {
   "start": 282.36,
   "end": 284.3,
   "text": "to nikomu neřekl,"
  },
  {
   "start": 284.56,
   "end": 285.88,
   "text": "ani Barboře."
  },
  {
   "start": 286.68,
   "end": 288.56,
   "text": "Děkuji, že jste mi to řekl,"
  },
  {
   "start": 288.76,
   "end": 290.02,
   "text": "to je důležité."
  },
  {
   "start": 291.7,
   "end": 293.08,
   "text": "Myslíte, že jsem nebezpečný?"
  },
  {
   "start": 294.54,
   "end": 297.02,
   "text": "Takové vtíravé myšlenky,"
  },
  {
   "start": 297.02,
   "end": 299.32,
   "text": "jako u lidí s tímto typem"
  },
  {
   "start": 299.32,
   "end": 301.72,
   "text": "potíží, jsou velmi časté."
  },
  {
   "start": 302.22,
   "end": 303.4,
   "text": "Hlavně, když se blíží"
  },
  {
   "start": 303.4,
   "end": 304.56,
   "text": "velká změna."
  },
  {
   "start": 304.56,
   "end": 312.56,
   "text": "Nejsou důkazem, že byste něco udělal. Jejich síla je právě v tom, jak vás děsí."
  },
  {
   "start": 312.56,
   "end": 318.56,
   "text": "To je pomalu. Přesto chce čas, než tomu věřím."
  },
  {
   "start": 318.56,
   "end": 324.56,
   "text": "Rozumím. Co děláte, když se ta myšlenka objeví?"
  },
  {
   "start": 324.56,
   "end": 331.56,
   "text": "Nejdu z místnosti. Nebo se vrátím a zkontroluji něco, aby to přestalo."
  },
  {
   "start": 331.56,
   "end": 337.56,
   "text": "Takže kontrola vám pomáhá uklidnit i tuhle?"
  },
  {
   "start": 337.56,
   "end": 341.56,
   "text": "Vlastně ano. Nikdy mě nenapadlo, že to způsobí si."
  },
  {
   "start": 341.56,
   "end": 343.56,
   "text": "Jak spíte?"
  },
  {
   "start": 343.56,
   "end": 351.56,
   "text": "Spím mezerně. Stávám noci dvakrát a kontrola je v sporádku, i když tam nic nestojí."
  },
  {
   "start": 351.56,
   "end": 353.56,
   "text": "Pomáhá vám něco?"
  },
  {
   "start": 353.56,
   "end": 360.56,
   "text": "Pomáhá mi na procházky s Barborou, když je právě něco doma. U mě zaměstná."
  },
  {
   "start": 360.56,
   "end": 362.56,
   "text": "Jak často to děláte?"
  },
  {
   "start": 362.56,
   "end": 368.56,
   "text": "Procházky dvakrát, díně, opravy, no, než něco."
  },
  {
   "start": 368.56,
   "end": 374.1,
   "text": "Co by pro vás znamenalo, kdyby se to zlepšilo?"
  },
  {
   "start": 374.1,
   "end": 380.1,
   "text": "Odejít bez důzla 5 minut a těšit se na dítě bez těch myšlenek."
  },
  {
   "start": 380.1,
   "end": 387.1,
   "text": "To jsou jasné cíle. Víte, že existuje léčba, která tomu pomáhá?"
  },
  {
   "start": 387.1,
   "end": 395.1,
   "text": "Zložil jsem terapii, když se měl postupně vystavovat tomu, čemu se bojí. Měl jsem z toho strach."
  },
  {
   "start": 395.1,
   "end": 403.1,
   "text": "Strach je pochopitelný. Šlo by si po malých krocích, abyste o tempu rozhodoval."
  },
  {
   "start": 403.1,
   "end": 413.1,
   "text": "To je uklidňující. Myslel jsem, že mě někdo domů ti necháte otevřené dveře odejít."
  },
  {
   "start": 413.1,
   "end": 413.88,
   "text": "odejít."
  },
  {
   "start": 414.66,
   "end": 415.62,
   "text": "Tak to ne."
  },
  {
   "start": 416.4,
   "end": 418.46,
   "text": "Začal bych vám třeba jen tím,"
  },
  {
   "start": 418.92,
   "end": 421.08,
   "text": "že zkontrolujete dveře jenom jednou."
  },
  {
   "start": 422.64,
   "end": 423.64,
   "text": "To zní malé."
  },
  {
   "start": 424.16,
   "end": 426.42,
   "text": "Malé, to je pro mě velké."
  },
  {
   "start": 427.26,
   "end": 428.58,
   "text": "Velké kroky"
  },
  {
   "start": 428.58,
   "end": 430.28,
   "text": "začínají malými."
  },
  {
   "start": 431.2,
   "end": 432.34,
   "text": "Řekl jste něco důležitého"
  },
  {
   "start": 432.9,
   "end": 433.76,
   "text": "o Barboře."
  },
  {
   "start": 434.48,
   "end": 435.92,
   "text": "Chtěl byste jí..."
  },
  {
   "start": 435.92,
   "end": 438.56,
   "text": "Co byste jí chtěl říct?"
  },
  {
   "start": 438.96,
   "end": 440.52,
   "text": "Že je můj."
  },
  {
   "start": 440.52,
   "end": 442.04,
   "text": "A že se potřeboval,"
  },
  {
   "start": 442.16,
   "end": 443.72,
   "text": "že zaběh jí nestatil."
  },
  {
   "start": 444.34,
   "end": 448.68,
   "text": "Zatím se bojím, že by se mnou nechtěla být."
  },
  {
   "start": 448.68,
   "end": 453.12,
   "text": "Co si myslíte, že by řekla?"
  },
  {
   "start": 453.12,
   "end": 458.88,
   "text": "Se by mě objala. Ona je taková."
  },
  {
   "start": 458.88,
   "end": 463.62,
   "text": "Pak možná stojí za to jí říct alespoň část."
  },
  {
   "start": 463.62,
   "end": 470.62,
   "text": "Co kdybyste jí řekl, že jste tu byl a co jste se dozvěděl?"
  },
  {
   "start": 470.62,
   "end": 474.88,
   "text": "Tak zvládnout. O těch myšlenkách ještě ne."
  },
  {
   "start": 474.88,
   "end": 478.52,
   "text": "To je v pořádku. Tempo určujete vy."
  },
  {
   "start": 479.28,
   "end": 482.58,
   "text": "Děkuju. Tohle mi dalo víc, než jsem čekal."
  },
  {
   "start": 484.32,
   "end": 487.36,
   "text": "Do příště zkuste jednu věc."
  },
  {
   "start": 488.28,
   "end": 492.92,
   "text": "Když odcházíte z bytu, zkontrolujte dveře jenom jednou"
  },
  {
   "start": 492.92,
   "end": 496.9,
   "text": "a zapište si, jak moc vám bylo úzko."
  },
  {
   "start": 497.9,
   "end": 502.3,
   "text": "Jednou. Zkusím to. Aspoň jednou."
  },
  {
   "start": 502.3,
   "end": 505.36,
   "text": "a zapíšu číslo od jedna do deseti."
  },
  {
   "start": 506.48,
   "end": 507.62,
   "text": "Přesně tak."
  },
  {
   "start": 508.04,
   "end": 509.96,
   "text": "Pro dnešek tedy skončíme."
  },
  {
   "start": 510.8,
   "end": 511.18,
   "text": "Děkuji."
  },
  {
   "start": 511.56,
   "end": 512.8,
   "text": "Budíme se příští týdne."
  }
 ],
 "round": "r3a"
}