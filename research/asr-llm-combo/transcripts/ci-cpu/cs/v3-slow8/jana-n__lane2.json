{
 "engine": "v3-slow8",
 "base": "whisper-large-v3",
 "opts": {
  "ffmpeg_filter": "atempo=0.8"
 },
 "client": "jana-n",
 "lang": "cs",
 "lane": 2,
 "audio_s": 480.6,
 "seconds": 259.4,
 "rtf": 0.54,
 "wer": 0.1839,
 "cer": 0.1097,
 "segments": [
  {
   "start": 0.46,
   "end": 2.82,
   "text": "Dobrý den paní Láková, pekno."
  },
  {
   "start": 3.58,
   "end": 5.98,
   "text": "S čím byste dnes chtěla začít?"
  },
  {
   "start": 7.02,
   "end": 8.56,
   "text": "Dobrý den, já ani nevím."
  },
  {
   "start": 8.84,
   "end": 12.7,
   "text": "Mám pocit, že mi někdo vytáhl koberec pod nohou."
  },
  {
   "start": 13.12,
   "end": 13.68,
   "text": "Co se stalo?"
  },
  {
   "start": 14.62,
   "end": 20.82,
   "text": "Po patnácti letech manželství jsme se s manželem Radkem rozhodli pro rozvod."
  },
  {
   "start": 20.98,
   "end": 23.06,
   "text": "A já to pořád nemohu pochopit."
  },
  {
   "start": 23.72,
   "end": 24.64,
   "text": "Řekněte mi víc."
  },
  {
   "start": 25.34,
   "end": 28.02,
   "text": "Ještě v letě jsme byli nedovolené v Chorvatsku."
  },
  {
   "start": 28.02,
   "end": 29.94,
   "text": "a všechno vypadalo normálně"
  },
  {
   "start": 29.94,
   "end": 31.52,
   "text": "a v září mi řekl,"
  },
  {
   "start": 31.6,
   "end": 33.26,
   "text": "že už to takhle dál nejde."
  },
  {
   "start": 34.56,
   "end": 35.52,
   "text": "A jak jste to přijalo?"
  },
  {
   "start": 36.0,
   "end": 37.18,
   "text": "Síděla jsem v kuchyně,"
  },
  {
   "start": 37.26,
   "end": 38.74,
   "text": "nemohla jsem nic říct."
  },
  {
   "start": 38.9,
   "end": 40.64,
   "text": "Pak jsem šla uklidit nádobí,"
  },
  {
   "start": 40.74,
   "end": 42.04,
   "text": "jako by se nic nedělo."
  },
  {
   "start": 42.66,
   "end": 44.5,
   "text": "A co sedlo uvnitř vás?"
  },
  {
   "start": 45.94,
   "end": 47.84,
   "text": "Prázdno, pak zlost,"
  },
  {
   "start": 47.98,
   "end": 49.6,
   "text": "pak zase prázdnost."
  },
  {
   "start": 49.86,
   "end": 51.7,
   "text": "Třidáctu několikrát děně."
  },
  {
   "start": 52.62,
   "end": 54.12,
   "text": "Vysvětlil vám, Radek, proč?"
  },
  {
   "start": 55.22,
   "end": 57.12,
   "text": "Říká, že jsme se vzdáleli,"
  },
  {
   "start": 57.12,
   "end": 58.94,
   "text": "že žijeme vedle sebe."
  },
  {
   "start": 59.26,
   "end": 60.62,
   "text": "Já si toho nevšimla,"
  },
  {
   "start": 60.72,
   "end": 63.2,
   "text": "nebo jsem si všimnout nechtěla."
  },
  {
   "start": 64.52,
   "end": 66.22,
   "text": "Co se o tom myslíte teď?"
  },
  {
   "start": 67.56,
   "end": 69.94,
   "text": "Že jsem to měla vidět,"
  },
  {
   "start": 70.02,
   "end": 71.08,
   "text": "že jsem slepá."
  },
  {
   "start": 71.54,
   "end": 73.22,
   "text": "Pořád se v hlavě vracím"
  },
  {
   "start": 73.22,
   "end": 75.3,
   "text": "a hledám, kde jsem udělala chybu."
  },
  {
   "start": 75.98,
   "end": 76.5,
   "text": "A našla jsi?"
  },
  {
   "start": 77.16,
   "end": 77.4,
   "text": "Ne."
  },
  {
   "start": 78.42,
   "end": 80.66,
   "text": "Jednou si myslím, že jsem byla moc unavená,"
  },
  {
   "start": 80.78,
   "end": 82.42,
   "text": "nezajímala jsem se o něj."
  },
  {
   "start": 82.54,
   "end": 86.08,
   "text": "Jindy zase, že jsem se starala moc."
  },
  {
   "start": 87.5,
   "end": 90.62,
   "text": "Vypadá to, že se v tom hodně trápíte."
  },
  {
   "start": 91.14,
   "end": 93.52,
   "text": "Ano, hlavně kvůli dětem."
  },
  {
   "start": 94.04,
   "end": 95.02,
   "text": "Pověďte mi o nich."
  },
  {
   "start": 96.02,
   "end": 101.92,
   "text": "Mám dvě děti, Aničce 12 a Matějevi 8 let a nevím, jak jim to říct."
  },
  {
   "start": 102.06,
   "end": 103.2,
   "text": "Ještě jste jim to neřekla?"
  },
  {
   "start": 103.2,
   "end": 108.66,
   "text": "Ne, Radek chce, abychom to řekli společně, ale pořád to odkládáme."
  },
  {
   "start": 109.48,
   "end": 111.22,
   "text": "Anička už něco tuší."
  },
  {
   "start": 111.52,
   "end": 112.32,
   "text": "Co on to říkal?"
  },
  {
   "start": 112.32,
   "end": 117.36,
   "text": "Minulý týden se mě zeptala, jestli se s tátou hádáme"
  },
  {
   "start": 117.36,
   "end": 121.66,
   "text": "Řekla jsem, že ne, či cítila jsem se hrozně"
  },
  {
   "start": 121.66,
   "end": 126.81,
   "text": "Proč hrozně?"
  },
  {
   "start": 128.31,
   "end": 133.49,
   "text": "Protože jsem lhala a ona to poznala, viděla jsem jí to na očích"
  },
  {
   "start": 133.49,
   "end": 135.13,
   "text": "Co se vám mohlo hlavou?"
  },
  {
   "start": 135.83,
   "end": 138.61,
   "text": "Že ji ničím život, že ji vezmu domov"
  },
  {
   "start": 138.61,
   "end": 142.27,
   "text": "Jak by se vám dařilo, že cítí pravdu?"
  },
  {
   "start": 143.27,
   "end": 147.25,
   "text": "Nejraději bych to měla za sebou, ale bojím se jejich slz."
  },
  {
   "start": 147.51,
   "end": 150.63,
   "text": "A Matěj je ještě malý, ten moc nic nechápe."
  },
  {
   "start": 151.21,
   "end": 152.51,
   "text": "Co byste mu chtěla předat?"
  },
  {
   "start": 153.33,
   "end": 156.75,
   "text": "Že ho máme oba rádi a že se to nezmění."
  },
  {
   "start": 156.75,
   "end": 160.49,
   "text": "Jenže já vím, nevím, jestli je to pravda,"
  },
  {
   "start": 161.19,
   "end": 163.51,
   "text": "když sama nevím, jak to bude vypadat."
  },
  {
   "start": 164.43,
   "end": 165.81,
   "text": "Jak to bude vypadat s bydlením?"
  },
  {
   "start": 166.47,
   "end": 170.97,
   "text": "Byd je na hypotéku, Radek se asi odstihuje k bratrovi,"
  },
  {
   "start": 170.97,
   "end": 174.19,
   "text": "alespoň zatím, dítě zůstanou se mnou."
  },
  {
   "start": 174.83,
   "end": 175.93,
   "text": "Jak se vám z toho dělá?"
  },
  {
   "start": 176.15,
   "end": 178.61,
   "text": "Mám strach, že to sama nezvládnu."
  },
  {
   "start": 179.15,
   "end": 181.13,
   "text": "Radek by vždycky řešil peníze."
  },
  {
   "start": 181.75,
   "end": 183.09,
   "text": "Co děláte ve všedních dnech?"
  },
  {
   "start": 183.81,
   "end": 187.63,
   "text": "Pracuji jako učitelka češtiny na základní škole v Brně."
  },
  {
   "start": 187.87,
   "end": 190.25,
   "text": "Učím devítky a osmičky."
  },
  {
   "start": 191.21,
   "end": 192.73,
   "text": "Jak se vám teď učí?"
  },
  {
   "start": 193.87,
   "end": 196.57,
   "text": "Do třídy chodím s kredlíkem v krku."
  },
  {
   "start": 196.57,
   "end": 200.51,
   "text": "Mám pocit, že všichni vidí, že se mi rozpadá život."
  },
  {
   "start": 200.97,
   "end": 205.5,
   "text": "Ví o tom někde ve škole?"
  },
  {
   "start": 206.44,
   "end": 213.46,
   "text": "Jen ředitelka. Řekla jsem jí to, protože jsem se jednou rozplakala na chodbě. Byla hodná."
  },
  {
   "start": 214.16,
   "end": 214.94,
   "text": "Co vám pomohlo?"
  },
  {
   "start": 217.08,
   "end": 224.22,
   "text": "Že mě nechala odejít dřív. Dala mi hodinu volné. Jenže pak jsem seděla doma a bylo to horší."
  },
  {
   "start": 224.84,
   "end": 226.68,
   "text": "Horší. Proč?"
  },
  {
   "start": 227.68,
   "end": 232.32,
   "text": "Protože jsem byla sama za hlavou. V práci jsem měla aspoň co dělat."
  },
  {
   "start": 232.32,
   "end": 262.3,
   "text": "Jak spíte?"
  },
  {
   "start": 262.32,
   "end": 265.02,
   "text": "Jsem unavená už ráno."
  },
  {
   "start": 265.94,
   "end": 267.38,
   "text": "Jíte? Hýbáte se?"
  },
  {
   "start": 268.46,
   "end": 274.5,
   "text": "Jím málo. Zubla jsem čtyřikyla. Kamarádka mi říká, že vpadám hrozně."
  },
  {
   "start": 275.72,
   "end": 277.94,
   "text": "Máte kolem sebe někoho, s kým můžete mluvit?"
  },
  {
   "start": 278.28,
   "end": 286.24,
   "text": "Mám sestru Alanu v Olomouci. Zavolá mi skoro každý večer. A kamarádku Evu z práce."
  },
  {
   "start": 286.6,
   "end": 287.36,
   "text": "Co jim říkáte?"
  },
  {
   "start": 288.36,
   "end": 289.96,
   "text": "Ale cestuji skoro všechno."
  },
  {
   "start": 290.16,
   "end": 292.62,
   "text": "A vím to, že mám těžké období."
  },
  {
   "start": 293.24,
   "end": 295.3,
   "text": "Nechci, aby se o mě něco myslela."
  },
  {
   "start": 295.9,
   "end": 297.5,
   "text": "Co se obháváte, že si myslíš?"
  },
  {
   "start": 298.52,
   "end": 299.88,
   "text": "Že jsem se lhala."
  },
  {
   "start": 300.14,
   "end": 304.88,
   "text": "Že žena, která nedokážu udržet manželství, není pro děti dobrý příklad."
  },
  {
   "start": 306.14,
   "end": 308.82,
   "text": "To je těžká myšlenka."
  },
  {
   "start": 309.88,
   "end": 310.62,
   "text": "Odkud se bere?"
  },
  {
   "start": 311.36,
   "end": 312.72,
   "text": "Asi od mojí mámy."
  },
  {
   "start": 312.72,
   "end": 317.4,
   "text": "Tak vždycky říkala, že manželství se drží a děto jak chce."
  },
  {
   "start": 318.82,
   "end": 321.32,
   "text": "Co řekla, když se jí to oznámila?"
  },
  {
   "start": 321.84,
   "end": 322.5,
   "text": "Močela."
  },
  {
   "start": 323.68,
   "end": 327.68,
   "text": "Pak řekla, že doufá, že jí jsem to dobře zvážela."
  },
  {
   "start": 328.46,
   "end": 330.6,
   "text": "Už se od té doby moc neozvala."
  },
  {
   "start": 332.44,
   "end": 333.04,
   "text": "Jak mám to?"
  },
  {
   "start": 333.9,
   "end": 334.66,
   "text": "Smutná."
  },
  {
   "start": 335.66,
   "end": 338.16,
   "text": "Potřebovala bych, aby mě oloběla."
  },
  {
   "start": 339.12,
   "end": 340.6,
   "text": "Co byste jí chtěla říct?"
  },
  {
   "start": 341.26,
   "end": 346.42,
   "text": "Že to bolí, že nechci být sama, jenže u nás se to nedělá."
  },
  {
   "start": 347.82,
   "end": 349.7,
   "text": "Co se děje, když to říkáte na hlas?"
  },
  {
   "start": 350.82,
   "end": 353.44,
   "text": "Pláču a omlouvám se."
  },
  {
   "start": 355.24,
   "end": 358.72,
   "text": "Není za co. Vezměte si čas."
  },
  {
   "start": 360.94,
   "end": 364.32,
   "text": "Děkuji. Ještě jsem nikomu tohle neřekla."
  },
  {
   "start": 364.32,
   "end": 371.34,
   "text": "To s vámi dělá, že jste to tady řekla."
  },
  {
   "start": 374.47,
   "end": 375.85,
   "text": "Je zvláštní"
  },
  {
   "start": 375.85,
   "end": 377.53,
   "text": "sedět tady a říkat"
  },
  {
   "start": 377.53,
   "end": 379.13,
   "text": "to všechno nahlas,"
  },
  {
   "start": 379.29,
   "end": 380.87,
   "text": "ale trochu to pomáhá."
  },
  {
   "start": 382.74,
   "end": 384.58,
   "text": "Co by vám teď mohlo pomoct nejvíc?"
  },
  {
   "start": 386.42,
   "end": 387.14,
   "text": "Spát."
  },
  {
   "start": 387.52,
   "end": 389.56,
   "text": "A vidět, jak to říct dětem."
  },
  {
   "start": 391.4,
   "end": 392.44,
   "text": "Tak my na to postupně."
  },
  {
   "start": 393.52,
   "end": 395.6,
   "text": "Co spánek?"
  },
  {
   "start": 396.02,
   "end": 396.88,
   "text": "Zkoušela jste něco?"
  },
  {
   "start": 398.68,
   "end": 399.86,
   "text": "Hrvánkový čaj."
  },
  {
   "start": 399.86,
   "end": 401.12,
   "text": "A to je všechno."
  },
  {
   "start": 401.22,
   "end": 403.16,
   "text": "Doktorka mi nepídla prášky,"
  },
  {
   "start": 403.44,
   "end": 404.74,
   "text": "ale nechci."
  },
  {
   "start": 404.9,
   "end": 405.6,
   "text": "Proč nechcete?"
  },
  {
   "start": 406.5,
   "end": 412.96,
   "text": "Bojím se, že bych se nemohla včas vzbudit pro děti a nechci být závislá."
  },
  {
   "start": 413.86,
   "end": 415.1,
   "text": "To je rozumné."
  },
  {
   "start": 416.14,
   "end": 421.96,
   "text": "Zkusíte tuhle noc něco malého, třeba sedle postele, nechat papíra napsat, co vás budí?"
  },
  {
   "start": 423.14,
   "end": 426.12,
   "text": "Mohla bych, ale spíš to dostanu z hlavy."
  },
  {
   "start": 427.58,
   "end": 428.84,
   "text": "A dětem?"
  },
  {
   "start": 430.16,
   "end": 431.28,
   "text": "Čeho se nejvíc bojíte?"
  },
  {
   "start": 431.28,
   "end": 437.78,
   "text": "Že s panikařím rozpláču se, že nezvládnu zůstat klidná."
  },
  {
   "start": 438.62,
   "end": 439.6,
   "text": "Tak kdo by to nevadilo?"
  },
  {
   "start": 440.3,
   "end": 445.96,
   "text": "Že bych plakala před dětmi? Vždyť to by pro ně bylo děsivé."
  },
  {
   "start": 447.1,
   "end": 452.72,
   "text": "Nebo by mohly vidět, že smutek je dovolený."
  },
  {
   "start": 454.24,
   "end": 460.24,
   "text": "To mě nenapadlo. Anička je citlivá, možná by jí to pomohlo."
  },
  {
   "start": 461.28,
   "end": 466.28,
   "text": "Můžeme se příště podívat, jak to připravit."
  },
  {
   "start": 466.28,
   "end": 469.28,
   "text": "Co dnes sete z dneška?"
  },
  {
   "start": 469.28,
   "end": 473.28,
   "text": "Že nejsem sama a že to nemusím zvládnout hned."
  },
  {
   "start": 473.28,
   "end": 475.28,
   "text": "Přesně to."
  },
  {
   "start": 475.28,
   "end": 477.28,
   "text": "Pro dnešek tedy skončíme."
  },
  {
   "start": 477.28,
   "end": 480.28,
   "text": "Děkuji. Uvidíme se příští týden."
  }
 ],
 "round": "r3a"
}