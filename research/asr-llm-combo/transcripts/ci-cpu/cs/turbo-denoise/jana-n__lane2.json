{
 "engine": "turbo-denoise",
 "base": "whisper-large-v3-turbo",
 "opts": {
  "ffmpeg_filter": "highpass=f=70,afftdn=nf=-30"
 },
 "client": "jana-n",
 "lang": "cs",
 "lane": 2,
 "audio_s": 384.5,
 "seconds": 115.4,
 "rtf": 0.3,
 "wer": 0.1449,
 "cer": 0.0585,
 "segments": [
  {
   "start": 0.93,
   "end": 2.35,
   "text": "Dobrý den, paní Novákova Petra."
  },
  {
   "start": 2.99,
   "end": 4.81,
   "text": "S čím byste dnes chtěla začít?"
  },
  {
   "start": 5.65,
   "end": 6.87,
   "text": "Dobrý den, já ani nevím."
  },
  {
   "start": 7.09,
   "end": 8.53,
   "text": "Mám pocit, že mi někdo vytáhl"
  },
  {
   "start": 8.53,
   "end": 10.21,
   "text": "koverec pod nohou."
  },
  {
   "start": 10.53,
   "end": 10.99,
   "text": "Co se stalo?"
  },
  {
   "start": 11.71,
   "end": 14.27,
   "text": "Po patnácti letech mančelství jsme se s mančelem"
  },
  {
   "start": 14.27,
   "end": 16.69,
   "text": "Radkem rozhodli pro rozvod."
  },
  {
   "start": 16.83,
   "end": 18.47,
   "text": "A já to pořád nemohu pochopit."
  },
  {
   "start": 19.01,
   "end": 19.75,
   "text": "Řekněte mi víc."
  },
  {
   "start": 20.31,
   "end": 22.45,
   "text": "Ještě v letě jsme byli na dovolené v Horvatsku."
  },
  {
   "start": 22.57,
   "end": 24.01,
   "text": "Všechno vypadalo normálně."
  },
  {
   "start": 24.19,
   "end": 26.61,
   "text": "A v září mi řekl, že už to takhle dál nejde."
  },
  {
   "start": 27.65,
   "end": 28.43,
   "text": "A jak jste to přijalo?"
  },
  {
   "start": 28.89,
   "end": 30.97,
   "text": "Síděla jsem v kuchně, nemohla jsem nic říct."
  },
  {
   "start": 31.15,
   "end": 32.53,
   "text": "Pak jsem šla uklidit nádobí,"
  },
  {
   "start": 32.63,
   "end": 33.65,
   "text": "jako by se nic nedělo."
  },
  {
   "start": 34.17,
   "end": 35.63,
   "text": "A co se dalo u něč vás?"
  },
  {
   "start": 36.77,
   "end": 38.29,
   "text": "Prázdno. Pak zlost."
  },
  {
   "start": 38.41,
   "end": 39.71,
   "text": "Pak zase prázdnost."
  },
  {
   "start": 39.71,
   "end": 41.45,
   "text": "Střída se to několikrát věně."
  },
  {
   "start": 42.11,
   "end": 43.35,
   "text": "Vysvětlil vám, Radek, proč?"
  },
  {
   "start": 44.21,
   "end": 45.73,
   "text": "Říká, že jsme se vzdáleli,"
  },
  {
   "start": 45.89,
   "end": 47.21,
   "text": "že žijeme vedle sebe."
  },
  {
   "start": 47.43,
   "end": 50.59,
   "text": "Já si toho nevšimla, nebo jsem si všimnout nechtěla."
  },
  {
   "start": 51.67,
   "end": 53.01,
   "text": "Co se o tom myslíte teď?"
  },
  {
   "start": 54.11,
   "end": 55.99,
   "text": "Že jsem to měla vidět,"
  },
  {
   "start": 56.05,
   "end": 56.89,
   "text": "že jsem slepá."
  },
  {
   "start": 56.89,
   "end": 60.31,
   "text": "pořád se v hlavě vracím a hledám, kde jsem udělala chybu."
  },
  {
   "start": 60.81,
   "end": 61.41,
   "text": "A našla s tým?"
  },
  {
   "start": 61.77,
   "end": 65.97,
   "text": "Ne. Jednou si myslím, že jsem byla moc unavená, nezajímala jsem se o něj."
  },
  {
   "start": 66.07,
   "end": 68.91,
   "text": "Jen když zase, že jsem se starala moc."
  },
  {
   "start": 70.05,
   "end": 72.53,
   "text": "Vypadá to, že se v tom hodině trápíte."
  },
  {
   "start": 72.95,
   "end": 74.85,
   "text": "Ano, hlavně kvůli dětem."
  },
  {
   "start": 75.27,
   "end": 76.05,
   "text": "Vy jdeme o nich?"
  },
  {
   "start": 76.79,
   "end": 81.45,
   "text": "Mám dvě děti, Aničce 12 a Matějovi 8 let a nevím, jak jim to říct."
  },
  {
   "start": 81.71,
   "end": 82.57,
   "text": "Ještě jste jim to neřekl?"
  },
  {
   "start": 82.57,
   "end": 86.95,
   "text": "Ne, Radek chce, abychom to řekli společně, ale pořád to obkládáme."
  },
  {
   "start": 87.63,
   "end": 89.03,
   "text": "Anička už něco tuší."
  },
  {
   "start": 89.25,
   "end": 89.89,
   "text": "Co vám to říká?"
  },
  {
   "start": 90.93,
   "end": 93.93,
   "text": "Minulý týden se mě zeptala, jestli se s tátou hádáme."
  },
  {
   "start": 94.05,
   "end": 97.31,
   "text": "Řekla jsem, že ne. Cítila jsem se hrozně."
  },
  {
   "start": 100.42,
   "end": 101.44,
   "text": "Proč hrozně?"
  },
  {
   "start": 102.64,
   "end": 105.2,
   "text": "Protože jsem mu lhala a ona to poznala."
  },
  {
   "start": 105.36,
   "end": 106.78,
   "text": "Viděla jsem jí to na očích."
  },
  {
   "start": 107.16,
   "end": 108.12,
   "text": "Co se vám mojilo hlavou?"
  },
  {
   "start": 108.66,
   "end": 110.74,
   "text": "Že ji ničím život, že ji vezmou doma."
  },
  {
   "start": 111.88,
   "end": 113.82,
   "text": "Jak by se vám dařilo říct jí pravdu?"
  },
  {
   "start": 114.66,
   "end": 117.82,
   "text": "Nejraději bych to měla za sebou, ale bojím se jejich slz."
  },
  {
   "start": 118.02,
   "end": 120.54,
   "text": "A Matě je ještě malý, ten moc nic nechápe."
  },
  {
   "start": 120.98,
   "end": 122.02,
   "text": "Co byste mu chtěla přidat?"
  },
  {
   "start": 122.72,
   "end": 125.44,
   "text": "Že ho máme oba rádi a že se to nezmíní."
  },
  {
   "start": 125.64,
   "end": 128.42,
   "text": "Jenže já vím, nevím jestli je to pravda."
  },
  {
   "start": 128.96,
   "end": 130.82,
   "text": "Když sama nevím, jak to bude vypadat."
  },
  {
   "start": 131.58,
   "end": 132.66,
   "text": "Jak to bude vypadat s bydlením?"
  },
  {
   "start": 133.26,
   "end": 136.8,
   "text": "Byd je na hypotéku. Radek se asi odstěhuje k bratrovi,"
  },
  {
   "start": 136.88,
   "end": 139.36,
   "text": "alespoň se tím. Děti zůstanou se mnou."
  },
  {
   "start": 139.9,
   "end": 140.72,
   "text": "Jak se vám stále děla?"
  },
  {
   "start": 140.72,
   "end": 142.92,
   "text": "Mám strach, že to sama nezvládnu."
  },
  {
   "start": 143.34,
   "end": 144.94,
   "text": "Radek vždycky řešil peníze."
  },
  {
   "start": 145.44,
   "end": 146.48,
   "text": "Co dál se ve všech dních dnech?"
  },
  {
   "start": 147.06,
   "end": 150.14,
   "text": "Pracuji jako učitelka češtiny na základní škole v Brně."
  },
  {
   "start": 150.32,
   "end": 152.22,
   "text": "Učím devítky a osmičky."
  },
  {
   "start": 153.0,
   "end": 154.18,
   "text": "Jak se vám teď učí?"
  },
  {
   "start": 155.46,
   "end": 157.28,
   "text": "Do třídy chodím s knelíkem v krku."
  },
  {
   "start": 157.44,
   "end": 160.44,
   "text": "Mám pocit, že všichni vidí, že se mi rozpadá život."
  },
  {
   "start": 162.6,
   "end": 164.4,
   "text": "Vidí o tom někdo ve škole?"
  },
  {
   "start": 165.2,
   "end": 167.18,
   "text": "Jen ředitelka. Řekla jsem jí to,"
  },
  {
   "start": 167.18,
   "end": 169.92,
   "text": "protože jsem se jednou rozplakala na chodbě."
  },
  {
   "start": 170.02,
   "end": 170.76,
   "text": "Byla chodbá."
  },
  {
   "start": 171.3,
   "end": 172.0,
   "text": "Co vám pomohlo?"
  },
  {
   "start": 172.92,
   "end": 179.42,
   "text": "Že mě nechala odejít dřív, dala mi hodinu volna, jenže pak jsem seděla doma a bylo to horší."
  },
  {
   "start": 179.92,
   "end": 181.38,
   "text": "Horší? Proč?"
  },
  {
   "start": 182.18,
   "end": 185.88,
   "text": "Protože jsem byla sama za hlavou, v práci jsem měla aspoň co dělat."
  },
  {
   "start": 187.08,
   "end": 187.94,
   "text": "Jak spíte?"
  },
  {
   "start": 188.86,
   "end": 193.4,
   "text": "Špatně. Každou noc se budím ve tři hodiny ráno a přemýšlím, co bude dál."
  },
  {
   "start": 194.04,
   "end": 195.64,
   "text": "Co se říkáte, když se probudíte?"
  },
  {
   "start": 195.64,
   "end": 199.84,
   "text": "Že nemám hypotéku, nemám manžela, nemám nic."
  },
  {
   "start": 200.04,
   "end": 203.64,
   "text": "Pak spočítám peníze, pak si představím, jak to řeknu dětem."
  },
  {
   "start": 204.36,
   "end": 205.4,
   "text": "Točí se to dokola."
  },
  {
   "start": 205.82,
   "end": 206.16,
   "text": "A pak?"
  },
  {
   "start": 207.34,
   "end": 210.0,
   "text": "Kolem páté usnu a v půl sedmé vstávám."
  },
  {
   "start": 210.38,
   "end": 212.04,
   "text": "Jsem unavená už ráno."
  },
  {
   "start": 212.78,
   "end": 213.92,
   "text": "Jíte? Hýbete se?"
  },
  {
   "start": 214.92,
   "end": 217.28,
   "text": "Jím málo. Zubla jsem čtyři kilo."
  },
  {
   "start": 217.48,
   "end": 219.62,
   "text": "Kamarádka mi říká, že vypadám hrozně."
  },
  {
   "start": 220.6,
   "end": 222.48,
   "text": "Máte kolem sebe někdo, s kým můžete mluvit?"
  },
  {
   "start": 222.98,
   "end": 224.74,
   "text": "Mám sestru Alanu v Olmouci."
  },
  {
   "start": 225.36,
   "end": 227.24,
   "text": "Zavoláme skoro každý večer."
  },
  {
   "start": 227.36,
   "end": 229.02,
   "text": "A kamarádku Evu z práce."
  },
  {
   "start": 229.28,
   "end": 229.9,
   "text": "Co jim říkáte?"
  },
  {
   "start": 230.72,
   "end": 231.98,
   "text": "Alence skoro všechno."
  },
  {
   "start": 232.14,
   "end": 234.12,
   "text": "Evěn to, že mám těžké období."
  },
  {
   "start": 234.62,
   "end": 236.24,
   "text": "Nechci, aby se o mě něco myslela."
  },
  {
   "start": 236.76,
   "end": 237.94,
   "text": "Co se obávat, že si myslí?"
  },
  {
   "start": 238.86,
   "end": 239.92,
   "text": "Že jsem se lhala."
  },
  {
   "start": 240.14,
   "end": 242.34,
   "text": "Že žena, která nedokážou držet manželství,"
  },
  {
   "start": 242.42,
   "end": 243.92,
   "text": "není pro děti dobrý příklad."
  },
  {
   "start": 244.92,
   "end": 247.08,
   "text": "To je těžká myšlenka."
  },
  {
   "start": 247.94,
   "end": 248.52,
   "text": "Odkud se bere?"
  },
  {
   "start": 249.14,
   "end": 250.22,
   "text": "Asi od mojí mámy."
  },
  {
   "start": 250.22,
   "end": 253.94,
   "text": "tak vždycky říkal, že manželství se drží, ať je to jak chce."
  },
  {
   "start": 255.1,
   "end": 257.08,
   "text": "Co řekla, když jste jí to oznámila?"
  },
  {
   "start": 257.5,
   "end": 258.06,
   "text": "Mlčela."
  },
  {
   "start": 258.96,
   "end": 262.18,
   "text": "Pak řekla, že doufá, že jsem to dobře zvážela."
  },
  {
   "start": 262.8,
   "end": 264.52,
   "text": "Už se od té doby moc neozvala."
  },
  {
   "start": 265.98,
   "end": 266.56,
   "text": "Jak vám to je?"
  },
  {
   "start": 267.18,
   "end": 267.7,
   "text": "Smutno."
  },
  {
   "start": 268.54,
   "end": 270.56,
   "text": "Potřebovala bych, aby mě olběla."
  },
  {
   "start": 271.48,
   "end": 272.48,
   "text": "Co byste jítla říct?"
  },
  {
   "start": 273.0,
   "end": 277.14,
   "text": "Že to bolí, že nechci být sama, jenže u nás se to nedělá."
  },
  {
   "start": 277.84,
   "end": 279.78,
   "text": "Co se dělá, když to říkáte nahlas?"
  },
  {
   "start": 280.22,
   "end": 282.78,
   "text": "Pláču a omlouvám se."
  },
  {
   "start": 284.18,
   "end": 285.32,
   "text": "Nyní za co."
  },
  {
   "start": 286.18,
   "end": 287.0,
   "text": "Vezměte si čas."
  },
  {
   "start": 288.72,
   "end": 289.32,
   "text": "Děkuji."
  },
  {
   "start": 289.58,
   "end": 291.5,
   "text": "Ještě jsem nikomu tohle neřekla."
  },
  {
   "start": 293.69,
   "end": 294.75,
   "text": "Co s vámi dělá,"
  },
  {
   "start": 295.25,
   "end": 297.07,
   "text": "že jste to tady řekla?"
  },
  {
   "start": 299.58,
   "end": 300.7,
   "text": "Je zvláštní"
  },
  {
   "start": 300.7,
   "end": 302.84,
   "text": "sedět tady a říkat to všechno"
  },
  {
   "start": 302.84,
   "end": 304.7,
   "text": "na hlas, ale trochu to pomáhá."
  },
  {
   "start": 306.14,
   "end": 306.74,
   "text": "Co by vám teď"
  },
  {
   "start": 306.74,
   "end": 307.68,
   "text": "mohlo pomoct nejvíc?"
  },
  {
   "start": 309.14,
   "end": 309.74,
   "text": "Spát."
  },
  {
   "start": 310.04,
   "end": 311.68,
   "text": "A vy, děde, jak to říct s dětem."
  },
  {
   "start": 311.68,
   "end": 314.0,
   "text": "Přiďme na to postupně."
  },
  {
   "start": 314.86,
   "end": 316.5,
   "text": "Co spánek?"
  },
  {
   "start": 316.82,
   "end": 317.54,
   "text": "Zkoušela jste něco?"
  },
  {
   "start": 318.88,
   "end": 320.92,
   "text": "Hřmánkový čaj a to je všechno."
  },
  {
   "start": 321.02,
   "end": 322.56,
   "text": "Doktorka mi nebídla prášky,"
  },
  {
   "start": 322.86,
   "end": 323.82,
   "text": "ale nechci."
  },
  {
   "start": 324.04,
   "end": 324.5,
   "text": "Proč nechcete?"
  },
  {
   "start": 325.22,
   "end": 328.92,
   "text": "Bojím si, že bych se nemohla včas zbudit pro děti"
  },
  {
   "start": 328.92,
   "end": 330.4,
   "text": "a nechci být závislá."
  },
  {
   "start": 331.1,
   "end": 332.1,
   "text": "To rozumím."
  },
  {
   "start": 332.92,
   "end": 334.62,
   "text": "Zkusíte dohlenost něco malého,"
  },
  {
   "start": 334.7,
   "end": 335.72,
   "text": "třeba se vedla postela,"
  },
  {
   "start": 335.86,
   "end": 337.58,
   "text": "nechat papíra napsat, co vás budí?"
  },
  {
   "start": 338.52,
   "end": 339.34,
   "text": "Mohla bych,"
  },
  {
   "start": 339.34,
   "end": 340.94,
   "text": "a haspoň to dostanu z hlavy."
  },
  {
   "start": 341.68,
   "end": 343.08,
   "text": "A k dětem?"
  },
  {
   "start": 344.18,
   "end": 345.06,
   "text": "Čeho se nejvíc bojíte?"
  },
  {
   "start": 345.76,
   "end": 348.1,
   "text": "Že s panikařím rozpláču se."
  },
  {
   "start": 348.26,
   "end": 350.22,
   "text": "Že nezvládnou zůstat klidná."
  },
  {
   "start": 350.92,
   "end": 351.72,
   "text": "Tak kdo by to nevadilo?"
  },
  {
   "start": 352.28,
   "end": 353.78,
   "text": "Že bych polkala před dětmi?"
  },
  {
   "start": 354.64,
   "end": 356.78,
   "text": "Vždyť to by pro ně bylo děsivé."
  },
  {
   "start": 357.88,
   "end": 362.2,
   "text": "Nebo by mohly vidět, že jsme tak dovolený."
  },
  {
   "start": 363.42,
   "end": 364.8,
   "text": "To mě nenapadlo."
  },
  {
   "start": 365.8,
   "end": 368.22,
   "text": "Anička je ciklivá. Možná by jí to pomohlo."
  },
  {
   "start": 368.22,
   "end": 372.68,
   "text": "Můžeme se příště podívat, jak to připravit."
  },
  {
   "start": 373.34,
   "end": 374.66,
   "text": "Co dnesete z dneška?"
  },
  {
   "start": 375.6,
   "end": 378.42,
   "text": "Že nejsem sama a že to nemusím zvládnout hned."
  },
  {
   "start": 378.94,
   "end": 381.56,
   "text": "Přesně tak. Pro dnešek tady skončíme."
  },
  {
   "start": 382.14,
   "end": 384.14,
   "text": "Děkuji. Uvidíme se příští týden."
  }
 ],
 "round": "r3a"
}