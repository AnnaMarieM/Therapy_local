{
 "engine": "v3-prompt",
 "base": "whisper-large-v3",
 "opts": {
  "initial_prompt": {
   "cs": "Rozhovor v psychoterapii mezi terapeutem a klientem. Klient mluví o rodině, práci, spánku, úzkosti a pocitech.",
   "en": "A psychotherapy session between a therapist and a client. The client talks about family, work, sleep, anxiety and feelings."
  }
 },
 "client": "tomas-b",
 "lang": "cs",
 "lane": 1,
 "audio_s": 411.5,
 "seconds": 241.4,
 "rtf": 0.587,
 "wer": 0.1736,
 "cer": 0.0829,
 "segments": [
  {
   "start": 1.65,
   "end": 5.05,
   "text": "Dobrý den, pane Bárto, pojďte dál. Jak se vám dnes daří?"
  },
  {
   "start": 5.59,
   "end": 9.81,
   "text": "Dobrý den, docela jsem nervózní, jestli mám odbít upřímně. Nikde jsem psychologa nebyl."
  },
  {
   "start": 10.39,
   "end": 13.43,
   "text": "To je naprosto v pořádku. Co vás sem přivádí?"
  },
  {
   "start": 14.07,
   "end": 18.01,
   "text": "Manželka. Říká, že už to takhle nejde. A já vlastně taky ne."
  },
  {
   "start": 18.45,
   "end": 19.35,
   "text": "Co nejde?"
  },
  {
   "start": 20.05,
   "end": 25.75,
   "text": "30x zečer kontroluji, jestli sem zamknu dveře a vypnu sporák. Trvá mi to hodinu, než odejdu z bytu."
  },
  {
   "start": 26.71,
   "end": 28.35,
   "text": "Hodinu? Jak to vypadá?"
  },
  {
   "start": 28.79,
   "end": 32.57,
   "text": "Zamknu dveře, nadejdu k výtahu, vrátím se a zatáhnu zakliku."
  },
  {
   "start": 33.17,
   "end": 35.33,
   "text": "Pak kontroluji sporách, každý knov týždlař."
  },
  {
   "start": 35.93,
   "end": 36.73,
   "text": "Pak zase dveře."
  },
  {
   "start": 37.49,
   "end": 39.21,
   "text": "A když to uděláte, co se stane?"
  },
  {
   "start": 40.11,
   "end": 40.99,
   "text": "Chvíle se mi umaví."
  },
  {
   "start": 41.71,
   "end": 46.69,
   "text": "Pak se mi do hlavy přijde obraz, že jsem to neudala pořádně a musím vzniknout."
  },
  {
   "start": 47.57,
   "end": 48.73,
   "text": "Co je to za obraz?"
  },
  {
   "start": 49.33,
   "end": 51.33,
   "text": "Být v plamenách. Vidím to jasně jako film."
  },
  {
   "start": 52.17,
   "end": 53.95,
   "text": "Jak často se vám to stává?"
  },
  {
   "start": 54.31,
   "end": 57.83,
   "text": "Každý den. Večer je to nejhorší, když jdeme ven nebo spát."
  },
  {
   "start": 57.83,
   "end": 58.77,
   "text": "A ráno taky."
  },
  {
   "start": 59.73,
   "end": 61.45,
   "text": "Jak dlouho už to trvá?"
  },
  {
   "start": 61.91,
   "end": 65.83,
   "text": "Začalo to před dvěma lety, kdy hořelo u sousedu a my se museli evakuovat."
  },
  {
   "start": 66.39,
   "end": 67.65,
   "text": "Řekněte mi o tom víc."
  },
  {
   "start": 68.29,
   "end": 68.83,
   "text": "Bylo to v noci."
  },
  {
   "start": 69.35,
   "end": 72.45,
   "text": "Potom byl u mě avar, na chodbě byl kůř a lidé křičeli."
  },
  {
   "start": 73.29,
   "end": 74.45,
   "text": "Vyběhli jsme jenom v pyžamech."
  },
  {
   "start": 75.21,
   "end": 76.41,
   "text": "Jak vám tehdy bylo?"
  },
  {
   "start": 77.03,
   "end": 78.47,
   "text": "Že tohle je konec."
  },
  {
   "start": 79.15,
   "end": 81.43,
   "text": "Někdo nebyl zraněn, ale sousedom to vyhořelo celé."
  },
  {
   "start": 81.95,
   "end": 84.17,
   "text": "Stál jsem venku v země a kouká, jak hoří okno."
  },
  {
   "start": 85.47,
   "end": 86.45,
   "text": "A od té doby?"
  },
  {
   "start": 87.83,
   "end": 89.91,
   "text": "V té době mám pocit, že to můžu způsobit já."
  },
  {
   "start": 90.59,
   "end": 93.61,
   "text": "Že když něco neskontroluji, tak se to stane a budu věnány."
  },
  {
   "start": 94.21,
   "end": 95.67,
   "text": "To je velká zodpovědnost."
  },
  {
   "start": 96.41,
   "end": 98.91,
   "text": "Já vím, že to nedává smysl. Znám z logiků."
  },
  {
   "start": 99.55,
   "end": 101.01,
   "text": "Přesto se to nedá vypnout."
  },
  {
   "start": 101.89,
   "end": 104.11,
   "text": "Co děláte, když to nechcete dělat?"
  },
  {
   "start": 104.77,
   "end": 105.61,
   "text": "Zkusím to nechat."
  },
  {
   "start": 106.31,
   "end": 108.35,
   "text": "Pak mi roste úzkost, až mám pocit, že se zblázním."
  },
  {
   "start": 109.17,
   "end": 110.21,
   "text": "Radši to udělám."
  },
  {
   "start": 111.25,
   "end": 112.97,
   "text": "Čím se úzkost projevuje?"
  },
  {
   "start": 112.97,
   "end": 116.13,
   "text": "Srdce po přesuzené ruce a mě špatnil žaludku."
  },
  {
   "start": 117.03,
   "end": 118.03,
   "text": "Kdo o tom ví?"
  },
  {
   "start": 118.55,
   "end": 120.97,
   "text": "Barbara. Moje manželka."
  },
  {
   "start": 121.65,
   "end": 122.91,
   "text": "Na začátku to brala jako zvyk,"
  },
  {
   "start": 122.97,
   "end": 123.99,
   "text": "teď už vidí, že je to víc."
  },
  {
   "start": 124.71,
   "end": 125.81,
   "text": "Jak na to reaguje?"
  },
  {
   "start": 126.77,
   "end": 129.25,
   "text": "Trpěla, ale vidím, že jí to vyčerpává."
  },
  {
   "start": 129.97,
   "end": 131.09,
   "text": "Včera jsme přišli na kino"
  },
  {
   "start": 131.09,
   "end": 132.35,
   "text": "o 40 minut později."
  },
  {
   "start": 132.97,
   "end": 133.75,
   "text": "Co se stalo?"
  },
  {
   "start": 134.01,
   "end": 136.97,
   "text": "Čekala venku, než se vrátím a zkončil je sporák po třetí."
  },
  {
   "start": 137.69,
   "end": 138.37,
   "text": "Neřekla nic,"
  },
  {
   "start": 138.89,
   "end": 139.99,
   "text": "jen se na mě podívala."
  },
  {
   "start": 140.55,
   "end": 141.25,
   "text": "Jak vám bylo?"
  },
  {
   "start": 141.55,
   "end": 142.07,
   "text": "Ano."
  },
  {
   "start": 143.03,
   "end": 145.23,
   "text": "Cítil jsem se jako dítě, který nezvládne vyjít z domu."
  },
  {
   "start": 145.95,
   "end": 147.39,
   "text": "Co děláte za práci?"
  },
  {
   "start": 147.67,
   "end": 149.11,
   "text": "Pracuji jako elektrikář v Malomolce."
  },
  {
   "start": 149.55,
   "end": 151.65,
   "text": "Mám rozvody v bytech a občas v rodinných domech."
  },
  {
   "start": 152.55,
   "end": 154.73,
   "text": "Jak to souvisí s kontrolováním?"
  },
  {
   "start": 155.59,
   "end": 155.93,
   "text": "Hodně."
  },
  {
   "start": 156.55,
   "end": 158.69,
   "text": "Bojím se, že kvůli své hlavě jednou nám chybu,"
  },
  {
   "start": 158.79,
   "end": 160.37,
   "text": "že vpadním při plém vodě či něco zkoří."
  },
  {
   "start": 160.87,
   "end": 162.59,
   "text": "Stalo se vám něco takového?"
  },
  {
   "start": 162.89,
   "end": 164.05,
   "text": "Ne, nikdy."
  },
  {
   "start": 164.61,
   "end": 166.33,
   "text": "Ale pokračující zakázce se vracím na kontrolu."
  },
  {
   "start": 166.33,
   "end": 168.57,
   "text": "Jen když se tam vrátím druhý den, jen se podívat."
  },
  {
   "start": 169.49,
   "end": 170.39,
   "text": "A kolegové?"
  },
  {
   "start": 170.95,
   "end": 172.57,
   "text": "Myslíš si, že jsem pedant?"
  },
  {
   "start": 172.57,
   "end": 177.07,
   "text": "Žef mi říká, že jsem nejpečtojší ve firmě, ale nevědí, kolik času to stojí."
  },
  {
   "start": 177.57,
   "end": 178.87,
   "text": "Kolik času to stojí?"
  },
  {
   "start": 179.19,
   "end": 181.35,
   "text": "V posledních měsících smydla práce o hodinový zdaně."
  },
  {
   "start": 182.01,
   "end": 184.35,
   "text": "Už jsem pár zakázek přijal kolik, ale proč jsem to nestíhal?"
  },
  {
   "start": 185.11,
   "end": 186.55,
   "text": "Co to s vámi dělá?"
  },
  {
   "start": 187.27,
   "end": 190.27,
   "text": "Mám strach, že přijdu o práce. Hlavně teď."
  },
  {
   "start": 191.31,
   "end": 192.21,
   "text": "Proč hodina teď?"
  },
  {
   "start": 192.81,
   "end": 194.67,
   "text": "Probora těhotná ve čtvrtém měsíci."
  },
  {
   "start": 195.59,
   "end": 197.67,
   "text": "Gratuluji. Jak se to přijal?"
  },
  {
   "start": 197.67,
   "end": 199.81,
   "text": "To jsem šťastný. Opravdu."
  },
  {
   "start": 199.81,
   "end": 201.93,
   "text": "Čekali jsme na to tři roky,"
  },
  {
   "start": 202.17,
   "end": 203.67,
   "text": "a potom přišla další myšlenka."
  },
  {
   "start": 203.99,
   "end": 204.55,
   "text": "Jaká?"
  },
  {
   "start": 204.91,
   "end": 207.41,
   "text": "Že jí a dítě tě ublíží."
  },
  {
   "start": 208.11,
   "end": 209.11,
   "text": "Ublížíte jak?"
  },
  {
   "start": 209.59,
   "end": 210.67,
   "text": "Ne, že bych chtěl."
  },
  {
   "start": 211.09,
   "end": 212.79,
   "text": "To je hrozné, nikdy bych to neudal."
  },
  {
   "start": 213.03,
   "end": 214.19,
   "text": "Ale ta myšlenka přijde,"
  },
  {
   "start": 214.77,
   "end": 217.07,
   "text": "když krájím chleba na dostajímu schodu"
  },
  {
   "start": 217.07,
   "end": 218.51,
   "text": "a pak se bojím, že to půjde samou."
  },
  {
   "start": 219.21,
   "end": 222.11,
   "text": "Takže je to myšlenka, která vás těsí."
  },
  {
   "start": 223.21,
   "end": 223.85,
   "text": "Ano."
  },
  {
   "start": 223.85,
   "end": 224.95,
   "text": "Je to nejhorší,"
  },
  {
   "start": 225.25,
   "end": 227.45,
   "text": "když jsem to nikomu neřekl."
  },
  {
   "start": 227.69,
   "end": 228.69,
   "text": "Ani Barboře."
  },
  {
   "start": 229.37,
   "end": 232.03,
   "text": "Děkuji, že jste mi to řekl. To je důležité."
  },
  {
   "start": 233.33,
   "end": 234.47,
   "text": "Myslíš, že jsem nebezpečný?"
  },
  {
   "start": 235.61,
   "end": 241.39,
   "text": "Takové vtíravé myšlenky, jako u lidí s tímto typem potíží, jsou velmi časté."
  },
  {
   "start": 241.79,
   "end": 243.65,
   "text": "Hlavně, když se blíží velká změna."
  },
  {
   "start": 244.29,
   "end": 246.29,
   "text": "Nejsou důkazem, že byste něco udělal."
  },
  {
   "start": 246.73,
   "end": 249.51,
   "text": "Jejich síla je právě v tom, jak vás těsí."
  },
  {
   "start": 250.71,
   "end": 254.93,
   "text": "To by pomalu. Přesto chce čas, až tomu věřím."
  },
  {
   "start": 254.93,
   "end": 259.93,
   "text": "Rozumím. Co děláte, když se ta myšlenka objeví?"
  },
  {
   "start": 259.93,
   "end": 264.93,
   "text": "Odejdu z místnosti. Nebo se vrátím a zkontroluji něco, aby to přestalo."
  },
  {
   "start": 264.93,
   "end": 269.93,
   "text": "Takže kontrola vám pomáhá uklidnit i tuhle?"
  },
  {
   "start": 269.93,
   "end": 273.93,
   "text": "Vlastně ano. Nikdy mě nenapadlo, že to způsobí si."
  },
  {
   "start": 273.93,
   "end": 275.93,
   "text": "Jak spíte?"
  },
  {
   "start": 275.93,
   "end": 281.93,
   "text": "Spím mezerně. Vstávám noce dvakrát a kontrola je sporád, i když tam nic nestojí."
  },
  {
   "start": 281.93,
   "end": 283.93,
   "text": "Pomáhá vám něco?"
  },
  {
   "start": 283.93,
   "end": 287.49,
   "text": "Pomáháme na procházky s Barborou, když je právě něco doma."
  },
  {
   "start": 287.49,
   "end": 288.49,
   "text": "To mě zaměstná."
  },
  {
   "start": 288.77,
   "end": 290.39,
   "text": "Jak často to děláte?"
  },
  {
   "start": 290.69,
   "end": 292.93,
   "text": "Procházky dvakrát. Týdně."
  },
  {
   "start": 292.93,
   "end": 294.93,
   "text": "No právě kdežec."
  },
  {
   "start": 296.03,
   "end": 299.25,
   "text": "Co by pro vás znamenalo, kdyby se to zlepšilo?"
  },
  {
   "start": 299.65,
   "end": 301.29,
   "text": "Odejít ve dřudzu za pět minut."
  },
  {
   "start": 301.57,
   "end": 303.97,
   "text": "A těšit se na dítě bez těch myšlenek."
  },
  {
   "start": 304.85,
   "end": 306.41,
   "text": "To jsou jasné cíle."
  },
  {
   "start": 306.81,
   "end": 309.93,
   "text": "Víte, že existuje léčba, která tomu pomáhá?"
  },
  {
   "start": 310.67,
   "end": 314.41,
   "text": "Zdošel jsem u terapii, kdy se člověk postupně vystavuje tomu, čemu se bojí."
  },
  {
   "start": 315.33,
   "end": 316.61,
   "text": "Měl jsem z toho strach."
  },
  {
   "start": 317.13,
   "end": 318.69,
   "text": "Strach je pochopitelný."
  },
  {
   "start": 319.35,
   "end": 323.05,
   "text": "Šlo by si po malých krocích a vy byste o tempu rozhodoval."
  },
  {
   "start": 324.07,
   "end": 326.45,
   "text": "To je uklidňující."
  },
  {
   "start": 327.35,
   "end": 331.09,
   "text": "Myslel jsem, že mě někdo donutí nechat otevřené dveře odejít."
  },
  {
   "start": 331.71,
   "end": 332.49,
   "text": "Tak to ne."
  },
  {
   "start": 332.89,
   "end": 337.85,
   "text": "Začali bychom třeba jen tím, že zkontrolujete dveře jenom jednou, ne třikrát."
  },
  {
   "start": 337.85,
   "end": 341.17,
   "text": "To zní malé, ale to je pro mě velké."
  },
  {
   "start": 341.87,
   "end": 344.27,
   "text": "Velké kroky začínají malými."
  },
  {
   "start": 344.99,
   "end": 347.03,
   "text": "Řekl jste něco důležitého o Barboře."
  },
  {
   "start": 347.61,
   "end": 348.73,
   "text": "Chtěl byste jí..."
  },
  {
   "start": 348.73,
   "end": 350.87,
   "text": "Co byste jí chtěl říct?"
  },
  {
   "start": 351.17,
   "end": 351.67,
   "text": "Že jí milu."
  },
  {
   "start": 352.41,
   "end": 353.65,
   "text": "A že se potřebuje dát,"
  },
  {
   "start": 353.83,
   "end": 354.95,
   "text": "že zaběh jí nestratil."
  },
  {
   "start": 355.79,
   "end": 356.87,
   "text": "Zatím se bojím,"
  },
  {
   "start": 357.09,
   "end": 358.93,
   "text": "že by se mnou nechtěla být."
  },
  {
   "start": 360.17,
   "end": 362.59,
   "text": "Co si myslíte, že by řekla?"
  },
  {
   "start": 363.69,
   "end": 364.91,
   "text": "Se by mě objala."
  },
  {
   "start": 365.73,
   "end": 366.75,
   "text": "Ona je taková."
  },
  {
   "start": 366.75,
   "end": 370.83,
   "text": "Pak možná stojí za to jí říct alespoň část."
  },
  {
   "start": 371.79,
   "end": 376.49,
   "text": "Co kdybyste jí řekl, že jste tu byl a co jste se dozvěděl?"
  },
  {
   "start": 376.95,
   "end": 379.79,
   "text": "To je tak zvlád. O těch myšlenkách ještě ne."
  },
  {
   "start": 380.23,
   "end": 382.81,
   "text": "To je v pořádku. Tempo určujete vy."
  },
  {
   "start": 383.43,
   "end": 386.07,
   "text": "Děkuji. Tohle mi dalo víc, než jsem čekal."
  },
  {
   "start": 387.47,
   "end": 389.91,
   "text": "Do příště zkuste jednu věc."
  },
  {
   "start": 390.63,
   "end": 393.75,
   "text": "Když odcházíte z bytu, zkontrolujte dveře jenom jednou"
  },
  {
   "start": 393.75,
   "end": 395.69,
   "text": "jednou a zavěřte si,"
  },
  {
   "start": 395.93,
   "end": 397.53,
   "text": "jak moc vám bylo úzko."
  },
  {
   "start": 398.37,
   "end": 399.05,
   "text": "Jednou."
  },
  {
   "start": 399.69,
   "end": 401.87,
   "text": "Zkusím to. Aspoň jednou."
  },
  {
   "start": 402.61,
   "end": 404.29,
   "text": "A zapíšu číslo od jedna do deseti."
  },
  {
   "start": 405.19,
   "end": 406.09,
   "text": "Přesně tak."
  },
  {
   "start": 406.45,
   "end": 407.97,
   "text": "Pro dnešek tedy skončíme."
  },
  {
   "start": 408.63,
   "end": 410.23,
   "text": "Děkuji. Uvidíme se příští týden."
  }
 ],
 "round": "r2a"
}