{
 "engine": "whisper-large-v3",
 "client": "jana-n",
 "lang": "cs",
 "lane": 2,
 "audio_s": 384.5,
 "seconds": 352.6,
 "rtf": 0.917,
 "wer": 0.1193,
 "cer": 0.0536,
 "segments": [
  {
   "start": 0.78,
   "end": 2.38,
   "text": "Dobrý den, paní Nováková, pojďte dál."
  },
  {
   "start": 2.88,
   "end": 4.78,
   "text": "S čím byste dnes chtěla začít?"
  },
  {
   "start": 5.62,
   "end": 6.84,
   "text": "Dobrý den, já ani nevím."
  },
  {
   "start": 7.08,
   "end": 8.5,
   "text": "Mám pocit, že mi někdo vytáhl"
  },
  {
   "start": 8.5,
   "end": 10.16,
   "text": "koberec pod nohou."
  },
  {
   "start": 10.5,
   "end": 10.96,
   "text": "Co se stalo?"
  },
  {
   "start": 11.68,
   "end": 13.14,
   "text": "Po patnácti letech manželství"
  },
  {
   "start": 13.14,
   "end": 14.86,
   "text": "jsme se s manželem Radkem"
  },
  {
   "start": 14.86,
   "end": 16.66,
   "text": "rozhodli pro rozvod."
  },
  {
   "start": 16.8,
   "end": 18.44,
   "text": "A já to pořád nemohu pochopit."
  },
  {
   "start": 18.98,
   "end": 19.72,
   "text": "Řekněte mi víc."
  },
  {
   "start": 20.28,
   "end": 22.42,
   "text": "Ještě vládě jsme byli nedovolené v Chorvatsku"
  },
  {
   "start": 22.42,
   "end": 23.96,
   "text": "a všechno vypadalo normálně."
  },
  {
   "start": 23.96,
   "end": 26.6,
   "text": "A v září mi řekl, že už to takhle dál nejde."
  },
  {
   "start": 27.62,
   "end": 28.42,
   "text": "A jak jste to přijalo?"
  },
  {
   "start": 28.86,
   "end": 30.96,
   "text": "Seděla jsem v kuchyni a nemohla jsem nic říct."
  },
  {
   "start": 31.12,
   "end": 33.62,
   "text": "Pak jsem šla uklidit nádobí, jako by se nic nedělo."
  },
  {
   "start": 34.12,
   "end": 35.6,
   "text": "A co se dalo uvnitř vás?"
  },
  {
   "start": 36.7,
   "end": 39.68,
   "text": "Prázdno, pak zlost, pak zase prázdnost."
  },
  {
   "start": 39.86,
   "end": 41.42,
   "text": "Třídá se to několikrát denně."
  },
  {
   "start": 42.1,
   "end": 43.32,
   "text": "Vysvětlil vám Radek proč?"
  },
  {
   "start": 44.18,
   "end": 47.16,
   "text": "Říká, že jsme se vzdáleli, že žijeme vedle sebe."
  },
  {
   "start": 47.16,
   "end": 50.58,
   "text": "Já si toho nevšimla, nebo jsem si všimnout nechtěla."
  },
  {
   "start": 51.64,
   "end": 52.98,
   "text": "Co si o tom myslíte teď?"
  },
  {
   "start": 54.08,
   "end": 56.86,
   "text": "Že jsem to měla vidět, že jsem slepá."
  },
  {
   "start": 56.86,
   "end": 59.08,
   "text": "pořád se v hlavě vracím a hledám,"
  },
  {
   "start": 59.18,
   "end": 60.26,
   "text": "kde jsem udělala chybu."
  },
  {
   "start": 60.78,
   "end": 61.9,
   "text": "A našla jsi? Ne."
  },
  {
   "start": 62.74,
   "end": 64.54,
   "text": "Jednou si myslím, že jsem byla moc unavená,"
  },
  {
   "start": 64.62,
   "end": 66.68,
   "text": "nezajímala jsem se o něj. Jednou zase,"
  },
  {
   "start": 67.34,
   "end": 68.9,
   "text": "že jsem se starala moc."
  },
  {
   "start": 70.02,
   "end": 71.04,
   "text": "Vypadá to, že se"
  },
  {
   "start": 71.04,
   "end": 72.5,
   "text": "v tom hodině trápíte."
  },
  {
   "start": 72.92,
   "end": 74.82,
   "text": "Ano, hlavně kvůli dětem."
  },
  {
   "start": 75.24,
   "end": 76.02,
   "text": "Pověďte mi o nich."
  },
  {
   "start": 76.76,
   "end": 78.54,
   "text": "Mám dvě děti, Aničce 12"
  },
  {
   "start": 78.54,
   "end": 81.48,
   "text": "a Matějevi 8 let a nevím, jak jim to říct."
  },
  {
   "start": 81.48,
   "end": 82.92,
   "text": "Ještě jste jim to neřekla? Ne."
  },
  {
   "start": 83.18,
   "end": 85.42,
   "text": "Radek chce, abychom to řekli společně,"
  },
  {
   "start": 85.42,
   "end": 86.94,
   "text": "alebo řád to odkládáme."
  },
  {
   "start": 87.6,
   "end": 89.0,
   "text": "Anička už něco tuší."
  },
  {
   "start": 89.24,
   "end": 89.88,
   "text": "Co vám to říká?"
  },
  {
   "start": 90.9,
   "end": 93.9,
   "text": "Minulý týden se mě zeptala, jestli se s tátou hádáme."
  },
  {
   "start": 94.06,
   "end": 95.04,
   "text": "Řekla jsem, že ne."
  },
  {
   "start": 95.78,
   "end": 97.28,
   "text": "Cítila jsem se hrozně."
  },
  {
   "start": 100.4,
   "end": 101.42,
   "text": "Proč hrozně?"
  },
  {
   "start": 102.62,
   "end": 104.06,
   "text": "Protože jsem lhala."
  },
  {
   "start": 104.14,
   "end": 105.16,
   "text": "A ona to poznala."
  },
  {
   "start": 105.32,
   "end": 106.78,
   "text": "Viděla jsem jí to na očích."
  },
  {
   "start": 107.12,
   "end": 108.08,
   "text": "Co se vám mohlo hlavou?"
  },
  {
   "start": 108.62,
   "end": 110.86,
   "text": "Že ji ničím život, že ji vezmu domov."
  },
  {
   "start": 111.88,
   "end": 113.8,
   "text": "Jak by se vám dařilo, že ji cítí pravdu?"
  },
  {
   "start": 114.66,
   "end": 116.2,
   "text": "Nejraději bych to měla za sebou,"
  },
  {
   "start": 116.2,
   "end": 117.84,
   "text": "ale bojím se jejich slz."
  },
  {
   "start": 118.02,
   "end": 120.52,
   "text": "A Matěj je ještě malý, ten moc nic nechápe."
  },
  {
   "start": 120.96,
   "end": 122.02,
   "text": "Co byste mu chtěla předat?"
  },
  {
   "start": 122.66,
   "end": 124.14,
   "text": "Že ho máme oba rádi"
  },
  {
   "start": 124.14,
   "end": 125.4,
   "text": "a že se to nezmění."
  },
  {
   "start": 125.62,
   "end": 128.4,
   "text": "Jenže já nevím, jestli je to pravda,"
  },
  {
   "start": 128.94,
   "end": 130.2,
   "text": "když sama nevím, jak to bude vypadat."
  },
  {
   "start": 131.56,
   "end": 132.64,
   "text": "Jak to bude vypadat s bydlením?"
  },
  {
   "start": 133.24,
   "end": 134.7,
   "text": "Byd je na hypotéku,"
  },
  {
   "start": 134.94,
   "end": 136.8,
   "text": "Radek se asi odstihuje k bratrově,"
  },
  {
   "start": 136.86,
   "end": 137.68,
   "text": "alespoň zatím."
  },
  {
   "start": 138.18,
   "end": 139.34,
   "text": "Dítě zůstanou se mnou."
  },
  {
   "start": 139.88,
   "end": 140.74,
   "text": "Jak se vám z toho dělá?"
  },
  {
   "start": 140.92,
   "end": 142.88,
   "text": "Mám strach, že to sama nezvládnu."
  },
  {
   "start": 143.08,
   "end": 144.92,
   "text": "Radek by vždycky řešil peníze."
  },
  {
   "start": 146.2,
   "end": 148.44,
   "text": "dnech. Pracuji jako učitelka češtiny"
  },
  {
   "start": 148.44,
   "end": 150.12,
   "text": "na základní škole v Brně."
  },
  {
   "start": 150.3,
   "end": 152.22,
   "text": "Učím devítky a osmičky."
  },
  {
   "start": 153.0,
   "end": 154.18,
   "text": "Jak se vám teď učí?"
  },
  {
   "start": 155.46,
   "end": 156.22,
   "text": "Do třídy chodím"
  },
  {
   "start": 156.22,
   "end": 158.04,
   "text": "s knelíkem v krku. Mám pocit, že"
  },
  {
   "start": 158.04,
   "end": 160.42,
   "text": "všichni vidí, že se mi rozpadá život."
  },
  {
   "start": 162.56,
   "end": 164.38,
   "text": "Ví o tom někde ve škole?"
  },
  {
   "start": 165.16,
   "end": 166.12,
   "text": "Jen ředitelka."
  },
  {
   "start": 166.28,
   "end": 168.1,
   "text": "Řekla jsem jí to, protože jsem"
  },
  {
   "start": 168.1,
   "end": 169.9,
   "text": "se jednou rozplakala na chodbě."
  },
  {
   "start": 170.02,
   "end": 171.96,
   "text": "Byla hodná. Co vám pomohlo?"
  },
  {
   "start": 173.34,
   "end": 174.86,
   "text": "Že mě nechala odejít"
  },
  {
   "start": 174.86,
   "end": 176.86,
   "text": "dřív. Dala mi hodinu volné."
  },
  {
   "start": 177.04,
   "end": 178.76,
   "text": "Jenže pak jsem seděla doma a bylo to"
  },
  {
   "start": 178.76,
   "end": 180.38,
   "text": "horší. Horší?"
  },
  {
   "start": 181.06,
   "end": 182.82,
   "text": "Proč? Protože jsem"
  },
  {
   "start": 182.82,
   "end": 184.86,
   "text": "byla sama za hlavou. V práci jsem měla"
  },
  {
   "start": 184.86,
   "end": 185.86,
   "text": "aspoň co dělat."
  },
  {
   "start": 187.08,
   "end": 187.92,
   "text": "Jak spíte?"
  },
  {
   "start": 188.8,
   "end": 190.98,
   "text": "Špatně. Každou noc se budím"
  },
  {
   "start": 190.98,
   "end": 192.9,
   "text": "ve tři hodiny ráno a přemýšlím, co bude"
  },
  {
   "start": 192.9,
   "end": 194.92,
   "text": "dál. Co se říkáte, když"
  },
  {
   "start": 194.92,
   "end": 195.62,
   "text": "se probudíte?"
  },
  {
   "start": 196.7,
   "end": 198.8,
   "text": "Že nemám hypotéku, nemám manžela,"
  },
  {
   "start": 199.02,
   "end": 200.78,
   "text": "nemám nic. Pak spočítám"
  },
  {
   "start": 200.78,
   "end": 203.08,
   "text": "peníze, pak si představím, jak to řeknu"
  },
  {
   "start": 203.08,
   "end": 205.4,
   "text": "dětem. Točí se to dokola."
  },
  {
   "start": 205.8,
   "end": 206.14,
   "text": "A pak?"
  },
  {
   "start": 207.22,
   "end": 209.3,
   "text": "Kolem páté usnu a v půl sedmé"
  },
  {
   "start": 209.3,
   "end": 211.34,
   "text": "vztáhám. Jsem unavená"
  },
  {
   "start": 211.34,
   "end": 213.04,
   "text": "už ráno. Jíte?"
  },
  {
   "start": 213.36,
   "end": 213.9,
   "text": "Hýbete se?"
  },
  {
   "start": 214.8,
   "end": 217.32,
   "text": "Jím málo. Zubla jsem čtyřikyla."
  },
  {
   "start": 217.46,
   "end": 219.6,
   "text": "Kamarádka mi říká, že vypadám hrozně."
  },
  {
   "start": 220.54,
   "end": 221.34,
   "text": "Máte kolem sebe"
  },
  {
   "start": 221.34,
   "end": 222.36,
   "text": "někoho, s kým můžete mluvit?"
  },
  {
   "start": 222.92,
   "end": 224.7,
   "text": "Mám sestru Alanu v Olomouci."
  },
  {
   "start": 225.3,
   "end": 227.22,
   "text": "Volá mi skoro každý večer"
  },
  {
   "start": 227.22,
   "end": 229.0,
   "text": "a kamarádku Evu z práce."
  },
  {
   "start": 229.0,
   "end": 229.9,
   "text": "Co jim říkáte?"
  },
  {
   "start": 230.7,
   "end": 232.78,
   "text": "Ale se skoro všechno. Evě jen to,"
  },
  {
   "start": 232.78,
   "end": 234.1,
   "text": "že mám těžké období."
  },
  {
   "start": 234.6,
   "end": 236.24,
   "text": "Nechci, aby se o mě něco myslela."
  },
  {
   "start": 236.7,
   "end": 237.94,
   "text": "Co se obháváte, že si myslí?"
  },
  {
   "start": 238.8,
   "end": 239.9,
   "text": "Že jsem se lhala."
  },
  {
   "start": 240.12,
   "end": 242.36,
   "text": "Že žena, která nedokážu udržet manželství,"
  },
  {
   "start": 242.42,
   "end": 243.92,
   "text": "není pro děti dobrý příklad."
  },
  {
   "start": 244.9,
   "end": 247.06,
   "text": "To je těžká myšlenka."
  },
  {
   "start": 247.9,
   "end": 248.5,
   "text": "Odkud se bere?"
  },
  {
   "start": 249.1,
   "end": 250.2,
   "text": "Asi od mojí mámy."
  },
  {
   "start": 250.4,
   "end": 252.78,
   "text": "Ta vždycky říkala, že manželství se drží"
  },
  {
   "start": 252.78,
   "end": 253.88,
   "text": "a děto jak chce."
  },
  {
   "start": 255.08,
   "end": 257.06,
   "text": "Co řekla, když jste jí to oznámila?"
  },
  {
   "start": 257.52,
   "end": 258.04,
   "text": "Molčela."
  },
  {
   "start": 258.94,
   "end": 260.26,
   "text": "Pak řekla, že doufá,"
  },
  {
   "start": 260.26,
   "end": 262.18,
   "text": "že jsem to dobře zvážela."
  },
  {
   "start": 262.78,
   "end": 264.5,
   "text": "Už se od té doby moc neozvala."
  },
  {
   "start": 265.92,
   "end": 266.56,
   "text": "Jak vám to je?"
  },
  {
   "start": 267.22,
   "end": 267.7,
   "text": "Smutno."
  },
  {
   "start": 268.52,
   "end": 270.48,
   "text": "Potřebovala bych, aby mě olobila."
  },
  {
   "start": 271.46,
   "end": 272.48,
   "text": "Co byste jistila říct?"
  },
  {
   "start": 272.98,
   "end": 277.14,
   "text": "Že to bolí, že nechci být sama, jenže u nás se to nedělá."
  },
  {
   "start": 278.24,
   "end": 279.76,
   "text": "Co se děje, když to říkáte na hlas?"
  },
  {
   "start": 280.74,
   "end": 282.7,
   "text": "Pláču a omlouvám se."
  },
  {
   "start": 284.16,
   "end": 285.32,
   "text": "Není za co."
  },
  {
   "start": 286.16,
   "end": 287.0,
   "text": "Vezměte si čas."
  },
  {
   "start": 288.74,
   "end": 291.54,
   "text": "Děkuji. Ještě jsem nikomu tohle neřekla."
  },
  {
   "start": 291.54,
   "end": 297.08,
   "text": "Co s vámi dělá, že jste to tady řekla?"
  },
  {
   "start": 299.54,
   "end": 304.72,
   "text": "Je zvláštní sedět tady a říkat to všechno nahlas, ale trochu to pomáhá."
  },
  {
   "start": 306.2,
   "end": 307.68,
   "text": "Co by vám teď mohlo pomoct nejvíc?"
  },
  {
   "start": 309.1,
   "end": 311.68,
   "text": "Spát a vidět, jak to říct dětem."
  },
  {
   "start": 313.14,
   "end": 314.0,
   "text": "Pěkme na to postupně."
  },
  {
   "start": 314.88,
   "end": 317.52,
   "text": "Co spánek? Zkoušela jste něco?"
  },
  {
   "start": 318.88,
   "end": 323.8,
   "text": "Hrvánkový čaj a to je všechno. Doktorka mi nabídla prášky, ale nechci."
  },
  {
   "start": 323.8,
   "end": 324.5,
   "text": "Proč nechcete?"
  },
  {
   "start": 325.22,
   "end": 330.36,
   "text": "Bojím se, že bych se nemohla včas zbudit pro děti a nechci být závislá."
  },
  {
   "start": 331.08,
   "end": 332.06,
   "text": "To je rozumné."
  },
  {
   "start": 332.88,
   "end": 337.58,
   "text": "Zkusíte tohle noc něco malého, třeba se vedle postele nechat papíra napsat, co vás budí?"
  },
  {
   "start": 338.52,
   "end": 340.92,
   "text": "Mohla bych, ale spíš to dostanu z hlavy."
  },
  {
   "start": 342.08,
   "end": 343.08,
   "text": "A dětem?"
  },
  {
   "start": 344.14,
   "end": 345.04,
   "text": "Čeho se nejvíc bojíte?"
  },
  {
   "start": 345.72,
   "end": 350.18,
   "text": "Že s panikařím rozpláču se, že nezvládnu zůstat klidná."
  },
  {
   "start": 350.92,
   "end": 351.7,
   "text": "Tak kdo by to nevadilo?"
  },
  {
   "start": 352.24,
   "end": 353.76,
   "text": "Že bych plakala před dětmi?"
  },
  {
   "start": 354.62,
   "end": 356.8,
   "text": "Vždyť to by pro ně bylo děsivé."
  },
  {
   "start": 357.76,
   "end": 362.2,
   "text": "Nebo by mohly vidět, že smutek je dovolený."
  },
  {
   "start": 363.38,
   "end": 364.78,
   "text": "To mě nenapadlo."
  },
  {
   "start": 365.46,
   "end": 368.2,
   "text": "Ani čpě citlivá, možná by jí to pomohlo."
  },
  {
   "start": 369.4,
   "end": 372.66,
   "text": "Můžeme se příště podívat, jak to připravit."
  },
  {
   "start": 373.34,
   "end": 374.64,
   "text": "Co dnes se tez dneška?"
  },
  {
   "start": 375.56,
   "end": 378.4,
   "text": "Že nejsem sama a že to nemusím zvládnout hned."
  },
  {
   "start": 378.9,
   "end": 379.44,
   "text": "Přesně to."
  },
  {
   "start": 380.42,
   "end": 381.54,
   "text": "Pro dnešek tady skončíme."
  },
  {
   "start": 381.54,
   "end": 384.12,
   "text": "Děkuji. Uvidíme se příští týden."
  }
 ],
 "round": "r1"
}