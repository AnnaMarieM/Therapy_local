{
 "engine": "v3-beam10",
 "base": "whisper-large-v3",
 "opts": {
  "beam_size": 10,
  "patience": 2.0
 },
 "client": "tomas-b",
 "lang": "cs",
 "lane": 1,
 "audio_s": 411.5,
 "seconds": 548.4,
 "rtf": 1.333,
 "wer": 0.1674,
 "cer": 0.0804,
 "segments": [
  {
   "start": 1.65,
   "end": 5.05,
   "text": "Dobrý den, pane Bárto, pojďte dál. Jak se vám dnes daří?"
  },
  {
   "start": 5.59,
   "end": 9.81,
   "text": "Dobrý den, docela jsem nervózní. Jestli mám odbít upřímný, nikde jsem psychologa nebyl."
  },
  {
   "start": 10.37,
   "end": 13.43,
   "text": "To je naprosto v pořádku. Co vás sem přivádí?"
  },
  {
   "start": 14.07,
   "end": 18.01,
   "text": "Manželka. Říká, že už to takhle nejde. A já vlastně taky ne."
  },
  {
   "start": 18.45,
   "end": 19.35,
   "text": "Co nejde?"
  },
  {
   "start": 20.05,
   "end": 23.71,
   "text": "Třicetkrát zečer kontroluji, jestli sem zamknu dveře a vypnu sporák."
  },
  {
   "start": 24.15,
   "end": 25.75,
   "text": "Trvá mi to hodinu, než odejdu z bytu."
  },
  {
   "start": 26.69,
   "end": 28.35,
   "text": "Hodinu? Jak to vypadá?"
  },
  {
   "start": 28.77,
   "end": 32.53,
   "text": "Zamknu dveře, nadejdu k výtahu, vrátím se a zatáhnu zakvěku."
  },
  {
   "start": 33.17,
   "end": 35.33,
   "text": "Pak zkontroluji sporách, každý knov týždlař."
  },
  {
   "start": 35.93,
   "end": 36.73,
   "text": "Pak zase dveře."
  },
  {
   "start": 37.49,
   "end": 39.21,
   "text": "A když to uděláte, co se stane?"
  },
  {
   "start": 40.11,
   "end": 40.99,
   "text": "Chvíle se mi umaví."
  },
  {
   "start": 41.71,
   "end": 46.77,
   "text": "Pak se mi do hlavy přijde obraz, že jsem to neudala pořádně a musím znovu."
  },
  {
   "start": 47.57,
   "end": 48.73,
   "text": "Co je to za obraz?"
  },
  {
   "start": 49.33,
   "end": 51.33,
   "text": "Být v plamenech. Vidím to jasně jako film."
  },
  {
   "start": 52.17,
   "end": 53.95,
   "text": "Jak často se vám to stává?"
  },
  {
   "start": 54.31,
   "end": 57.83,
   "text": "Každý den. Večer je to nejhorší, když jdeme ven nebo spát."
  },
  {
   "start": 57.83,
   "end": 58.77,
   "text": "A ráno taky."
  },
  {
   "start": 59.73,
   "end": 61.45,
   "text": "Jak dlouho už to trvá?"
  },
  {
   "start": 61.91,
   "end": 65.83,
   "text": "Začalo to před dvěma lety, kdy hořelo u sousedů a my se museli evakuovat."
  },
  {
   "start": 66.39,
   "end": 67.65,
   "text": "Řekněte mi o tom víc."
  },
  {
   "start": 68.29,
   "end": 68.83,
   "text": "Bylo to v noci."
  },
  {
   "start": 69.35,
   "end": 72.45,
   "text": "Potom byl u mě avar, na chodbě byl kůř a lidé křičeli."
  },
  {
   "start": 73.29,
   "end": 74.45,
   "text": "Vyběhli jsme jenom v pyžamech."
  },
  {
   "start": 75.21,
   "end": 76.41,
   "text": "Jak vám tehdy bylo?"
  },
  {
   "start": 77.03,
   "end": 78.49,
   "text": "Že tohle je konec."
  },
  {
   "start": 79.15,
   "end": 81.45,
   "text": "Někdo nebyl zraněn, ale sousedům to vyhořelo celé."
  },
  {
   "start": 81.97,
   "end": 84.17,
   "text": "Stál jsem venku v země a koukal, jak hoří okno."
  },
  {
   "start": 85.47,
   "end": 86.45,
   "text": "A od té doby?"
  },
  {
   "start": 87.83,
   "end": 89.93,
   "text": "V té době mám pocit, že to můžu způsobit já."
  },
  {
   "start": 90.59,
   "end": 93.61,
   "text": "Že když něco neskontroluji, tak se to stane a budu věnány."
  },
  {
   "start": 94.21,
   "end": 95.67,
   "text": "To je velká zodpovědnost."
  },
  {
   "start": 96.41,
   "end": 98.91,
   "text": "Já vím, že to nedává smysl. Znám z logiků."
  },
  {
   "start": 99.55,
   "end": 101.01,
   "text": "Přesto se to nedá vypnout."
  },
  {
   "start": 101.73,
   "end": 104.13,
   "text": "Co děláte, když to nechcete dělat?"
  },
  {
   "start": 104.79,
   "end": 105.61,
   "text": "Zkusím to nechat."
  },
  {
   "start": 106.31,
   "end": 108.35,
   "text": "Pak mi roste úzkost, až mám pocit, že se zblázním."
  },
  {
   "start": 109.17,
   "end": 110.21,
   "text": "Radši to udělám."
  },
  {
   "start": 111.25,
   "end": 112.97,
   "text": "Čím se úzkost projevuje?"
  },
  {
   "start": 112.97,
   "end": 116.13,
   "text": "Srdce po třesou země ruce a mě špatnil žaludku."
  },
  {
   "start": 117.03,
   "end": 118.03,
   "text": "Kdo o tom ví?"
  },
  {
   "start": 118.55,
   "end": 120.97,
   "text": "Barbara. Moje manželka."
  },
  {
   "start": 121.65,
   "end": 122.91,
   "text": "Na začátku to brala jako zvyk,"
  },
  {
   "start": 122.97,
   "end": 123.99,
   "text": "teď už vidí, že je to víc."
  },
  {
   "start": 124.71,
   "end": 125.81,
   "text": "Jak na to reaguje?"
  },
  {
   "start": 126.79,
   "end": 129.25,
   "text": "Trpěla, ale vidím, že jí to vyčerpává."
  },
  {
   "start": 129.97,
   "end": 131.09,
   "text": "Včera jsme přišli na kino"
  },
  {
   "start": 131.09,
   "end": 132.35,
   "text": "o 40 minut později."
  },
  {
   "start": 132.97,
   "end": 133.75,
   "text": "Co se stalo?"
  },
  {
   "start": 134.01,
   "end": 136.97,
   "text": "Čekala venku, než se vrátím a zkončil je zporád po třetí."
  },
  {
   "start": 137.69,
   "end": 138.37,
   "text": "Neřekla nic,"
  },
  {
   "start": 138.89,
   "end": 139.99,
   "text": "jen se na mě podívala."
  },
  {
   "start": 140.55,
   "end": 141.23,
   "text": "Jak vám bylo?"
  },
  {
   "start": 141.79,
   "end": 144.07,
   "text": "Ano. Cítil jsem se jako dítě,"
  },
  {
   "start": 144.13,
   "end": 145.23,
   "text": "který nezvládne vyjít z domu."
  },
  {
   "start": 145.95,
   "end": 147.39,
   "text": "Co děláte za práci?"
  },
  {
   "start": 147.67,
   "end": 149.11,
   "text": "Pracuji jako elektrikář v Malomolce."
  },
  {
   "start": 149.55,
   "end": 151.65,
   "text": "Mám rozvody v bytech a občas v rodněných domech."
  },
  {
   "start": 152.55,
   "end": 154.73,
   "text": "Jak to souvisí s kontrolováním?"
  },
  {
   "start": 155.59,
   "end": 155.93,
   "text": "Hodně."
  },
  {
   "start": 156.55,
   "end": 158.69,
   "text": "Bojím se, že kvůli své hlavě jednou nám chybu,"
  },
  {
   "start": 158.79,
   "end": 160.37,
   "text": "že vpadním při plém vodě či něco zkoří."
  },
  {
   "start": 160.87,
   "end": 162.59,
   "text": "Stalo se vám něco takového?"
  },
  {
   "start": 162.89,
   "end": 164.05,
   "text": "Ne, nikdy."
  },
  {
   "start": 164.61,
   "end": 166.33,
   "text": "Ale pokračující zakázce se vracím do kontrolu,"
  },
  {
   "start": 166.33,
   "end": 168.59,
   "text": "jen když se tam vrátím druhý den, jen se podívat."
  },
  {
   "start": 169.49,
   "end": 170.39,
   "text": "A kolegové?"
  },
  {
   "start": 170.95,
   "end": 172.59,
   "text": "Myslíš si, že jsem pedant?"
  },
  {
   "start": 173.31,
   "end": 175.61,
   "text": "Žev mi říká, že jsem nejpečtojší ve firmě,"
  },
  {
   "start": 175.65,
   "end": 177.05,
   "text": "ale nevědí, kolik času to stojí."
  },
  {
   "start": 177.53,
   "end": 178.87,
   "text": "Kolik času to stojí?"
  },
  {
   "start": 179.19,
   "end": 181.35,
   "text": "V posledních měsících jsi mědla práce o hodinový zdaně."
  },
  {
   "start": 182.03,
   "end": 183.31,
   "text": "Už jsem pár zakázek přijal kolik,"
  },
  {
   "start": 183.37,
   "end": 184.35,
   "text": "ale proč jsem to nestíhal?"
  },
  {
   "start": 184.91,
   "end": 186.53,
   "text": "Co to s vámi dělá?"
  },
  {
   "start": 187.25,
   "end": 188.93,
   "text": "Mám strach, že přijdu o práci."
  },
  {
   "start": 189.69,
   "end": 190.27,
   "text": "Hlavně teď."
  },
  {
   "start": 191.31,
   "end": 192.21,
   "text": "Proč hodina teď?"
  },
  {
   "start": 192.81,
   "end": 194.67,
   "text": "Probora těhotná, ve čtvrtém měsíci."
  },
  {
   "start": 195.63,
   "end": 196.15,
   "text": "Gratuluji."
  },
  {
   "start": 196.15,
   "end": 197.67,
   "text": "Jak se to přijal?"
  },
  {
   "start": 198.13,
   "end": 199.83,
   "text": "Jsem šťastný, opravdu."
  },
  {
   "start": 200.71,
   "end": 201.93,
   "text": "Čekali jsme na to tři roky,"
  },
  {
   "start": 202.59,
   "end": 204.57,
   "text": "přišla další myšlenka. Jaká?"
  },
  {
   "start": 204.91,
   "end": 206.79,
   "text": "Že jí a dítě"
  },
  {
   "start": 206.79,
   "end": 209.13,
   "text": "tě ublíží. Ublížíte jak?"
  },
  {
   "start": 209.61,
   "end": 210.67,
   "text": "Ne, že bych chtěl."
  },
  {
   "start": 211.09,
   "end": 212.79,
   "text": "To je hrozné, nikdy bych to neudal."
  },
  {
   "start": 213.03,
   "end": 214.19,
   "text": "Ale ta myšlenka přijde,"
  },
  {
   "start": 214.77,
   "end": 216.73,
   "text": "když krájím chleba na dostajím"
  },
  {
   "start": 216.73,
   "end": 218.61,
   "text": "u schodu a pak se bojím, že to půjde samotně."
  },
  {
   "start": 219.21,
   "end": 220.55,
   "text": "Takže je to myšlenka,"
  },
  {
   "start": 220.81,
   "end": 222.09,
   "text": "která vás děsí."
  },
  {
   "start": 223.17,
   "end": 224.95,
   "text": "Ano. Je to nejhorší,"
  },
  {
   "start": 225.27,
   "end": 226.99,
   "text": "když jsem to někomu"
  },
  {
   "start": 226.99,
   "end": 228.69,
   "text": "neřekl, ani Barboře."
  },
  {
   "start": 229.31,
   "end": 230.85,
   "text": "Děkuji, že jste mi to řekl."
  },
  {
   "start": 231.01,
   "end": 232.03,
   "text": "To je důležité."
  },
  {
   "start": 233.33,
   "end": 234.47,
   "text": "Myslíš, že jsem nebezpečný?"
  },
  {
   "start": 235.51,
   "end": 241.39,
   "text": "Takové vtíravé myšlenky, jako u lidí s tímto typem potíží, jsou velmi časté."
  },
  {
   "start": 241.79,
   "end": 243.65,
   "text": "Hlavně, když se blíží velká změna."
  },
  {
   "start": 244.29,
   "end": 246.29,
   "text": "Nejsou důkazem, že byste něco udělal."
  },
  {
   "start": 246.73,
   "end": 249.51,
   "text": "Jejich síla je právě v tom, jak vás děsí."
  },
  {
   "start": 250.69,
   "end": 251.37,
   "text": "To je pomalu."
  },
  {
   "start": 252.05,
   "end": 254.93,
   "text": "Přesto chce čas, než tomu věřím."
  },
  {
   "start": 255.67,
   "end": 256.25,
   "text": "Rozumím."
  },
  {
   "start": 256.87,
   "end": 259.73,
   "text": "Co děláte, když se ta myšlenka objeví?"
  },
  {
   "start": 260.47,
   "end": 261.31,
   "text": "Odejdu z místnosti."
  },
  {
   "start": 262.25,
   "end": 264.73,
   "text": "Nebo se vrátím a zkontroluji něco, aby to přestalo."
  },
  {
   "start": 265.33,
   "end": 269.79,
   "text": "Takže kontrola vám pomáhá uklidnit i tuhle?"
  },
  {
   "start": 270.51,
   "end": 273.37,
   "text": "Vlastně ano. Nikdy mě nenapadlo, že to spolu souvisí."
  },
  {
   "start": 273.93,
   "end": 274.99,
   "text": "Jak spíte?"
  },
  {
   "start": 275.71,
   "end": 281.43,
   "text": "Spím mezerně. Stávám noce dvakrát a kontroluji sporát, i když tam nic nestojí."
  },
  {
   "start": 281.97,
   "end": 283.07,
   "text": "Pomáhá vám něco?"
  },
  {
   "start": 284.01,
   "end": 288.27,
   "text": "Pomáháme na procházky s Barborou, když je právě něco doma. Po mě zaměstná."
  },
  {
   "start": 288.67,
   "end": 290.35,
   "text": "Jak často to děláte?"
  },
  {
   "start": 290.91,
   "end": 294.65,
   "text": "Procházky dvakrát, díně, oprave, kde všechno."
  },
  {
   "start": 295.85,
   "end": 299.13,
   "text": "Co by pro vás znamenalo, kdyby se to zlepšilo?"
  },
  {
   "start": 299.81,
   "end": 304.07,
   "text": "Odejít večer za pět minut a těšit se na dítě bez těch myšlenek."
  },
  {
   "start": 305.07,
   "end": 309.83,
   "text": "To jsou jasné cíle. Víte, že existuje léčba, která tomu pomáhá?"
  },
  {
   "start": 310.65,
   "end": 316.61,
   "text": "Zdržel jsem terapii, kdy se člověk postupně vystavuje tomu, čemu se bojí. Měl jsem z toho strach."
  },
  {
   "start": 317.05,
   "end": 318.69,
   "text": "Strach je pochopitelný."
  },
  {
   "start": 319.35,
   "end": 323.05,
   "text": "Šlo by si po malých krocích a vy byste o tempu rozhodoval."
  },
  {
   "start": 323.67,
   "end": 326.45,
   "text": "To je uklidňující."
  },
  {
   "start": 327.35,
   "end": 331.09,
   "text": "Myslel jsem, že mě někdo donutí nechat otevřené dveře odejít."
  },
  {
   "start": 331.71,
   "end": 332.49,
   "text": "Tak to ne."
  },
  {
   "start": 333.17,
   "end": 337.83,
   "text": "Začali bychom třeba jen tím, že zkontrolujete dveře jenom jednou, ne třikrát."
  },
  {
   "start": 337.83,
   "end": 341.17,
   "text": "To zní malé, ale to je pro mě velké."
  },
  {
   "start": 341.81,
   "end": 344.25,
   "text": "Velké kroky začínají malými."
  },
  {
   "start": 344.97,
   "end": 347.03,
   "text": "Řekl jste něco důležitého o Barboře."
  },
  {
   "start": 347.61,
   "end": 348.91,
   "text": "Chtěl byste jí..."
  },
  {
   "start": 348.91,
   "end": 350.87,
   "text": "Co byste jí chtěl říct?"
  },
  {
   "start": 351.17,
   "end": 351.65,
   "text": "Že jí milu."
  },
  {
   "start": 352.41,
   "end": 353.67,
   "text": "A že se potřebuje dát,"
  },
  {
   "start": 353.83,
   "end": 354.97,
   "text": "abych jí nestratil."
  },
  {
   "start": 355.77,
   "end": 356.87,
   "text": "Zatím se bojím,"
  },
  {
   "start": 357.09,
   "end": 358.95,
   "text": "že by se mnou nechtěla být."
  },
  {
   "start": 360.15,
   "end": 361.53,
   "text": "Co si myslíte,"
  },
  {
   "start": 361.65,
   "end": 362.59,
   "text": "že by řekla?"
  },
  {
   "start": 363.67,
   "end": 364.91,
   "text": "Se by mě objala."
  },
  {
   "start": 365.73,
   "end": 366.77,
   "text": "Ona je taková."
  },
  {
   "start": 367.55,
   "end": 369.73,
   "text": "Pak možná stojí za to jí říct"
  },
  {
   "start": 369.73,
   "end": 370.77,
   "text": "alespoň část."
  },
  {
   "start": 371.79,
   "end": 373.31,
   "text": "Co kdybyste jí řekl,"
  },
  {
   "start": 373.31,
   "end": 375.01,
   "text": "že jste tu byl"
  },
  {
   "start": 375.01,
   "end": 376.55,
   "text": "a co jste se dozvěděl."
  },
  {
   "start": 376.95,
   "end": 377.51,
   "text": "To by bylo hodně."
  },
  {
   "start": 378.37,
   "end": 379.81,
   "text": "O těch myšlenkách ještě ne."
  },
  {
   "start": 380.29,
   "end": 382.83,
   "text": "To je v pořádku. Tempo určujete vy."
  },
  {
   "start": 383.43,
   "end": 383.79,
   "text": "Děkuju."
  },
  {
   "start": 384.71,
   "end": 386.07,
   "text": "Tohle mi dalo víc, než jsem čekal."
  },
  {
   "start": 387.89,
   "end": 389.91,
   "text": "Dopříště zkuste jednu věc."
  },
  {
   "start": 390.63,
   "end": 392.29,
   "text": "Když odcházíte z bytu,"
  },
  {
   "start": 392.43,
   "end": 394.35,
   "text": "zkontrolujte dveře jenom jednou"
  },
  {
   "start": 394.35,
   "end": 395.69,
   "text": "a zavěřte si,"
  },
  {
   "start": 395.93,
   "end": 397.53,
   "text": "jak moc vám bylo úzko."
  },
  {
   "start": 398.37,
   "end": 399.05,
   "text": "Jednou."
  },
  {
   "start": 399.67,
   "end": 400.25,
   "text": "Zkusím to."
