 },
 "client": "jana-n",
 "lang": "cs",
 "lane": 1,
 "audio_s": 384.5,
 "seconds": 138.3,
 "rtf": 0.36,
 "wer": 0.1371,
 "cer": 0.0553,
 "segments": [
  {
   "start": 0.78,
   "end": 2.38,
   "text": "Dobrý den, paní Nováková, pojďte dál."
  },
  {
   "start": 2.9,
   "end": 4.78,
   "text": "S čím byste dnes chtěla začít?"
  },
  {
   "start": 5.6,
   "end": 6.84,
   "text": "Dobrý den, já ani nevím."
  },
  {
   "start": 7.08,
   "end": 8.5,
   "text": "Mám pocit, že mi někdo vytáhl"
  },
  {
   "start": 8.5,
   "end": 10.16,
   "text": "koberec pod nohou."
  },
  {
   "start": 10.5,
   "end": 10.94,
   "text": "Co se stalo?"
  },
  {
   "start": 11.68,
   "end": 14.24,
   "text": "Po patnácti letech manželství jsme se s manželem"
  },
  {
   "start": 14.24,
   "end": 16.66,
   "text": "Radkem rozhodli pro rozvod."
  },
  {
   "start": 16.8,
   "end": 18.44,
   "text": "A já to pořád nemohu pochopit."
  },
  {
   "start": 18.94,
   "end": 19.72,
   "text": "Řekněte mi víc."
  },
  {
   "start": 20.28,
   "end": 22.42,
   "text": "Ještě v letě jsme byli na dovolené v Horvatsku"
  },
  {
   "start": 22.42,
   "end": 23.98,
   "text": "a všechno vypadalo normálně."
  },
  {
   "start": 23.98,
   "end": 26.62,
   "text": "A v září mi řekl, že už to takhle dál nejde."
  },
  {
   "start": 27.62,
   "end": 28.42,
   "text": "A jak jste to přijal?"
  },
  {
   "start": 28.42,
   "end": 31.0,
   "text": "Síděla jsem v kuchni a nemohla jsem nic říct."
  },
  {
   "start": 31.12,
   "end": 32.5,
   "text": "Pak jsem šla uklidit nádobí,"
  },
  {
   "start": 32.6,
   "end": 33.64,
   "text": "jako by se nic nedělo."
  },
  {
   "start": 34.14,
   "end": 35.4,
   "text": "A co se dalo u mě třeba?"
  },
  {
   "start": 36.74,
   "end": 39.48,
   "text": "Prázdno, pak zlost, pak zase prázdno."
  },
  {
   "start": 39.82,
   "end": 41.4,
   "text": "Střída se to několikrát dyně."
  },
  {
   "start": 42.12,
   "end": 43.32,
   "text": "Vysvětlil vám, Radek, proč?"
  },
  {
   "start": 44.18,
   "end": 45.7,
   "text": "Říká, že jsme se vzdáryli,"
  },
  {
   "start": 45.86,
   "end": 47.18,
   "text": "že žijeme vedle sebe."
  },
  {
   "start": 47.4,
   "end": 48.48,
   "text": "Já si toho nevšimla,"
  },
  {
   "start": 48.48,
   "end": 50.56,
   "text": "nebo jsem si všimnout nechtěla?"
  },
  {
   "start": 51.64,
   "end": 52.98,
   "text": "Co si o tom myslíte teď?"
  },
  {
   "start": 54.08,
   "end": 55.96,
   "text": "Že jsem to měla vidět,"
  },
  {
   "start": 56.02,
   "end": 56.86,
   "text": "že jsem slepá."
  },
  {
   "start": 56.86,
   "end": 58.58,
   "text": "A pořád se v hlavě vracím"
  },
  {
   "start": 58.58,
   "end": 60.26,
   "text": "a hledám, kde jsem udělala chybu."
  },
  {
   "start": 60.78,
   "end": 61.34,
   "text": "A našla stej?"
  },
  {
   "start": 61.72,
   "end": 61.94,
   "text": "Ne."
  },
  {
   "start": 62.74,
   "end": 63.42,
   "text": "Jednou si myslím,"
  },
  {
   "start": 63.5,
   "end": 64.54,
   "text": "že jsem byla moc unavená,"
  },
  {
   "start": 64.64,
   "end": 65.94,
   "text": "nezajímala jsem se o něj."
  },
  {
   "start": 66.04,
   "end": 66.7,
   "text": "Jen když zase,"
  },
  {
   "start": 67.34,
   "end": 68.88,
   "text": "že jsem se starala moc."
  },
  {
   "start": 70.04,
   "end": 70.52,
   "text": "Vypadá to,"
  },
  {
   "start": 70.58,
   "end": 72.5,
   "text": "že se v tom hodině trápíte."
  },
  {
   "start": 72.92,
   "end": 74.82,
   "text": "Ano, hlavně kvůli dětem."
  },
  {
   "start": 75.24,
   "end": 76.02,
   "text": "Vy jdeme o nich."
  },
  {
   "start": 76.58,
   "end": 77.62,
   "text": "Mám dvě děti,"
  },
  {
   "start": 77.76,
   "end": 78.56,
   "text": "Aničce je 12"
  },
  {
   "start": 78.56,
   "end": 79.96,
   "text": "a Matějovi 8 let"
  },
  {
   "start": 79.96,
   "end": 81.56,
   "text": "a nevím, jak jim to říct."
  },
  {
   "start": 81.66,
   "end": 82.56,
   "text": "Ještě jste jim to neřekla?"
  },
  {
   "start": 82.72,
   "end": 82.9,
   "text": "Ne."
  },
  {
   "start": 82.9,
   "end": 83.92,
   "text": "Radek chce,"
  },
  {
   "start": 84.02,
   "end": 85.42,
   "text": "abychom to řekli společně,"
  },
  {
   "start": 85.58,
   "end": 86.92,
   "text": "ale pořád to odkládáme."
  },
  {
   "start": 87.6,
   "end": 89.0,
   "text": "Anička už něco tuší."
  },
  {
   "start": 89.22,
   "end": 89.86,
   "text": "Co vám to říká?"
  },
  {
   "start": 90.9,
   "end": 92.28,
   "text": "Minulý týden se mě zeptala,"
  },
  {
   "start": 92.42,
   "end": 93.9,
   "text": "jestli se s tátou hádáme."
  },
  {
   "start": 94.04,
   "end": 95.02,
   "text": "Řekla jsem, že ne."
  },
  {
   "start": 95.76,
   "end": 97.26,
   "text": "Cítila jsem se hrozně."
  },
  {
   "start": 100.4,
   "end": 101.42,
   "text": "Proč hrozně?"
  },
  {
   "start": 101.42,
   "end": 104.04,
   "text": "Protože jsem mu lhala"
  },
  {
   "start": 104.04,
   "end": 105.18,
   "text": "a ona to poznala."
  },
  {
   "start": 105.32,
   "end": 106.78,
   "text": "Viděla jsem jí to na očích."
  },
  {
   "start": 107.12,
   "end": 108.08,
   "text": "Co se vám mojilo hlavou?"
  },
  {
   "start": 108.62,
   "end": 109.66,
   "text": "Že ji ničím život,"
  },
  {
   "start": 109.76,
   "end": 110.76,
   "text": "že ji vezmou domov."
  },
  {
   "start": 111.88,
   "end": 113.8,
   "text": "Jak by se vám dařilo říct jí pravdu?"
  },
  {
   "start": 114.68,
   "end": 116.2,
   "text": "Nejraději bych to měla za sebou,"
  },
  {
   "start": 116.34,
   "end": 117.82,
   "text": "ale bojím se jejich slz."
  },
  {
   "start": 118.0,
   "end": 119.06,
   "text": "A Matě je ještě malý,"
  },
  {
   "start": 119.16,
   "end": 120.52,
   "text": "ten moc nic nechápe."
  },
  {
   "start": 120.98,
   "end": 122.02,
   "text": "Co byste mu chtěla předat?"
  },
  {
   "start": 122.7,
   "end": 124.14,
   "text": "Že ho máme oba rádi"
  },
  {
   "start": 124.14,
   "end": 125.44,
   "text": "a že se to nezmíní."
  },
  {
   "start": 125.44,
   "end": 126.56,
   "text": "Jenže já vím,"
  },
  {
   "start": 127.1,
   "end": 128.4,
   "text": "nevím, jestli je to pravda,"
  },
  {
   "start": 128.92,
   "end": 129.72,
   "text": "když sama nevím,"
  },
  {
   "start": 129.82,
   "end": 130.82,
   "text": "jak to bude vypadat."
  },
  {
   "start": 131.42,
   "end": 132.66,
   "text": "Jak to bude vypadat s bydlením?"
  },
  {
   "start": 133.24,
   "end": 134.7,
   "text": "Byd je na hypotéku."
  },
  {
   "start": 134.94,
   "end": 136.78,
   "text": "Radek se asi odstěho je k bratrovi,"
  },
  {
   "start": 136.86,
   "end": 137.66,
   "text": "alespoň zatím."
  },
  {
   "start": 138.14,
   "end": 139.34,
   "text": "Díky zůstanou se mnou."
  },
  {
   "start": 139.88,
   "end": 140.7,
   "text": "Jak se vám z toho děla?"
  },
  {
   "start": 140.92,
   "end": 141.6,
   "text": "Mám strach,"
  },
  {
   "start": 141.66,
   "end": 142.88,
   "text": "že to sama nezvládnu."
  },
  {
   "start": 143.32,
   "end": 144.92,
   "text": "Radek vždycky řešil peníze."
  },
  {
   "start": 145.42,
   "end": 146.48,
   "text": "Co dáláte ve všich dních dnech?"
  },
  {
   "start": 147.06,
   "end": 148.44,
   "text": "Pracuji jako učitelka češtiny"
  },
  {
   "start": 148.44,
   "end": 150.12,
   "text": "na základní škole v Brně."
  },
  {
   "start": 150.3,
   "end": 152.2,
   "text": "Učím devítky a osmičky."
  },
  {
   "start": 152.98,
   "end": 154.18,
   "text": "Jak se vám teď učí?"
  },
  {
   "start": 155.06,
   "end": 157.26,
   "text": "Do třídy chodím s knelíkem v krku."
  },
  {
   "start": 157.4,
   "end": 157.88,
   "text": "Mám pocit,"
  },
  {
   "start": 157.88,
   "end": 158.8,
   "text": "že všichni vidí,"
  },
  {
   "start": 159.0,
   "end": 160.42,
   "text": "že se mi rozpadá život."
  },
  {
   "start": 162.54,
   "end": 164.48,
   "text": "Ví o tom někdo ve školu?"
  },
  {
   "start": 165.18,
   "end": 166.12,
   "text": "Jen ředitelka."
  },
  {
   "start": 166.26,
   "end": 167.16,
   "text": "Řekla jsem jí to,"
  },
  {
   "start": 167.26,
   "end": 168.62,
   "text": "protože jsem se jednou"
  },
  {
   "start": 168.62,
   "end": 169.9,
   "text": "rozplakala na chodbě."
  },
  {
   "start": 170.02,
   "end": 170.78,
   "text": "Byla hodná."
  },
  {
   "start": 171.34,
   "end": 171.96,
   "text": "Co vám pomohlo?"
  },
  {
   "start": 173.64,
   "end": 175.36,
   "text": "Vše mě nechala odejít dřív."
  },
  {
   "start": 175.5,
   "end": 176.86,
   "text": "Dala mi hodinu volné."
  },
  {
   "start": 177.02,
   "end": 178.3,
   "text": "Jenže pak jsem seděla doma"
  },
  {
   "start": 178.3,
   "end": 179.38,
   "text": "a bylo to horší."
  },
  {
   "start": 179.9,
   "end": 180.38,
   "text": "Horší."
  },
  {
   "start": 181.06,
   "end": 181.34,
   "text": "Proč?"
  },
  {
   "start": 182.14,
   "end": 183.88,
   "text": "Protože jsem byla sama za hlavou."
  },
  {
   "start": 184.02,
   "end": 185.86,
   "text": "V práci jsem měla aspoň co dělat."
  },
  {
   "start": 185.86,
   "end": 187.92,
   "text": "Jak spíte?"
  },
  {
   "start": 188.88,
   "end": 189.36,
   "text": "Špatně."
  },
  {
   "start": 190.16,
   "end": 191.9,
   "text": "Každou noc se budím ve tři hodiny ráno"
  },
  {
   "start": 191.9,
   "end": 193.38,
   "text": "a přemýšlím, co bude dál."
  },
  {
   "start": 194.0,
   "end": 195.62,
   "text": "Co se říkáte, když se probudíte?"
  },
  {
   "start": 196.68,
   "end": 197.82,
   "text": "Že nemám hypotéku,"
  },
  {
   "start": 197.9,
   "end": 198.8,
   "text": "nemám manžela,"
  },
  {
   "start": 199.02,
   "end": 199.84,
   "text": "nemám nic."
  },
  {
   "start": 200.02,
   "end": 201.32,
   "text": "Pak spočítám peníze,"
  },
  {
   "start": 201.44,
   "end": 202.36,
   "text": "pak si představím,"
  },
  {
   "start": 202.52,
   "end": 203.64,
   "text": "jak to řeknu dětem."
  },
  {
   "start": 204.36,
   "end": 205.4,
   "text": "Točí se to dokola."
  },
  {
   "start": 205.8,
   "end": 206.14,
   "text": "A pak?"
  },
  {
   "start": 207.26,
   "end": 208.4,
   "text": "Kolem páté usnu"
  },
  {
   "start": 208.4,
   "end": 210.0,
   "text": "a v půl sedmé vztáhám."
  },
  {
   "start": 210.0,
   "end": 212.06,
   "text": "Jsem unamená už ráno."
  },
  {
   "start": 212.76,
   "end": 213.04,
   "text": "Jíte?"
  },
  {
   "start": 213.36,
   "end": 213.92,
   "text": "Hýbete se?"
  },
  {
   "start": 213.92,
   "end": 215.96,
   "text": "Jím málo."
  },
  {
   "start": 216.12,
   "end": 217.3,
   "text": "Zubla jsem čtyřikila."
  },
  {
   "start": 217.48,
   "end": 218.42,
   "text": "Kamarádka mi říká,"
  },
  {
   "start": 218.48,
   "end": 219.64,
   "text": "že vypadám hrozně."
  },
  {
   "start": 220.56,
   "end": 221.62,
   "text": "Máte kolem sebe někoho,"
  },
  {
   "start": 221.72,
   "end": 222.46,
   "text": "s kým můžete mluvit?"
  },
  {
   "start": 222.9,
   "end": 224.72,
   "text": "Mám sestru Alanu v Olmouci."
  },
  {
   "start": 225.34,
   "end": 227.22,
   "text": "Zavolá mi skoro každý večer"
  },
  {
   "start": 227.22,
   "end": 229.02,
   "text": "a kamarádku Evu z práce."
  },
  {
   "start": 229.26,
   "end": 229.88,
   "text": "Co jim říkáte?"
  },
  {
   "start": 230.7,
   "end": 231.96,
   "text": "Alance skoro všechno."
  },
  {
   "start": 232.12,
   "end": 232.78,
   "text": "Evě jen to,"
  },
  {
   "start": 232.88,
   "end": 234.1,
   "text": "že mám těžké období."
  },
  {
   "start": 234.62,
   "end": 236.22,
   "text": "Nechci, aby se o mě něco myslela."
  },
  {
   "start": 236.74,
   "end": 237.28,
   "text": "Co se obává,"
  },
  {
   "start": 237.28,
   "end": 237.92,
   "text": "co se myslí?"
  },
  {
   "start": 237.92,
   "end": 239.9,
   "text": "Že jsem se lhala,"
  },
  {
   "start": 240.12,
   "end": 242.34,
   "text": "že žena, která nedokážu udržet manželství,"
  },
  {
   "start": 242.4,
   "end": 243.92,
   "text": "není pro děti dobrý příklad."
  },
  {
   "start": 244.96,
   "end": 247.06,
   "text": "To je těžká myšlenka."
  },
  {
   "start": 247.92,
   "end": 248.5,
   "text": "Odkud se bere?"
  },
  {
   "start": 249.1,
   "end": 250.2,
   "text": "Asi od mojí mámy."
  },
  {
   "start": 250.4,
   "end": 251.18,
   "text": "Ta vždycky říkala,"
  },
  {
   "start": 251.3,
   "end": 252.78,
   "text": "že manželství se drží"
  },
  {
   "start": 252.78,
   "end": 253.9,
   "text": "a dě to jak chce."
  },
  {
   "start": 255.08,
   "end": 255.9,
   "text": "Co řekla,"
  },
  {
   "start": 256.1,
   "end": 257.06,
   "text": "když jste jí to oznámila?"
  },
  {
   "start": 257.48,
   "end": 258.04,
   "text": "Mlčela."
  },
  {
   "start": 258.98,
   "end": 259.52,
   "text": "Pak řekla,"
  },
  {
   "start": 259.52,
   "end": 260.26,
   "text": "že doufá,"
  },
  {
   "start": 260.52,
   "end": 262.16,
   "text": "že jí jsem to dobře zvážela."
  },
  {
   "start": 262.76,
   "end": 264.52,
   "text": "Už se od té doby moc neozvala."
  },
  {
   "start": 264.52,
   "end": 266.56,
   "text": "Jak vám to je?"
  },
  {
   "start": 267.16,
   "end": 267.68,
   "text": "Smutno."
  },
  {
   "start": 268.5,
   "end": 269.28,
   "text": "Potřebovala bych,"
  },
  {
   "start": 269.52,
   "end": 270.54,
   "text": "aby mě objala."
  },
  {
   "start": 271.48,
   "end": 272.48,
   "text": "Co byste jich chtěla říct?"
  },
  {
   "start": 272.98,
   "end": 274.04,
   "text": "Že to bolí,"
  },
  {
   "start": 274.16,
   "end": 275.06,
   "text": "že nechci být sama,"
  },
  {
   "start": 275.34,
   "end": 277.14,
   "text": "jenže u nás se to nedělá."
  },
  {
   "start": 278.24,
   "end": 278.66,
   "text": "Co se dělá,"
  },
  {
   "start": 278.72,
   "end": 279.76,
   "text": "když to říkáte na hlas?"
  },
  {
   "start": 280.7,
   "end": 282.78,
   "text": "Pláču a omlouvám se."
  },
  {
   "start": 284.16,
   "end": 285.32,
   "text": "Není za co."
  },
  {
   "start": 286.16,
   "end": 287.0,
   "text": "Vezměte se čas."
  },
  {
   "start": 288.74,
   "end": 289.3,
   "text": "Děkuji."
  },
  {
   "start": 289.54,
   "end": 291.5,
   "text": "Ještě jsem nikomu tohle neřekla."
  },
  {
   "start": 293.66,
   "end": 294.8,
   "text": "Co se vám mi dělá,"
  },
  {
   "start": 294.8,
   "end": 297.06,
   "text": "že jste to tady řekla?"
  },
  {
   "start": 299.56,
   "end": 300.68,
   "text": "Je zvláštní"
  },
  {
   "start": 300.68,
   "end": 302.02,
   "text": "sedět tady a říkat"
  },
  {
   "start": 302.02,
   "end": 303.32,
   "text": "to všechno na hlas,"
  },
  {
   "start": 303.44,
   "end": 304.7,
   "text": "ale trochu to pomáhá."
  },
  {
   "start": 306.2,
   "end": 307.68,
   "text": "Co by vám teď mohlo pomoct nejvíc?"
  },
  {
   "start": 309.14,
   "end": 309.7,
   "text": "Spát."
  },
  {
   "start": 310.04,
   "end": 310.66,
   "text": "A vy, děde,"
  },
  {
   "start": 310.76,
   "end": 311.66,
   "text": "jak to říct s dětem?"
  },
  {
   "start": 313.14,
   "end": 313.98,
   "text": "Pěkme na to postupně."
  },
  {
   "start": 314.86,
   "end": 316.48,
   "text": "Co spánek?"
  },
  {
   "start": 316.82,
   "end": 317.52,
   "text": "Zkoušela jste něco?"
  },
  {
   "start": 317.52,
   "end": 319.88,
   "text": "Hřvánkový čaj"
  },
  {
   "start": 319.88,
   "end": 320.9,
   "text": "a to je všechno."
  },
  {
   "start": 321.0,
   "end": 322.54,
   "text": "Doktorka mi nebídla prášky,"
  },
  {
   "start": 322.76,
   "end": 323.8,
   "text": "ale nechci."
  },
  {
   "start": 324.04,
   "end": 324.48,
   "text": "Proč nechcete?"
  },
  {
   "start": 325.22,
   "end": 325.66,
   "text": "Bojím si,"
  },
  {
   "start": 325.84,
   "end": 327.8,
   "text": "že bych se nemohla včas"
  },
  {
   "start": 327.8,
   "end": 328.92,
   "text": "zbudit pro děti"
  },
  {
   "start": 328.92,
   "end": 330.28,
   "text": "a nechci být závisla."
  },
  {
   "start": 331.08,
   "end": 331.52,
   "text": "To rozumím."
  },
  {
   "start": 332.9,
   "end": 333.8,
   "text": "Zkusíte tohle"
  },
  {
   "start": 333.8,
   "end": 334.62,
   "text": "můžu něco malého?"
  },
  {
   "start": 334.68,
   "end": 335.72,
   "text": "Třeba se vedle postele"
  },
  {
   "start": 335.72,
   "end": 337.06,
   "text": "nechat papíra napsat,"
  },
  {
   "start": 337.12,
   "end": 337.56,
   "text": "co vás budí?"
  },
  {
   "start": 338.52,
   "end": 339.32,
   "text": "Mohla bych."
  },
  {
   "start": 339.46,
   "end": 340.9,
   "text": "A hasbeň to dostanu z hlavy."
  },
  {
   "start": 341.52,
   "end": 343.1,
   "text": "A lidé tam."
  },
  {
   "start": 344.14,
   "end": 345.04,
   "text": "Kdy ho se nejvíc bojíte?"
  },
  {
   "start": 345.04,
   "end": 348.1,
   "text": "Že s panikařím rozpláču se."
  },
  {
   "start": 348.26,
   "end": 350.2,
   "text": "Že nezvládnou zůstat klidná."
  },
  {
   "start": 350.86,
   "end": 351.7,
   "text": "Tak kde by to nevadilo?"
  },
  {
   "start": 352.24,
   "end": 353.78,
   "text": "Že bych plakala před dětmi."
  },
  {
   "start": 354.64,
   "end": 356.78,
   "text": "Vždyť to by pro ně bylo děsivé."
  },
  {
   "start": 357.7,
   "end": 359.84,
   "text": "Nebo by mohly vidět,"
  },
  {
   "start": 360.02,
   "end": 362.2,
   "text": "že jsme také dovolený."
  },
  {
   "start": 363.4,
   "end": 364.76,
   "text": "To mě nenapadlo."
  },
  {
   "start": 365.18,
   "end": 366.98,
   "text": "A anička je citlivá."
  },
  {
   "start": 367.06,
   "end": 368.2,
   "text": "Možná by jí to pomohlo."
  },
  {
   "start": 369.38,
   "end": 371.28,
   "text": "Můžeme se příště podívat,"
  },
  {
   "start": 371.28,
   "end": 372.66,
   "text": "jak to připravit."
  },
  {
   "start": 372.66,
   "end": 374.66,
   "text": "Co dnesete z dneška?"
  },
  {
   "start": 375.58,
   "end": 376.52,
   "text": "Že nejsem sama"
  },
  {
   "start": 376.52,
   "end": 378.58,
   "text": "a že to nemusím zvládnout hned."
  },
  {
   "start": 378.92,
   "end": 379.44,
   "text": "Přesně to."
  },
  {
   "start": 380.46,
   "end": 381.56,
   "text": "Pro dnešek tady skončíme."
  },
  {
   "start": 382.14,
   "end": 382.62,
   "text": "Děkuji."
  },
  {
   "start": 382.74,
   "end": 384.12,
   "text": "Uvidíme se příští týden."
  }
 ],
 "round": "r2a"
}