{"idx": 0, "who": "therapist", "cut_start": 0.47, "cut_end": 5.05, "pieces": 1, "audio_s": 4.58, "seconds": 1.36, "raw": ["Dobrý den paní Novákova Petro. S čím byste dnes chtěla začít?"]}
{"idx": 1, "who": "client", "cut_start": 5.05, "cut_end": 10.14, "pieces": 1, "audio_s": 5.09, "seconds": 1.44, "raw": ["Dobrý den, já ani nevím. Mám pocit, že mi někdo vytáhl koberec pod nohou."]}
{"idx": 2, "who": "therapist", "cut_start": 10.14, "cut_end": 11.09, "pieces": 1, "audio_s": 0.95, "seconds": 0.61, "raw": ["To se stalo."]}
{"idx": 3, "who": "client", "cut_start": 11.09, "cut_end": 18.55, "pieces": 1, "audio_s": 7.46, "seconds": 1.9, "raw": ["Po patnácti letech manželství jsme se s manželem Radkem rozhodli pro rozvod a já to pořád nemohu pochopit."]}
{"idx": 4, "who": "therapist", "cut_start": 18.55, "cut_end": 19.88, "pieces": 1, "audio_s": 1.33, "seconds": 0.95, "raw": ["Řekněte mi víc."]}
{"idx": 5, "who": "client", "cut_start": 19.88, "cut_end": 26.77, "pieces": 1, "audio_s": 6.89, "seconds": 2.88, "raw": ["Ještě v letě jsme byly nadovolené v Chorvatsku a všechno vypadalo normálně a v září mi řekl, že už to takhle dál nejde."]}
{"idx": 6, "who": "therapist", "cut_start": 27.33, "cut_end": 28.16, "pieces": 1, "audio_s": 0.83, "seconds": 0.86, "raw": ["Některé dobře."]}
{"idx": 7, "who": "client", "cut_start": 28.16, "cut_end": 33.63, "pieces": 1, "audio_s": 5.47, "seconds": 1.76, "raw": ["Jel jsem v kuchyni a nemohla jsem nic říct. Pak jsem šla uklidit nádobí, jako by se nic nedělo."]}
{"idx": 8, "who": "therapist", "cut_start": 33.63, "cut_end": 35.83, "pieces": 1, "audio_s": 2.2, "seconds": 0.74, "raw": ["A tohle uvnitř vás."]}
{"idx": 9, "who": "client", "cut_start": 36.27, "cut_end": 41.61, "pieces": 1, "audio_s": 5.34, "seconds": 1.28, "raw": ["Prázdno, pak zlost, pak zase prázdnost, třídá se to několikrát denně."]}
{"idx": 10, "who": "therapist", "cut_start": 41.61, "cut_end": 43.57, "pieces": 1, "audio_s": 1.96, "seconds": 0.81, "raw": ["Vysvětlil vám Radek Proč."]}
{"idx": 11, "who": "client", "cut_start": 43.63, "cut_end": 50.71, "pieces": 1, "audio_s": 7.08, "seconds": 1.7, "raw": ["Říká, že jsme se vzdáleli, že žijeme vedle sebe. Já si toho nevšimla, nebo jsem si všimnout nechtěla."]}
{"idx": 12, "who": "therapist", "cut_start": 50.91, "cut_end": 53.19, "pieces": 1, "audio_s": 2.28, "seconds": 0.7, "raw": ["Co se o to myslíte teď?"]}
{"idx": 13, "who": "client", "cut_start": 53.45, "cut_end": 60.24, "pieces": 1, "audio_s": 6.79, "seconds": 1.75, "raw": ["Že jsem to měla vidět, že jsem slepá. Pořád se v hlavě vracím a hledám, kde jsem udělala chybu."]}
{"idx": 14, "who": "therapist", "cut_start": 60.24, "cut_end": 61.18, "pieces": 1, "audio_s": 0.94, "seconds": 0.66, "raw": ["A našla jsi."]}
{"idx": 15, "who": "client", "cut_start": 61.18, "cut_end": 68.99, "pieces": 1, "audio_s": 7.81, "seconds": 1.89, "raw": ["Ne, jednou si myslím, že jsem byla moc unavená, nezajímala jsem se o něj, jindy zase, že jsem se starala moc."]}
{"idx": 16, "who": "therapist", "cut_start": 69.41, "cut_end": 72.53, "pieces": 1, "audio_s": 3.12, "seconds": 1.3, "raw": ["Vypadá to, že se v tom rodině trápíte."]}
{"idx": 17, "who": "client", "cut_start": 72.53, "cut_end": 74.93, "pieces": 1, "audio_s": 2.4, "seconds": 1.25, "raw": ["Ano, hlavně kvůli dětem."]}
{"idx": 18, "who": "therapist", "cut_start": 75.25, "cut_end": 76.14, "pieces": 1, "audio_s": 0.89, "seconds": 0.89, "raw": ["Vědíme o nich."]}
{"idx": 19, "who": "client", "cut_start": 76.14, "cut_end": 81.45, "pieces": 1, "audio_s": 5.31, "seconds": 1.52, "raw": ["Mám dvě děti, Aničce 12 a Matějevi 8 let a nevím, jak jim to říct."]}
{"idx": 20, "who": "therapist", "cut_start": 81.45, "cut_end": 82.48, "pieces": 1, "audio_s": 1.03, "seconds": 0.91, "raw": ["Ještě jste jim tady řekli."]}
{"idx": 21, "who": "client", "cut_start": 82.48, "cut_end": 88.99, "pieces": 1, "audio_s": 6.51, "seconds": 1.64, "raw": ["Ne, Radek chce, abychom to řekli společně, ale bořá to odkládáme. Anička už něco tuší."]}
{"idx": 22, "who": "therapist", "cut_start": 88.99, "cut_end": 90.13, "pieces": 1, "audio_s": 1.14, "seconds": 0.89, "raw": ["Titulky vytvořil JohnyX."]}
{"idx": 23, "who": "client", "cut_start": 90.41, "cut_end": 97.51, "pieces": 1, "audio_s": 7.1, "seconds": 1.55, "raw": ["Minulý týden se mě zeptala, jestli se s tátou hádáme. Řekla jsem, že ne. Cítila jsem se hrozně."]}
{"idx": 24, "who": "therapist", "cut_start": 100.03, "cut_end": 101.69, "pieces": 1, "audio_s": 1.66, "seconds": 0.75, "raw": ["Proč hrozně?"]}
{"idx": 25, "who": "client", "cut_start": 102.21, "cut_end": 106.75, "pieces": 1, "audio_s": 4.54, "seconds": 1.22, "raw": ["Protože jsem lhala a ona to poznala, viděla jsem ji to na očích."]}
{"idx": 26, "who": "therapist", "cut_start": 106.75, "cut_end": 108.15, "pieces": 1, "audio_s": 1.4, "seconds": 0.81, "raw": ["Co se vám mohlo hlavovat?"]}
{"idx": 27, "who": "client", "cut_start": 108.15, "cut_end": 111.01, "pieces": 1, "audio_s": 2.86, "seconds": 1.05, "raw": ["Že ji ničím život, že ji vezmu doma."]}
{"idx": 28, "who": "therapist", "cut_start": 111.13, "cut_end": 114.05, "pieces": 1, "audio_s": 2.92, "seconds": 1.32, "raw": ["Jak by se vám dořelo říct jí pravdu?"]}
{"idx": 29, "who": "client", "cut_start": 114.25, "cut_end": 120.5, "pieces": 1, "audio_s": 6.25, "seconds": 2.56, "raw": ["Nejraději bych to měla za sebou, ale bojím se jejich slz a Matěj je ještě malý, ten moc nic nechápe."]}
{"idx": 30, "who": "therapist", "cut_start": 120.5, "cut_end": 122.13, "pieces": 1, "audio_s": 1.63, "seconds": 1.13, "raw": ["Co byste mohla přidat?"]}
{"idx": 31, "who": "client", "cut_start": 122.13, "cut_end": 130.92, "pieces": 1, "audio_s": 8.79, "seconds": 2.07, "raw": ["Že ho máme oba rádi a že se to nezmíní, jenže já nevím, jestli je to pravda, když sama nevím, jak to bude vypadat."]}
{"idx": 32, "who": "therapist", "cut_start": 130.92, "cut_end": 132.85, "pieces": 1, "audio_s": 1.93, "seconds": 1.09, "raw": ["Někdo bude vyprávat s bydlením."]}
{"idx": 33, "who": "client", "cut_start": 132.85, "cut_end": 139.45, "pieces": 1, "audio_s": 6.6, "seconds": 1.69, "raw": ["Byt je na hypotéku, Radek se asi odstihuje k bratrově, alespoň zatím, díky, že zůstanou se mnou."]}
{"idx": 34, "who": "therapist", "cut_start": 139.45, "cut_end": 140.78, "pieces": 1, "audio_s": 1.33, "seconds": 0.82, "raw": ["Nech se vám stavělo."]}
{"idx": 35, "who": "client", "cut_start": 140.78, "cut_end": 145.01, "pieces": 1, "audio_s": 4.23, "seconds": 1.65, "raw": ["Mám strach, že to sama nezvládnu. Rade, když vždycky řešil peníze."]}
{"idx": 36, "who": "therapist", "cut_start": 145.01, "cut_end": 146.61, "pieces": 1, "audio_s": 1.6, "seconds": 1.03, "raw": ["Četláte ve všechny jiných."]}
{"idx": 37, "who": "client", "cut_start": 146.61, "cut_end": 152.31, "pieces": 1, "audio_s": 5.7, "seconds": 1.66, "raw": ["Pracuji jako učitelka češtiny na základní škole v Brně. Učím devítky a osmičky."]}
{"idx": 38, "who": "therapist", "cut_start": 152.31, "cut_end": 154.41, "pieces": 1, "audio_s": 2.1, "seconds": 1.12, "raw": ["Titulky vytvořil JohnyX."]}
{"idx": 39, "who": "client", "cut_start": 154.69, "cut_end": 160.51, "pieces": 1, "audio_s": 5.82, "seconds": 2.01, "raw": ["Do třídy chodím s knadlíkem v krku. Mám pocit, že všichni vidí, že se mi rozpadá život."]}
{"idx": 40, "who": "therapist", "cut_start": 162.33, "cut_end": 164.54, "pieces": 1, "audio_s": 2.21, "seconds": 1.11, "raw": ["Ví o tom někdo ve škole."]}
{"idx": 41, "who": "client", "cut_start": 164.54, "cut_end": 170.77, "pieces": 1, "audio_s": 6.23, "seconds": 1.61, "raw": ["Jen ředitelka. Řekla jsem jí to, protože jsem se jednou rozplakala na chodbě. Byla hodná."]}
{"idx": 42, "who": "therapist", "cut_start": 170.77, "cut_end": 172.21, "pieces": 1, "audio_s": 1.44, "seconds": 0.66, "raw": ["Co vám pomalu?"]}
{"idx": 43, "who": "client", "cut_start": 172.93, "cut_end": 179.48, "pieces": 1, "audio_s": 6.55, "seconds": 1.44, "raw": ["Vše mě nechala odejít dřív, dala mi hodinu volné, jenže pak jsem seděla doma a bylo to horší."]}
{"idx": 44, "who": "therapist", "cut_start": 179.48, "cut_end": 181.61, "pieces": 1, "audio_s": 2.13, "seconds": 0.73, "raw": ["Horší. Proč?"]}
{"idx": 45, "who": "client", "cut_start": 181.69, "cut_end": 185.95, "pieces": 1, "audio_s": 4.26, "seconds": 1.34, "raw": ["Protože jsem byla samozahlavou, v práci jsem měla aspoň co dělat."]}
{"idx": 46, "who": "therapist", "cut_start": 186.33, "cut_end": 188.07, "pieces": 1, "audio_s": 1.74, "seconds": 0.67, "raw": ["Jak zpítá?"]}
{"idx": 47, "who": "client", "cut_start": 188.39, "cut_end": 193.35, "pieces": 1, "audio_s": 4.96, "seconds": 1.28, "raw": ["Špatně. Každou noc se budím ve tři hodiny ráno a přemýšlím, co bude dál."]}
{"idx": 48, "who": "therapist", "cut_start": 193.35, "cut_end": 195.85, "pieces": 1, "audio_s": 2.5, "seconds": 1.12, "raw": ["A co se říkáte, když se probudíte?"]}
{"idx": 49, "who": "client", "cut_start": 195.87, "cut_end": 205.17, "pieces": 1, "audio_s": 9.3, "seconds": 2.28, "raw": ["Že nemám hypotéku, nemám manžela, nemám nic, pak spočítám peníze, pak si představím, jak to řeknu dětem."]}
{"idx": 50, "who": "therapist", "cut_start": 205.17, "cut_end": 206.37, "pieces": 1, "audio_s": 1.2, "seconds": 0.72, "raw": ["A pak?"]}
{"idx": 51, "who": "client", "cut_start": 206.57, "cut_end": 212.08, "pieces": 1, "audio_s": 5.51, "seconds": 1.86, "raw": ["Kolem páté usnu a v půl sedme vstávám. Jsem unavená už ráno."]}
{"idx": 52, "who": "therapist", "cut_start": 212.08, "cut_end": 214.21, "pieces": 1, "audio_s": 2.13, "seconds": 1.03, "raw": ["I ta, i bata se."]}
{"idx": 53, "who": "client", "cut_start": 214.33, "cut_end": 219.86, "pieces": 1, "audio_s": 5.53, "seconds": 1.73, "raw": ["I málo, zhubla jsem čtyři kyla. Kamarádka mi říká, že vypadám hrozně."]}
{"idx": 54, "who": "therapist", "cut_start": 219.86, "cut_end": 222.26, "pieces": 1, "audio_s": 2.4, "seconds": 1.13, "raw": ["Máte kolem sebe někoho, s kým mluvíte?"]}
{"idx": 55, "who": "client", "cut_start": 222.26, "cut_end": 229.04, "pieces": 1, "audio_s": 6.78, "seconds": 1.42, "raw": ["Mám sestru Alanu v Olomouci, volá mi skoro každý večer a kamarádku Evu z práce."]}
{"idx": 56, "who": "therapist", "cut_start": 229.04, "cut_end": 230.17, "pieces": 1, "audio_s": 1.13, "seconds": 0.72, "raw": ["Co jim říkáte?"]}
{"idx": 57, "who": "client", "cut_start": 230.61, "cut_end": 236.35, "pieces": 1, "audio_s": 5.74, "seconds": 1.49, "raw": ["Ale chce skoro všechno. Evě jen to, že mám těžké období. Nechce, aby se o mě něco myslela."]}
{"idx": 58, "who": "therapist", "cut_start": 236.35, "cut_end": 238.15, "pieces": 1, "audio_s": 1.8, "seconds": 0.9, "raw": ["To se obává, co si myslí."]}
{"idx": 59, "who": "client", "cut_start": 238.15, "cut_end": 244.21, "pieces": 1, "audio_s": 6.06, "seconds": 1.67, "raw": ["Že jsem se lhala, že žena, která nedokáže udržet manželství, není pro děti dobrý příklad."]}
{"idx": 60, "who": "therapist", "cut_start": 244.33, "cut_end": 248.56, "pieces": 1, "audio_s": 4.23, "seconds": 1.0, "raw": ["To je těžká myšlenka. Odkud se bere?"]}
{"idx": 61, "who": "client", "cut_start": 248.56, "cut_end": 254.07, "pieces": 1, "audio_s": 5.51, "seconds": 1.74, "raw": ["Asi od mojí mámy, tak vždycky říkal, že manželství se drží a děto jak chce."]}
{"idx": 62, "who": "therapist", "cut_start": 254.43, "cut_end": 257.33, "pieces": 1, "audio_s": 2.9, "seconds": 1.27, "raw": ["Co řekla, když se jí to oznámila?"]}
{"idx": 63, "who": "client", "cut_start": 258.21, "cut_end": 264.71, "pieces": 1, "audio_s": 6.5, "seconds": 2.23, "raw": ["Pak řekla, že doufá, že jsem to dobře zvážela. Už se od té doby moc neozvala."]}
{"idx": 64, "who": "therapist", "cut_start": 265.17, "cut_end": 266.71, "pieces": 1, "audio_s": 1.54, "seconds": 0.74, "raw": ["Jak mám třeba?"]}
{"idx": 65, "who": "client", "cut_start": 266.71, "cut_end": 270.25, "pieces": 1, "audio_s": 3.54, "seconds": 1.03, "raw": ["Smutná. Potřebovala bych, aby mě..."]}
{"idx": 66, "who": "therapist", "cut_start": 270.67, "cut_end": 272.51, "pieces": 1, "audio_s": 1.84, "seconds": 0.79, "raw": ["To byste jistě hodně jistě."]}
{"idx": 67, "who": "client", "cut_start": 272.51, "cut_end": 277.35, "pieces": 1, "audio_s": 4.84, "seconds": 1.03, "raw": ["Že to bolí, že nechci být sama, jenže u nás se to nedělá."]}
{"idx": 68, "who": "therapist", "cut_start": 277.45, "cut_end": 279.65, "pieces": 1, "audio_s": 2.2, "seconds": 1.02, "raw": ["Co se děje, když to říkáte na hlas?"]}
{"idx": 69, "who": "client", "cut_start": 279.77, "cut_end": 282.91, "pieces": 1, "audio_s": 3.14, "seconds": 0.75, "raw": ["Pláču, omlouvám se."]}
{"idx": 70, "who": "therapist", "cut_start": 283.65, "cut_end": 287.23, "pieces": 1, "audio_s": 3.58, "seconds": 0.89, "raw": ["Není za co. Vezměte se čas."]}
{"idx": 71, "who": "client", "cut_start": 287.99, "cut_end": 291.67, "pieces": 1, "audio_s": 3.68, "seconds": 1.06, "raw": ["Děkuji. Ještě jsem nikomu tohle neřekla."]}
{"idx": 72, "who": "therapist", "cut_start": 292.61, "cut_end": 297.29, "pieces": 1, "audio_s": 4.68, "seconds": 1.0, "raw": ["Co to s vámi dělá, že jste to tady řekla?"]}
{"idx": 73, "who": "client", "cut_start": 298.67, "cut_end": 304.89, "pieces": 1, "audio_s": 6.22, "seconds": 1.34, "raw": ["Je zvláštní sedět tady a říkat to všechno nahlas, ale trochu to pomáhá."]}
{"idx": 74, "who": "therapist", "cut_start": 305.51, "cut_end": 307.91, "pieces": 1, "audio_s": 2.4, "seconds": 1.31, "raw": ["To by vám teď mohlo pomoct nejvíc."]}
{"idx": 75, "who": "client", "cut_start": 308.51, "cut_end": 311.75, "pieces": 1, "audio_s": 3.24, "seconds": 1.42, "raw": ["Spát a vědět, jak to říct s dětem."]}
{"idx": 76, "who": "therapist", "cut_start": 312.91, "cut_end": 317.81, "pieces": 1, "audio_s": 4.9, "seconds": 1.93, "raw": ["Pěkně na to postupně. Co spánek? Zkoušel jste něco?"]}
{"idx": 77, "who": "client", "cut_start": 319.03, "cut_end": 323.84, "pieces": 1, "audio_s": 4.81, "seconds": 1.25, "raw": ["Prankový čaj a to je všechno. Doktorka mi nebídla prášky, ale nechci."]}
{"idx": 78, "who": "therapist", "cut_start": 323.84, "cut_end": 324.55, "pieces": 1, "audio_s": 0.71, "seconds": 0.92, "raw": ["Titulky vytvořil JohnyX."]}
{"idx": 79, "who": "client", "cut_start": 324.55, "cut_end": 330.47, "pieces": 1, "audio_s": 5.92, "seconds": 1.54, "raw": ["Bojím se, že bych se nemohla včas vzbudit pro děti a nechci být závislá."]}
{"idx": 80, "who": "therapist", "cut_start": 330.47, "cut_end": 337.83, "pieces": 1, "audio_s": 7.36, "seconds": 1.81, "raw": ["To je rozumné. Zkusíte tohle moc něco malého, třeba sedle postele nechat papíra napsat, co vás budí?"]}
{"idx": 81, "who": "client", "cut_start": 337.83, "cut_end": 341.11, "pieces": 1, "audio_s": 3.28, "seconds": 1.03, "raw": ["Mohla bych, alespoň to dostanu z hlavy."]}
{"idx": 82, "who": "therapist", "cut_start": 341.39, "cut_end": 345.07, "pieces": 1, "audio_s": 3.68, "seconds": 0.95, "raw": ["A lidé tam, co se nabízbujete."]}
{"idx": 83, "who": "client", "cut_start": 345.07, "cut_end": 350.35, "pieces": 1, "audio_s": 5.28, "seconds": 1.09, "raw": ["Že s panikařím rozpláču se, že nezvládnu zůstat klidná."]}
{"idx": 84, "who": "therapist", "cut_start": 350.81, "cut_end": 351.77, "pieces": 1, "audio_s": 0.96, "seconds": 0.96, "raw": ["Titulky vytvořil JohnyX."]}
{"idx": 85, "who": "client", "cut_start": 351.77, "cut_end": 356.95, "pieces": 1, "audio_s": 5.18, "seconds": 1.44, "raw": ["Že bych polakala před dětmi? Vždyť to by pro ně bylo těsivé."]}
{"idx": 86, "who": "therapist", "cut_start": 357.41, "cut_end": 362.43, "pieces": 1, "audio_s": 5.02, "seconds": 1.5, "raw": ["Nebo by mohli vidět, že jsme také dovolení."]}
{"idx": 87, "who": "client", "cut_start": 362.71, "cut_end": 368.45, "pieces": 1, "audio_s": 5.74, "seconds": 1.75, "raw": ["To mně nenapadlo. Ančka je ciplivá, možná by jí to pomohlo."]}
{"idx": 88, "who": "therapist", "cut_start": 368.97, "cut_end": 374.83, "pieces": 1, "audio_s": 5.86, "seconds": 1.82, "raw": ["Můžeme se příště podívat, jak to připravit. Co nesete z dneška?"]}
{"idx": 89, "who": "client", "cut_start": 375.05, "cut_end": 378.49, "pieces": 1, "audio_s": 3.44, "seconds": 1.08, "raw": ["Že nejsem sama a že to nemusím zvládnout hned."]}
{"idx": 90, "who": "therapist", "cut_start": 378.49, "cut_end": 381.65, "pieces": 1, "audio_s": 3.16, "seconds": 0.99, "raw": ["Přesně to. Pro dnešek tady skončíme."]}
{"idx": 91, "who": "client", "cut_start": 381.65, "cut_end": 384.23, "pieces": 1, "audio_s": 2.58, "seconds": 1.11, "raw": ["Děkuji. Uvidíme se příští týden."]}
