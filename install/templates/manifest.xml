<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- OTA manifest template: sign-ota fills the @…@ placeholders (software-package URL = the per-tag
     release asset, bundle id/version/title from the profile and the app's Info.plist) and ships the
     result to GitHub Pages as manifests/pr-<N>.xml. The Pages manifest is the live one; a copy goes
     to the release as a backup only (release-asset content types are not trusted for installs). -->
<plist version="1.0">
  <dict>
    <key>items</key>
    <array>
      <dict>
        <key>assets</key>
        <array>
          <dict>
            <key>kind</key>
            <string>software-package</string>
            <key>url</key>
            <string>@IPA_URL@</string>
          </dict>
        </array>
        <key>metadata</key>
        <dict>
          <key>bundle-identifier</key>
          <string>@BUNDLE_ID@</string>
          <key>bundle-version</key>
          <string>@BUNDLE_VERSION@</string>
          <key>kind</key>
          <string>software</string>
          <key>title</key>
          <string>@TITLE@</string>
        </dict>
      </dict>
    </array>
  </dict>
</plist>
